+/* All caller-clobbered registers have already been spilled by call allocation.
+ * X0 holds ENV and must remain unchanged on every miss. The original call's
+ * global-state synchronization, clobber set and ordering bridges stay intact.
+ * Only a successful, RCU-protected cache lookup avoids the C helper. */
+static tcg_insn_unit *boxdroid_lookup_cb(TCGContext *s, TCGType type,
+                                      TCGReg reg, bool nonzero)
+{
+    tcg_insn_unit *branch = s->code_ptr;
+    if (nonzero) {
+        tcg_out_insn(s, 3201, CBNZ, type, reg, 0);
+    } else {
+        tcg_out_insn(s, 3201, CBZ, type, reg, 0);
+    }
+    return branch;
+}
+
+static tcg_insn_unit *boxdroid_lookup_ne(TCGContext *s, TCGType type,
+                                      TCGReg a, TCGReg b)
+{
+    tgen_cmp(s, type, TCG_COND_NE, a, b);
+    tcg_insn_unit *branch = s->code_ptr;
+    tcg_out_insn(s, 3202, B_C, TCG_COND_NE, 0);
+    return branch;
+}
