+static void boxdroid_out_lookup_tb_ptr(TCGContext *s,
+                                      const tcg_insn_unit *target, bool shared)
+{
+    tcg_insn_unit *miss[12], *slot_miss[5], *done[2];
+    unsigned nmiss = 0, ndone = 0;
+    const TCGReg env = TCG_REG_X0, cpu = TCG_REG_X1;
+    const TCGReg tb = TCG_REG_X2, entry = TCG_REG_X3;
+    const TCGReg pc = TCG_REG_X4, flags = TCG_REG_X5;
+    const TCGReg cflags = TCG_REG_X6, tmp = TCG_REG_X7;
+    const TCGReg work = TCG_REG_X8;
+    const int cpu_offset = -(int)sizeof(CPUState);
+
+    tcg_out_movi(s, TCG_TYPE_PTR, tmp, cpu_offset);
+    tcg_out_insn(s, 3502, ADD, TCG_TYPE_PTR, cpu, env, tmp);
+    tcg_out_movi(s, TCG_TYPE_I32, tmp, 1);
+    tcg_out_ldst(s, I3312_STRB, tmp, cpu,
+                offsetof(CPUState, neg.can_do_io), 0);
+
+    tcg_out_ld(s, TCG_TYPE_I32, tmp, cpu,
+               offsetof(CPUState, singlestep_enabled));
+    miss[nmiss++] = boxdroid_lookup_cb(s, TCG_TYPE_I32, tmp, true);
+    tcg_out_ld(s, TCG_TYPE_PTR, tmp, cpu, offsetof(CPUState, breakpoints));
+    miss[nmiss++] = boxdroid_lookup_cb(s, TCG_TYPE_PTR, tmp, true);
+    tcg_out_movi(s, TCG_TYPE_PTR, tmp, (intptr_t)&one_insn_per_tb);
+    tcg_out_ldst(s, I3312_LDRB, tmp, tmp, 0, 0);
+    miss[nmiss++] = boxdroid_lookup_cb(s, TCG_TYPE_I32, tmp, true);
+    tcg_out_movi(s, TCG_TYPE_PTR, tmp, (intptr_t)&qemu_loglevel);
+    tcg_out_ld(s, TCG_TYPE_I32, tmp, tmp, 0);
+    tcg_out_movi(s, TCG_TYPE_I32, work,
+                 CPU_LOG_TB_CPU | CPU_LOG_EXEC | CPU_LOG_TB_NOCHAIN);
+    tcg_out_insn(s, 3510, AND, TCG_TYPE_I32, tmp, tmp, work);
+    miss[nmiss++] = boxdroid_lookup_cb(s, TCG_TYPE_I32, tmp, true);
+    tcg_out_movi(s, TCG_TYPE_PTR, tmp, (intptr_t)&boxdroid_order_audit_active);
+    tcg_out_ldst(s, I3312_LDRB, tmp, tmp, 0, 0);
+    miss[nmiss++] = boxdroid_lookup_cb(s, TCG_TYPE_I32, tmp, true);
+
+    tcg_out_ld(s, TCG_TYPE_I32, flags, env, s->boxdroid_lookup_layout.hflags);
+    tcg_out_movi(s, TCG_TYPE_I32, tmp, s->boxdroid_lookup_layout.eligible_mask);
+    tcg_out_insn(s, 3510, AND, TCG_TYPE_I32, tmp, flags, tmp);
+    tcg_out_movi(s, TCG_TYPE_I32, work, s->boxdroid_lookup_layout.eligible_value);
+    miss[nmiss++] = boxdroid_lookup_ne(s, TCG_TYPE_I32, tmp, work);
+    tcg_out_ld(s, TCG_TYPE_I32, tmp, env, s->boxdroid_lookup_layout.cs_base);
+    miss[nmiss++] = boxdroid_lookup_cb(s, TCG_TYPE_I32, tmp, true);
+    tcg_out_ld(s, TCG_TYPE_I32, tmp, env, s->boxdroid_lookup_layout.eflags);
+    tcg_out_movi(s, TCG_TYPE_I32, work, s->boxdroid_lookup_layout.eflags_mask);
+    tcg_out_insn(s, 3510, AND, TCG_TYPE_I32, tmp, tmp, work);
+    tcg_out_insn(s, 3510, ORR, TCG_TYPE_I32, flags, flags, tmp);
+    tcg_out_ld(s, TCG_TYPE_I32, pc, env, s->boxdroid_lookup_layout.eip);
+    tcg_out_ld(s, TCG_TYPE_I32, cflags, cpu, offsetof(CPUState, tcg_cflags));
+
+    /* Identical system-mode tb_jmp_cache_hash_func, for x86's 4KiB pages.
+     * Mask/cache geometry is unchanged from the supported BoxDroid baseline. */
+    QEMU_BUILD_BUG_ON(TB_JMP_CACHE_BITS != 14);
+    QEMU_BUILD_BUG_ON(sizeof(((CPUJumpCache *)0)->array[0]) != 16);
+    QEMU_BUILD_BUG_ON(offsetof(CPUJumpCache, array[0].pc) -
+                      offsetof(CPUJumpCache, array[0].tb) != 8);
+    tcg_out_ubfm(s, TCG_TYPE_I32, tmp, pc, 5, 31);
+    tcg_out_insn(s, 3510, EOR, TCG_TYPE_I32, tmp, tmp, pc);
+    tcg_out_ubfm(s, TCG_TYPE_I32, work, tmp, 5, 31);
+    tcg_out_logicali(s, I3404_ANDI, TCG_TYPE_I32, work, work, 0x3f80);
+    tcg_out_logicali(s, I3404_ANDI, TCG_TYPE_I32, tmp, tmp, 0x7f);
+    tcg_out_insn(s, 3510, ORR, TCG_TYPE_I32, tmp, tmp, work);
+    tcg_out_ld(s, TCG_TYPE_PTR, entry, cpu, offsetof(CPUState, tb_jmp_cache));
+    tcg_out_insn(s, 3502S, ADD_LSL, TCG_TYPE_PTR, entry, entry, tmp, 4);
+    tcg_out_insn(s, 3401, ADDI, TCG_TYPE_PTR, entry, entry,
+                 offsetof(CPUJumpCache, array));
+
+    for (unsigned slot = 0; slot < (boxdroid_jmp_cache2 ? 2 : 1); slot++) {
+        unsigned nslot = 0;
+        /* Aligned LDR implements the same relaxed atomic pointer read as C.
+         * The single vCPU owns pc/insertion; concurrent invalidators only
+         * clear the pointer. TB reclamation remains protected by cpu_exec RCU. */
+        tcg_out_ld(s, TCG_TYPE_PTR, tb, entry, 0);
+        slot_miss[nslot++] = boxdroid_lookup_cb(s, TCG_TYPE_PTR, tb, false);
+        tcg_out_ld(s, TCG_TYPE_I64, tmp, entry, 8);
+        slot_miss[nslot++] = boxdroid_lookup_ne(s, TCG_TYPE_I64, tmp, pc);
+        tcg_out_ld(s, TCG_TYPE_I64, tmp, tb, offsetof(TranslationBlock, cs_base));
+        slot_miss[nslot++] = boxdroid_lookup_cb(s, TCG_TYPE_I64, tmp, true);
+        tcg_out_ld(s, TCG_TYPE_I32, tmp, tb, offsetof(TranslationBlock, flags));
+        slot_miss[nslot++] = boxdroid_lookup_ne(s, TCG_TYPE_I32, tmp, flags);
+        tcg_out_ld(s, TCG_TYPE_I32, tmp, tb, offsetof(TranslationBlock, cflags));
+        slot_miss[nslot++] = boxdroid_lookup_ne(s, TCG_TYPE_I32, tmp, cflags);
+        if (boxdroid_inline_lookup_observe) {
+            tcg_out_movi(s, TCG_TYPE_PTR, tmp,
+                         (intptr_t)&boxdroid_inline_lookup_hits[slot]);
+            tcg_out_ld(s, TCG_TYPE_I64, work, tmp, 0);
+            tcg_out_insn(s, 3401, ADDI, TCG_TYPE_I64, work, work, 1);
+            tcg_out_st(s, TCG_TYPE_I64, work, tmp, 0);
+        }
+        tcg_out_ld(s, TCG_TYPE_PTR, env, tb, offsetof(TranslationBlock, tc.ptr));
+        done[ndone++] = s->code_ptr;
+        tcg_out_insn(s, 3206, B, 0);
+        for (unsigned i = 0; i < nslot; i++) {
+            bool patched = reloc_pc19(slot_miss[i], tcg_splitwx_to_rx(s->code_ptr));
+            tcg_debug_assert(patched);
+        }
+        if (slot == 0 && boxdroid_jmp_cache2) {
+            tcg_out_movi(s, TCG_TYPE_PTR, tmp,
+                offsetof(CPUJumpCache, secondary) - offsetof(CPUJumpCache, array));
+            tcg_out_insn(s, 3502, ADD, TCG_TYPE_PTR, entry, entry, tmp);
+        }
+    }
+    for (unsigned i = 0; i < nmiss; i++) {
+        bool patched = reloc_pc19(miss[i], tcg_splitwx_to_rx(s->code_ptr));
+        tcg_debug_assert(patched);
+    }
+    if (s->boxdroid_lookup_no_bridges && s->boxdroid_helper_prefix) {
+        tcg_out_mb(s, TCG_MO_ALL);
+    }
+    if (shared) {
+        /* Only the C miss needs a stack frame. Keep the original call-site
+         * LR so fast hits can return without any SP traffic. */
+        tcg_out_insn(s, 3314, STP, TCG_REG_XZR, TCG_REG_LR,
+                     TCG_REG_SP, -16, 1, 1);
+    }
+    tcg_out_call_int(s, target);
+    if (s->boxdroid_lookup_no_bridges && s->boxdroid_acquire_reads) {
+        tcg_out_mb(s, TCG_MO_LD_LD | TCG_MO_LD_ST);
+    }
+    if (shared) {
+        tcg_out_insn(s, 3314, LDP, TCG_REG_XZR, TCG_REG_LR,
+                     TCG_REG_SP, 16, 0, 1);
+    }
+    for (unsigned i = 0; i < ndone; i++) {
+        bool patched = reloc_pc26(done[i], tcg_splitwx_to_rx(s->code_ptr));
+        tcg_debug_assert(patched);
+    }
+    if (shared) {
+        tcg_out_insn(s, 3207, RET, TCG_REG_LR);
+    }
+}
+
+static void boxdroid_call_shared_lookup(TCGContext *s,
+                                       const tcg_insn_unit *target)
+{
+    unsigned variant = s->boxdroid_helper_prefix |
+                       (s->boxdroid_acquire_reads << 1);
+    const tcg_insn_unit *entry = s->boxdroid_lookup_shared[variant];
+    if (!entry) {
+        entry = s->boxdroid_lookup_pending[variant];
+    }
+    if (!entry) {
+        /* First caller skips the embedded routine, then calls it. Its code
+         * and constant pool live until the normal complete TCG cache reset. */
+        tcg_insn_unit *skip = s->code_ptr;
+        tcg_out_insn(s, 3206, B, 0);
+        entry = tcg_splitwx_to_rx(s->code_ptr);
+        tcg_out_bti(s, BTI_C);
+        boxdroid_out_lookup_tb_ptr(s, target, true);
+        bool patched = reloc_pc26(skip, tcg_splitwx_to_rx(s->code_ptr));
+        tcg_debug_assert(patched);
+        s->boxdroid_lookup_pending[variant] = entry;
+    }
+    tcg_out_call_int(s, entry);
+}
