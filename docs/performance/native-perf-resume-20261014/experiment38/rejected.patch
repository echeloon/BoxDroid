 {
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+    DisasContext *s = tcg_ctx->disas_ctx;
+    bool cache = tcg_ctx->boxdroid_fp_ptr_cache && !g_use_hard_fpu &&
+                 !s->base.plugin_enabled;
+    assert((unsigned)opreg < 8);
+    if (cache) {
+        TCGOp *op = s->boxdroid_ptr_cursor
+                    ? QTAILQ_NEXT(s->boxdroid_ptr_cursor, link)
+                    : QTAILQ_FIRST(&tcg_ctx->ops);
+
+        /* Derived addresses remain valid only while TOP is unchanged and
