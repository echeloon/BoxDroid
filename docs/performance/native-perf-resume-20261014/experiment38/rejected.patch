diff --git a/tcg/tcg.c b/tcg/tcg.c
index fae8cd809c..03db78b86d 100644
--- a/tcg/tcg.c
+++ b/tcg/tcg.c
@@ -2713,6 +2713,35 @@ bool tcg_op_deposit_valid(TCGType type, unsigned ofs, unsigned len)
 
 static TCGOp *tcg_op_alloc(TCGOpcode opc, unsigned nargs);
 
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+bool boxdroid_op_preserves_global(TCGOp *op, TCGArg global)
+{
+    const TCGOpDef *def = &tcg_op_defs[op->opc];
+    int outputs = def->nb_oargs;
+
+    if (op->opc == INDEX_op_set_label ||
+        (def->flags & (TCG_OPF_BB_END | TCG_OPF_BB_EXIT |
+                       TCG_OPF_COND_BRANCH))) {
+        return false;
+    }
+    if (op->opc == INDEX_op_call) {
+        /* NO_READ_GLOBALS implies NO_WRITE_GLOBALS. Unknown helpers may
+         * change the global, even when their explicit output is unrelated. */
+        if (!(tcg_call_flags(op) & (TCG_CALL_NO_READ_GLOBALS |
+                                    TCG_CALL_NO_WRITE_GLOBALS))) {
+            return false;
+        }
+        outputs = TCGOP_CALLO(op);
+    }
+    for (int i = 0; i < outputs; i++) {
+        if (op->args[i] == global) {
+            return false;
+        }
+    }
+    return true;
+}
+#endif
+
