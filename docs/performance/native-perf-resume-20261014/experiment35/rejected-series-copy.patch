# Experimental two-way published-TB backstop cache after current physical mapping resolution, with full TB identity, CF_INVALID rejection and code-cache lifetime clearing. Default phys_lookup0. Performance acceptance pending.

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index 1a53f14090..08c65be6e3 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -53,6 +53,8 @@
 #if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
 #include <sys/system_properties.h>
 bool boxdroid_jmp_cache2;
+bool boxdroid_phys_lookup;
+uint64_t boxdroid_phys_lookup_hits, boxdroid_phys_lookup_misses;
 bool boxdroid_inline_lookup_observe;
 uint64_t boxdroid_inline_lookup_hits[2];
 uint64_t boxdroid_inline_lookup_fallbacks;
@@ -223,6 +225,32 @@ tb_htable_lookup_common(CPUState *cpu, TCGTBCPUState s, const struct qht *ht,
     desc.page_addr0 = phys_pc;
     h = tb_hash_func(phys_pc, (s.cflags & CF_PCREL ? 0 : s.pc),
                      s.flags, s.cs_base, s.cflags);
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+    if (boxdroid_phys_lookup && ht == &tb_ctx.htable) {
+        TranslationBlock **cache = cpu->tb_jmp_cache->physical[
+            h & (BOXDROID_PHYS_TB_CACHE_SIZE - 1)];
+        for (unsigned way = 0; way < 2; way++) {
+            TranslationBlock *tb = cache[way];
+            /* QHT removes invalid TBs, so its comparator masks CF_INVALID.
+             * This cache must reject that bit explicitly before comparing. */
+            if (tb && !(tb_cflags(tb) & CF_INVALID) && func(tb, &desc)) {
+                if (boxdroid_inline_lookup_observe) {
+                    ++boxdroid_phys_lookup_hits;
+                }
+                return tb;
+            }
+        }
+        TranslationBlock *tb = qht_lookup_custom(ht, &desc, h, func);
+        if (tb) {
+            cache[1] = cache[0];
+            cache[0] = tb;
+        }
+        if (boxdroid_inline_lookup_observe) {
+            ++boxdroid_phys_lookup_misses;
+        }
+        return tb;
+    }
+#endif
     return qht_lookup_custom(ht, &desc, h, func);
 }
 
@@ -1176,6 +1204,9 @@ bool tcg_exec_realizefn(CPUState *cpu, Error **errp)
         char prop[PROP_VALUE_MAX] = {0};
         boxdroid_jmp_cache2 = __system_property_get("debug.boxdroid.jmp_cache2", prop) &&
                              !strcmp(prop, "1");
+        boxdroid_phys_lookup =
+            __system_property_get("debug.boxdroid.phys_lookup", prop) &&
+            !strcmp(prop, "1");
         boxdroid_inline_lookup_observe =
             __system_property_get("debug.boxdroid.inline_lookup_count", prop) &&
             !strcmp(prop, "1");
diff --git a/accel/tcg/tb-jmp-cache.h b/accel/tcg/tb-jmp-cache.h
index 3ce73f508b..6341c01bd5 100644
--- a/accel/tcg/tb-jmp-cache.h
+++ b/accel/tcg/tb-jmp-cache.h
@@ -14,6 +14,7 @@
 
 #define TB_JMP_CACHE_BITS 14
 #define TB_JMP_CACHE_SIZE (1 << TB_JMP_CACHE_BITS)
+#define BOXDROID_PHYS_TB_CACHE_SIZE 4096
 
 /*
  * Invalidated in parallel; all accesses to 'tb' must be atomic.
@@ -33,6 +34,10 @@ typedef struct CPUJumpCache {
         TranslationBlock *tb;
         vaddr pc;
     } secondary[TB_JMP_CACHE_SIZE];
+    /* Owner-CPU cache of published TBs. Every lookup revalidates the current
+     * physical code mapping and complete TB identity. CF_INVALID rejects SMC;
+     * whole code-cache flush clears these pointers before allocation reuse. */
+    TranslationBlock *physical[BOXDROID_PHYS_TB_CACHE_SIZE][2];
 #endif
 } CPUJumpCache;
 
diff --git a/accel/tcg/tb-maint.c b/accel/tcg/tb-maint.c
index cf52ced984..da43e68f85 100644
--- a/accel/tcg/tb-maint.c
+++ b/accel/tcg/tb-maint.c
@@ -28,6 +28,7 @@
 #include "exec/target_page.h"
 #include "accel/tcg/cpu-ops.h"
 #include "tb-internal.h"
+#include "tb-jmp-cache.h"
 #include "system/tcg.h"
 #include "tcg/tcg.h"
 #include "tb-hash.h"
@@ -786,6 +787,12 @@ void tb_flush__exclusive_or_serial(void)
 
     CPU_FOREACH(cpu) {
         tcg_flush_jmp_cache(cpu);
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+        if (cpu->tb_jmp_cache) {
+            memset(cpu->tb_jmp_cache->physical, 0,
+                   sizeof(cpu->tb_jmp_cache->physical));
+        }
+#endif
     }
 
     qht_reset_size(&tb_ctx.htable, CODE_GEN_HTABLE_SIZE);
