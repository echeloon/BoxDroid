+static void boxdroid_insert_recovery_uses(TCGContext *s)
+{
+    TCGOp *op, *next;
+    if (!s->boxdroid_recovery_mode || s->nb_indirects) {
+        return;
+    }
+    /* Restrict the prototype to globals with fixed, scalar CPU homes. */
+    for (unsigned i = 0; i < s->nb_globals; i++) {
+        TCGTemp *ts = &s->temps[i];
+        if (ts->kind != TEMP_FIXED &&
+            (ts->kind != TEMP_GLOBAL || !ts->mem_base ||
+             ts->mem_base->kind != TEMP_FIXED ||
+             (ts->type != TCG_TYPE_I32 && ts->type != TCG_TYPE_I64))) {
+            s->boxdroid_recovery_mode = 0;
+            return;
+        }
+    }
+    QTAILQ_FOREACH_SAFE(op, &s->ops, link, next) {
+        bool recover = boxdroid_recovery_memop(s, op);
+        bool commit = false;
+        if (!recover && s->boxdroid_recovery_mode == 3) {
+            if (op->opc == INDEX_op_call) {
+                commit = !(tcg_call_flags(op) & TCG_CALL_NO_READ_GLOBALS) ||
+                         !(tcg_call_flags(op) & TCG_CALL_NO_WRITE_GLOBALS);
+            } else {
+                commit = (tcg_op_defs[op->opc].flags &
+                    (TCG_OPF_SIDE_EFFECTS | TCG_OPF_BB_END | TCG_OPF_BB_EXIT)) != 0;
+            }
+        }
+        if (!recover && !commit) {
+            continue;
+        }
+        for (unsigned i = 0; i < s->nb_globals; i++) {
+            TCGTemp *ts = &s->temps[i];
+            if (ts->kind == TEMP_GLOBAL) {
+                TCGOp *use = tcg_op_insert_before(s, op,
+                    (recover ? INDEX_op_boxdroid_recover : INDEX_op_boxdroid_commit),
+                    ts->type, 1);
+                use->args[0] = temp_arg(ts);
+            }
+        }
+    }
+}
