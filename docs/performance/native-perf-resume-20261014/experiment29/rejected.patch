+static bool boxdroid_recovery_memop(TCGContext *s, const TCGOp *op)
+{
+    return s->boxdroid_recovery_mode && s->nb_indirects == 0 &&
+           s->addr_type == TCG_TYPE_I32 &&
+           (op->opc == INDEX_op_qemu_ld || op->opc == INDEX_op_qemu_st) &&
+           (get_memop(op->args[2]) & MO_SIZE) <= MO_64;
+}
