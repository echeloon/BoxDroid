+static void boxdroid_recovery_count(TCGContext *s, TCGLabelQemuLdst *lb,
+                                     bool cold)
+{
+    if (lb && lb->recovery && lb->recovery->count &&
+        boxdroid_inline_lookup_observe) {
+        uint64_t *counter = cold ? &boxdroid_recovery_cold_hits :
+                                   &boxdroid_recovery_fast_hits;
+        tcg_out_movi(s, TCG_TYPE_I64, TCG_REG_TMP2, (intptr_t)counter);
+        tcg_out_ld(s, TCG_TYPE_I64, TCG_REG_TMP0, TCG_REG_TMP2, 0);
+        tcg_out_insn(s, 3401, ADDI, TCG_TYPE_I64, TCG_REG_TMP0,
+                     TCG_REG_TMP0, 1);
+        tcg_out_st(s, TCG_TYPE_I64, TCG_REG_TMP0, TCG_REG_TMP2, 0);
+    }
+}
+
+static void boxdroid_out_recover_globals(TCGContext *s, TCGLabelQemuLdst *lb)
+{
+    boxdroid_recovery_count(s, lb, true);
+    BoxDroidMemRecovery *r = lb->recovery;
+    if (!r) {
+        return;
+    }
+    for (unsigned i = 0; i < r->count; i++) {
+        TCGReg value = r->entries[i].reg;
+        if (r->entries[i].constant) {
+            value = TCG_REG_TMP2;
+            tcg_out_movi(s, r->entries[i].type, value, r->entries[i].value);
+        }
+        tcg_out_st(s, r->entries[i].type, value, r->entries[i].base,
+                    r->entries[i].offset);
+    }
+}
+
+/* Preserve live caller registers only on the out-of-line helper path.
+ * Scalar memory helpers use register arguments; the dynamic frame does not
+ * overlap TCG's spill slots. A fault unwinds directly through QEMU's recovery. */
+static unsigned boxdroid_mem_frame_size(TCGRegSet regs)
+{
+    unsigned size = 0;
+    for (int i = 0; i < TCG_TARGET_NB_REGS; i++) {
+        if (tcg_regset_test_reg(regs, i)) {
+            size += i >= TCG_REG_V0 ? 16 : 8;
+        }
+    }
+    return QEMU_ALIGN_UP(size, 16);
+}
+
+static void boxdroid_mem_push_regs(TCGContext *s, TCGLabelQemuLdst *lb)
+{
+    unsigned frame = boxdroid_mem_frame_size(lb->preserved_regs);
+    unsigned offset = 0;
+    if (!frame) {
+        return;
+    }
+    tcg_debug_assert(frame <= 4095);
+    tcg_out_insn(s, 3401, SUBI, TCG_TYPE_I64, TCG_REG_SP, TCG_REG_SP, frame);
+    for (int i = 0; i < TCG_TARGET_NB_REGS; i++) {
+        if (tcg_regset_test_reg(lb->preserved_regs, i)) {
+            bool vector = i >= TCG_REG_V0;
+            tcg_out_st(s, vector ? TCG_TYPE_V128 : TCG_TYPE_I64,
+                       i, TCG_REG_SP, offset);
+            offset += vector ? 16 : 8;
+        }
+    }
+}
+
+static void boxdroid_mem_pop_regs(TCGContext *s, TCGLabelQemuLdst *lb)
+{
+    unsigned frame = boxdroid_mem_frame_size(lb->preserved_regs);
+    unsigned offset = 0;
+    if (!frame) {
+        return;
+    }
+    for (int i = 0; i < TCG_TARGET_NB_REGS; i++) {
+        if (tcg_regset_test_reg(lb->preserved_regs, i)) {
+            bool vector = i >= TCG_REG_V0;
+            /* The load result has already replaced its old value. */
+            if (!lb->is_ld || i != lb->datalo_reg) {
+                tcg_out_ld(s, vector ? TCG_TYPE_V128 : TCG_TYPE_I64,
+                           i, TCG_REG_SP, offset);
+            }
+            offset += vector ? 16 : 8;
+        }
+    }
+    tcg_out_insn(s, 3401, ADDI, TCG_TYPE_I64, TCG_REG_SP, TCG_REG_SP, frame);
+}
