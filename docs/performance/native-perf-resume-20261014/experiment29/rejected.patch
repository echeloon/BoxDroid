+static BoxDroidMemRecovery *boxdroid_capture_globals(TCGContext *s)
+{
+    BoxDroidMemRecovery *r = tcg_malloc(sizeof(*r) + s->nb_globals *
+                                       sizeof(r->entries[0]));
+    r->count = 0;
+    r->regs = 0;
+    for (unsigned i = 0; i < s->nb_globals; i++) {
+        TCGTemp *ts = &s->temps[i];
+        if (temp_readonly(ts) || ts->mem_coherent ||
+            (ts->val_type != TEMP_VAL_REG && ts->val_type != TEMP_VAL_CONST)) {
+            continue;
+        }
+        tcg_debug_assert(ts->mem_allocated && ts->mem_base->kind == TEMP_FIXED);
+        unsigned n = r->count++;
+        r->entries[n].type = ts->type;
+        r->entries[n].reg = ts->reg;
+        r->entries[n].base = ts->mem_base->reg;
+        r->entries[n].offset = ts->mem_offset;
+        r->entries[n].constant = ts->val_type == TEMP_VAL_CONST;
+        r->entries[n].value = ts->val;
+        if (!r->entries[n].constant) {
+            tcg_regset_set_reg(r->regs, ts->reg);
+        }
+    }
+    return r;
+}
