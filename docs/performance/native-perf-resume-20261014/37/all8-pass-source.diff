+            addr <= memory_region_size(d->vram) - len) {
+            pending->nv2a = d;
+            pending->addr = addr;
+            pending->len = len;
+            memcpy(pending->before, d->vram_ptr + addr, len);
+            pending->guest_pc = guest_pc;
+            pending->pcrtc_start = d->pcrtc.start;
+            pending->pre_store_us = g_get_monotonic_time();
+            pending->valid = true;
+        }
+    } else {
+        boxdroid_diag_vram_read("guest-memory-read", addr, len);
+    }
