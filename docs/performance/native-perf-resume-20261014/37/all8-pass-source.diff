 #include "xid.h"
+#ifdef BOXDROID_INPUT
+#include "system/boxdroid-input.h"
+
+static int16_t boxdroid_axis(float value)
+{
+    if (value <= -1.0f) return INT16_MIN;
+    if (value >= 1.0f) return INT16_MAX;
+    return value < 0.0f ? (int16_t)(value * 32768.0f)
+                        : (int16_t)(value * 32767.0f);
+}
+
+static uint8_t boxdroid_pressure(float value)
+{
+    if (value <= 0.0f) return 0;
+    if (value >= 1.0f) return UINT8_MAX;
+    return (uint8_t)(value * 255.0f + 0.5f);
+}
+
+static void boxdroid_update_input(USBXIDGamepadState *s)
+{
+    BoxDroidInputState state;
+    uint32_t buttons;
+    uint16_t dpad = 0;
+    if (!boxdroid_input_snapshot_primary(&state)) {
+        return;
+    }
+    buttons = state.connected ? state.buttons : 0;
+    s->in_state.bAnalogButtons[GAMEPAD_A] = (buttons & BOXDROID_A) ? UINT8_MAX : 0;
+    s->in_state.bAnalogButtons[GAMEPAD_B] = (buttons & BOXDROID_B) ? UINT8_MAX : 0;
+    s->in_state.bAnalogButtons[GAMEPAD_X] = (buttons & BOXDROID_X) ? UINT8_MAX : 0;
+    s->in_state.bAnalogButtons[GAMEPAD_Y] = (buttons & BOXDROID_Y) ? UINT8_MAX : 0;
+    s->in_state.bAnalogButtons[GAMEPAD_WHITE] = (buttons & BOXDROID_WHITE) ? UINT8_MAX : 0;
+    s->in_state.bAnalogButtons[GAMEPAD_BLACK] = (buttons & BOXDROID_BLACK) ? UINT8_MAX : 0;
+    s->in_state.bAnalogButtons[GAMEPAD_LEFT_TRIGGER] =
+        boxdroid_pressure(state.connected ? state.left_trigger : 0.0f);
+    s->in_state.bAnalogButtons[GAMEPAD_RIGHT_TRIGGER] =
+        boxdroid_pressure(state.connected ? state.right_trigger : 0.0f);
+    if (buttons & BOXDROID_DPAD_U) dpad |= BUTTON_MASK(GAMEPAD_DPAD_UP);
+    if (buttons & BOXDROID_DPAD_D) dpad |= BUTTON_MASK(GAMEPAD_DPAD_DOWN);
+    if (buttons & BOXDROID_DPAD_L) dpad |= BUTTON_MASK(GAMEPAD_DPAD_LEFT);
+    if (buttons & BOXDROID_DPAD_R) dpad |= BUTTON_MASK(GAMEPAD_DPAD_RIGHT);
+    if (buttons & BOXDROID_START) dpad |= BUTTON_MASK(GAMEPAD_START);
+    if (buttons & BOXDROID_BACK) dpad |= BUTTON_MASK(GAMEPAD_BACK);
+    if (buttons & BOXDROID_L3) dpad |= BUTTON_MASK(GAMEPAD_LEFT_THUMB);
+    if (buttons & BOXDROID_R3) dpad |= BUTTON_MASK(GAMEPAD_RIGHT_THUMB);
+    s->in_state.wButtons = dpad;
+    s->in_state.sThumbLX = boxdroid_axis(state.connected ? state.left_x : 0.0f);
+    s->in_state.sThumbLY = boxdroid_axis(state.connected ? state.left_y : 0.0f);
+    s->in_state.sThumbRX = boxdroid_axis(state.connected ? state.right_x : 0.0f);
+    s->in_state.sThumbRY = boxdroid_axis(state.connected ? state.right_y : 0.0f);
+}
+#endif
 
