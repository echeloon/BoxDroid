+/* This buffer is used only by synchronous surface-to-host downloads.
+ * Previous single-time submissions have completed before the next download;
+ * explicitly wait again on the rare growth path before replacing storage. */
+void pgraph_vk_ensure_download_buffer(PGRAPHState *pg, size_t bytes)
+{
+    PGRAPHVkState *r = pg->vk_renderer_state;
+    StorageBuffer *buffer = &r->storage_buffers[BUFFER_STAGING_DST];
+    if (bytes <= buffer->buffer_size) {
+        return;
+    }
+    assert(bytes <= 4096 * 4096 * 4);
+    VK_CHECK(vkQueueWaitIdle(r->queue));
+    destroy_buffer(pg, buffer);
+    buffer->buffer_size = MIN(ROUND_UP(bytes, 2 * MiB), 4096 * 4096 * 4);
+    create_buffer(pg, buffer);
