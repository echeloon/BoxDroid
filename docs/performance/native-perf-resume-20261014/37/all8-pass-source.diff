+static bool boxdroid_sse_mulps(CPUX86State *env, ZMMReg *d,
+                              const ZMMReg *v, const ZMMReg *s)
+{
+    uint64_t fpcr, fpsr;
+    uint32x4_t a, b, r, aa, ab, ea, eb, valid, ar, zero_input;
+
+    /* No new guest exception flags can be hidden behind the native operation. */
+    if (!boxdroid_sse_native_enabled() ||
