+    void helper_boxdroid_##name(CPUX86State *env, void *destination, void *source) \
+    { \
+        floatx80 *d = destination, *v = source; \
+        int old_flags = save_arithmetic_exception_flags(env); \
+        *d = (expression); \
+        merge_exception_flags(env, old_flags); \
+    }
+BOXDROID_FP_BINARY(fadd, floatx80_add(*d, *v, &env->fp_status))
+BOXDROID_FP_BINARY(fmul, floatx80_mul(*d, *v, &env->fp_status))
+BOXDROID_FP_BINARY(fsub, floatx80_sub(*d, *v, &env->fp_status))
+BOXDROID_FP_BINARY(fsubr, floatx80_sub(*v, *d, &env->fp_status))
+BOXDROID_FP_BINARY(fdiv, floatx80_div(*d, *v, &env->fp_status))
+BOXDROID_FP_BINARY(fdivr, floatx80_div(*v, *d, &env->fp_status))
+#undef BOXDROID_FP_BINARY
+
+extern bool boxdroid_inline_lookup_observe;
+extern uint64_t boxdroid_inline_fmul_requests, boxdroid_inline_fmul_hits;
+extern uint64_t boxdroid_fmul53_slow_calls;
+#ifdef __clang__
+#define BOXDROID_MUL53_ABI __attribute__((preserve_most))
+#else
+#define BOXDROID_MUL53_ABI
+#endif
+static __attribute__((noinline)) BOXDROID_MUL53_ABI
+void boxdroid_fmul53_slow(CPUX86State *env, void *destination, void *source)
+{
+    if (boxdroid_inline_lookup_observe) {
+        qatomic_set(&boxdroid_fmul53_slow_calls,
+                    qatomic_read(&boxdroid_fmul53_slow_calls) + 1);
+    }
+    floatx80 *d = destination, *v = source;
+    int old_flags = save_arithmetic_exception_flags(env);
+    *d = floatx80_mul(*d, *v, &env->fp_status);
+    merge_exception_flags(env, old_flags);
+}
+
+/* Same certified normal PC=53/RN domain as 0033, shared between TBs. The
+ * common path is a leaf; the conservative path keeps the complete existing
+ * arithmetic/status protocol. The original standard-ABI helper stays intact
+ * for comparisons and for configurations which do not select this helper. */
+void helper_boxdroid_fmul53(CPUX86State *env, void *destination, void *source)
+{
+    if (boxdroid_inline_lookup_observe) {
+        qatomic_set(&boxdroid_inline_fmul_requests,
+                    qatomic_read(&boxdroid_inline_fmul_requests) + 1);
+    }
+    float_status *s = &env->fp_status;
+    const floatx80 a = *(floatx80 *)destination, b = *(floatx80 *)source;
+    unsigned ea = a.high & 0x7fff, eb = b.high & 0x7fff;
+    if (s->floatx80_rounding_precision == floatx80_precision_d &&
+        s->float_rounding_mode == float_round_nearest_even &&
+        (env->fpuc & 0x3f) == 0x3f && (env->fpus & FPUS_PE) &&
+        (s->float_exception_flags & float_flag_inexact) &&
+        ea - 15933 <= 900 && eb - 15933 <= 900 &&
+        ((a.low & b.low) >> 63) && !((a.low | b.low) & 0x7ff) &&
+        s->boxdroid_fast_fpu_state == 1 &&
+        (s->boxdroid_fast_fpu_checks & 0xffff)) {
+        uint64_t control;
+        asm volatile("mrs %0, fpcr" : "=r"(control));
+        if (!(control & ~(UINT64_C(3) << 24))) {
+            union { uint64_t bits; double value; } x, y, product;
+            x.bits = ((uint64_t)(a.high & 0x8000) << 48) |
+                     ((uint64_t)(ea - 15360) << 52) |
+                     ((a.low >> 11) & UINT64_C(0xfffffffffffff));
+            y.bits = ((uint64_t)(b.high & 0x8000) << 48) |
+                     ((uint64_t)(eb - 15360) << 52) |
+                     ((b.low >> 11) & UINT64_C(0xfffffffffffff));
+            asm volatile("fmul %d0, %d1, %d2" : "=w"(product.value)
+                         : "w"(x.value), "w"(y.value));
+            uint64_t *words = destination;
+            words[0] = (UINT64_C(1) << 63) | (product.bits << 11);
+            words[1] = ((product.bits >> 48) & 0x8000) |
+                       (((product.bits >> 52) & 0x7ff) + 15360);
+            ++s->boxdroid_fast_fpu_checks;
+            if (boxdroid_inline_lookup_observe) {
+                qatomic_set(&boxdroid_inline_fmul_hits,
+                            qatomic_read(&boxdroid_inline_fmul_hits) + 1);
+            }
+            return;
+        }
+    }
+    boxdroid_fmul53_slow(env, destination, source);
+}
+#undef BOXDROID_MUL53_ABI
