+/* Experimental, process-latched control; the exact scalar path is the default. */
+static bool boxdroid_sse_native_enabled(void)
+{
+    static gsize mode;
+
+    if (g_once_init_enter(&mode)) {
+        char prop[PROP_VALUE_MAX] = {0};
+        bool enabled = __system_property_get("debug.boxdroid.sse_native", prop) &&
+                       !strcmp(prop, "1");
+        g_once_init_leave(&mode, enabled ? 2 : 1);
+    }
+    return mode == 2;
+}
