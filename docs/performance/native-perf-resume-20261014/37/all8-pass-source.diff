+static void boxdroid_vram_access_callback(void *opaque, MemoryRegion *mr,
+                                             hwaddr addr, hwaddr len,
+                                             bool write)
+{
+    NV2AState *d = opaque;
+    BoxDroidPendingStore *pending = &boxdroid_pending_store;
+    (void)mr;
+    /* The QEMU callback fires before an access. A subsequent callback on
+     * this vCPU thread observes the completed previous store's bytes. */
+    if (pending->valid) {
+        uint8_t after[8];
+        memcpy(after, pending->nv2a->vram_ptr + pending->addr,
