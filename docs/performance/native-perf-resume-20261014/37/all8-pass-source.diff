+#ifdef BOXDROID_XBOX_RUNTIME
+#include "hw/xbox/nv2a/boxdroid-diagnostics.h"
+#ifdef BOXDROID_RUNTIME
+#include <android/log.h>
+static void render_metric(unsigned kind, int64_t elapsed)
+{
+    static struct { uint64_t calls, total, maximum; } stats[12];
+    static int64_t report;
+    int64_t now=g_get_monotonic_time();
+    if (!report) report=now;
+    stats[kind].calls++; stats[kind].total+=elapsed;
+    stats[kind].maximum=MAX(stats[kind].maximum,elapsed);
+    if (now-report<G_USEC_PER_SEC) return;
+    for (unsigned i=0;i<12;++i) {
+        if (!stats[i].calls) continue;
+        __android_log_print(ANDROID_LOG_INFO,"BoxDroid",
+            "NV_RENDER kind=%u interval_us=%lld calls=%llu total_us=%llu maximum_us=%llu",
+            i,(long long)(now-report),(unsigned long long)stats[i].calls,
+            (unsigned long long)stats[i].total,(unsigned long long)stats[i].maximum);
+        stats[i].calls=stats[i].total=stats[i].maximum=0;
+    }
+    report=now;
+}
+#endif
+
+
+static bool boxdroid_logged_vk32_render_pass_target;
+static bool boxdroid_logged_vk32_first_render_submit;
+static bool boxdroid_logged_vk32_late_render_submit;
+static bool boxdroid_logged_vk32_first_render_complete;
+static bool boxdroid_logged_vk32_late_render_complete;
+static bool boxdroid_logged_vk32_late_finish_state;
+/* The preceding bounded run reached 229 emitted draws on this binding;
+ * sample once near that late state after the rendering fence completes. */
+#define BOXDROID_VK32_LATE_PROBE_DRAW_THRESHOLD 200
+
+static uint64_t boxdroid_pack32(uint32_t high, uint32_t low)
+{
+    return ((uint64_t)high << 32) | low;
+}
+
+static void boxdroid_record_guest_draw(PGRAPHState *pg, uint64_t api,
+                                          uint64_t vertex_count,
+                                          uint64_t index_count)
+{
+    PGRAPHVkState *r = pg->vk_renderer_state;
+    SurfaceBinding *surface = r->color_binding;
+    if (!surface || (surface->vram_addr != UINT64_C(0x32a4000) &&
+                     surface->vram_addr != UINT64_C(0x3628000) &&
+                     surface->vram_addr != UINT64_C(0x3c00000) &&
+                     surface->vram_addr != UINT64_C(0x3d00000))) {
+        return;
+    }
+    if (surface->vram_addr == UINT64_C(0x32a4000)) {
+        uint64_t draw_count = qatomic_fetch_inc(
+            &r->boxdroid_vk32_guest_draw_count) + 1;
+        r->boxdroid_vk32_last_draw_surface = surface;
+        if (draw_count == 1 || draw_count == 64 || draw_count == 128 ||
+            draw_count == 192 || draw_count ==
+                BOXDROID_VK32_LATE_PROBE_DRAW_THRESHOLD) {
+            boxdroid_diag_record("VK32_EMITTED_DRAW_CHECKPOINT",
+                draw_count, api, pg->primitive_mode, vertex_count,
+                index_count, (uint64_t)surface->image);
+            ShaderState state = pgraph_glsl_get_shader_state(pg);
+            boxdroid_diag_record("VK32_MATCH_GUEST", draw_count,
+                fast_hash((const uint8_t *)&state, sizeof(state)),
+                fast_hash((const uint8_t *)pg->vsh_constants, sizeof(pg->vsh_constants)),
+                pgraph_reg_r(pg, NV_PGRAPH_CONTROL_0),
+                pgraph_reg_r(pg, NV_PGRAPH_CONTROL_1),
+                pgraph_reg_r(pg, NV_PGRAPH_BLEND));
+            boxdroid_diag_record("VK32_MATCH_INPUT", draw_count,
+                pg->draw_time, pg->inline_array_length,
+                fast_hash((const uint8_t *)pg->inline_array, pg->inline_array_length * 4),
+                pgraph_reg_r(pg, NV_PGRAPH_SETUPRASTER),
+                fast_hash((const uint8_t *)pg->program_data, sizeof(pg->program_data)));
+            ShaderBinding *binding = r->shader_binding;
+            boxdroid_diag_record("VK32_MATCH_PROGRAM", draw_count,
+                fast_hash(binding->vsh.module_info->spirv->data, binding->vsh.module_info->spirv->len),
+                fast_hash(binding->psh.module_info->spirv->data, binding->psh.module_info->spirv->len),
+                r->uniform_buffer_hashes[0], r->uniform_buffer_hashes[1],
+                (uint64_t)r->pipeline_binding->pipeline);
+            boxdroid_diag_record("VK32_MATCH_DESCRIPTOR", draw_count,
+                r->descriptor_set_index,
+                r->uniform_buffer_offsets[0], r->uniform_buffer_offsets[1],
+                fast_hash((const uint8_t *)&r->pipeline_binding->key, sizeof(r->pipeline_binding->key)),
+                (uint64_t)r->descriptor_sets[r->descriptor_set_index-1]);
+            for (int i=0; i<NV2A_MAX_TEXTURES; i++) {
+                TextureBinding *texture = r->texture_bindings[i];
+                boxdroid_diag_record("VK32_MATCH_TEXTURE", draw_count, i,
+                    texture->key.texture_vram_offset, texture->key.texture_length,
+                    (uint64_t)texture->image,
+                    texture->key.texture_length ? fast_hash(container_of(pg, NV2AState, pgraph)->vram_ptr + texture->key.texture_vram_offset, texture->key.texture_length) : 0);
+            }
+        }
+        if (draw_count == BOXDROID_VK32_LATE_PROBE_DRAW_THRESHOLD) {
+            boxdroid_diag_record("VK32_DRAW_THRESHOLD_STATE",
+                draw_count, (uint64_t)surface->image, r->submit_count,
+                r->in_command_buffer, r->in_render_pass,
+                surface->draw_dirty);
+        }
+    }
+
+    uint32_t control_0 = pgraph_reg_r(pg, NV_PGRAPH_CONTROL_0);
+    uint32_t setup = pgraph_reg_r(pg, NV_PGRAPH_SETUPRASTER);
+    uint32_t cull = (setup & NV_PGRAPH_SETUPRASTER_CULLENABLE) ?
+        GET_MASK(setup, NV_PGRAPH_SETUPRASTER_CULLCTRL) : 0;
+    uint32_t depth = !!(control_0 & NV_PGRAPH_CONTROL_0_ZENABLE);
+    uint32_t stencil = !!(pgraph_reg_r(pg, NV_PGRAPH_CONTROL_1) &
+                          NV_PGRAPH_CONTROL_1_STENCIL_TEST_ENABLE);
+    uint32_t depth_write = !!(control_0 & NV_PGRAPH_CONTROL_0_ZWRITEENABLE);
+    uint32_t write_mask = 0;
+    unsigned int x = pg->surface_shape.clip_x;
+    unsigned int y = pg->surface_shape.clip_y;
+    unsigned int width = pg->surface_shape.clip_width;
+    unsigned int height = pg->surface_shape.clip_height;
+    uint64_t values[8] = {0};
+
+    if (control_0 & NV_PGRAPH_CONTROL_0_RED_WRITE_ENABLE) write_mask |= 1;
+    if (control_0 & NV_PGRAPH_CONTROL_0_GREEN_WRITE_ENABLE) write_mask |= 2;
+    if (control_0 & NV_PGRAPH_CONTROL_0_BLUE_WRITE_ENABLE) write_mask |= 4;
+    if (control_0 & NV_PGRAPH_CONTROL_0_ALPHA_WRITE_ENABLE) write_mask |= 8;
+    pgraph_apply_anti_aliasing_factor(pg, &x, &y);
+    pgraph_apply_anti_aliasing_factor(pg, &width, &height);
+    pgraph_apply_scaling_factor(pg, &x, &y);
+    pgraph_apply_scaling_factor(pg, &width, &height);
+
+    values[0] = api;
+    values[1] = pg->primitive_mode;
+    values[2] = vertex_count;
+    values[3] = index_count;
+    values[4] = write_mask;
+    values[5] = boxdroid_pack32(x, y);
+    values[6] = boxdroid_pack32(width, height);
+    values[7] = cull | (depth << 8) | (stencil << 16) | (depth_write << 24);
+    boxdroid_diag_binding_event(BOXDROID_BINDING_GUEST_DRAW,
+        surface->vram_addr, surface->boxdroid_generation, values);
+}
+
+static void boxdroid_record_clear(PGRAPHState *pg, SurfaceBinding *surface,
+                                     uint32_t parameter,
+                                     const VkClearRect *clear_rect,
+                                     const float rgba[4])
+{
+    if (!surface || !surface->color ||
+        (surface->vram_addr != UINT64_C(0x32a4000) &&
+         surface->vram_addr != UINT64_C(0x3628000) &&
+         surface->vram_addr != UINT64_C(0x3c00000) &&
+         surface->vram_addr != UINT64_C(0x3d00000))) {
+        return;
+    }
+    uint32_t rgba_bits[4];
+    memcpy(rgba_bits, rgba, sizeof(rgba_bits));
+    uint64_t values[8] = {
