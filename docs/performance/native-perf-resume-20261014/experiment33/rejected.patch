+/* Same normal PC=53/RN domain as 0033. Only inexact can arise, and both
+ * architectural precision flags are already sticky and masked. Keeping the
+ * existing status words therefore has exactly the original merge effect.
+ * No source operand is modified until all eligibility checks have passed. */
+static inline QEMU_ALWAYS_INLINE bool
+boxdroid_arith_leaf(CPUX86State *env, void *destination, void *source,
+                    unsigned operation)
+{
+    if (!boxdroid_arith_leaf_requested) {
+        return false;
+    }
+    float_status *status = &env->fp_status;
+    floatx80 a = *(floatx80 *)destination, b = *(floatx80 *)source;
+    unsigned ea = a.high & 0x7fff, eb = b.high & 0x7fff;
+    if (status->floatx80_rounding_precision != floatx80_precision_d ||
+        status->float_rounding_mode != float_round_nearest_even ||
+        (env->fpuc & FPUC_EM) != FPUC_EM || !(env->fpus & FPUS_PE) ||
+        !(status->float_exception_flags & float_flag_inexact) ||
+        ea - 15933 > 900 || eb - 15933 > 900 ||
+        !((a.low & b.low) >> 63) || ((a.low | b.low) & 0x7ff) ||
+        status->boxdroid_fast_fpu_state != 1 ||
+        !(status->boxdroid_fast_fpu_checks & 0xffff)) {
+        return false;
+    }
+    uint64_t control;
+    asm volatile("mrs %0, fpcr" : "=r"(control));
+    /* Ignore only FZ/DN: all operands/results are finite normal or exact
+     * cancellation zero. Reject non-nearest rounding, traps and unknown bits. */
+    if (control & ~(UINT64_C(3) << 24)) {
+        return false;
+    }
+    union { uint64_t bits; double value; } x, y, result;
+    x.bits = ((uint64_t)(a.high & 0x8000) << 48) |
+             ((uint64_t)(ea - 15360) << 52) |
+             ((a.low >> 11) & UINT64_C(0xfffffffffffff));
+    y.bits = ((uint64_t)(b.high & 0x8000) << 48) |
+             ((uint64_t)(eb - 15360) << 52) |
+             ((b.low >> 11) & UINT64_C(0xfffffffffffff));
+    switch (operation) {
+    case 0: asm volatile("fadd %d0, %d1, %d2" : "=w"(result.value)
+                        : "w"(x.value), "w"(y.value)); break;
+    case 1: asm volatile("fmul %d0, %d1, %d2" : "=w"(result.value)
+                        : "w"(x.value), "w"(y.value)); break;
+    case 2: asm volatile("fsub %d0, %d1, %d2" : "=w"(result.value)
+                        : "w"(x.value), "w"(y.value)); break;
+    case 3: asm volatile("fsub %d0, %d1, %d2" : "=w"(result.value)
+                        : "w"(y.value), "w"(x.value)); break;
+    case 4: asm volatile("fdiv %d0, %d1, %d2" : "=w"(result.value)
+                        : "w"(x.value), "w"(y.value)); break;
+    case 5: asm volatile("fdiv %d0, %d1, %d2" : "=w"(result.value)
+                        : "w"(y.value), "w"(x.value)); break;
+    default: g_assert_not_reached();
+    }
+    unsigned exponent = (result.bits >> 52) & 0x7ff;
+    uint64_t *words = destination;
+    words[0] = exponent ? (UINT64_C(1) << 63) | (result.bits << 11) : 0;
+    words[1] = ((result.bits >> 48) & 0x8000) |
+               (exponent ? exponent + 15360 : 0);
+    ++status->boxdroid_fast_fpu_checks;
+    if (boxdroid_inline_lookup_observe) {
+        qatomic_set(&boxdroid_arith_leaf_hits[operation],
+                    qatomic_read(&boxdroid_arith_leaf_hits[operation]) + 1);
+    }
+    return true;
+}
