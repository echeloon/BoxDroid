+static floatx80 boxdroid_value_unpack(Int128 bits)
+{
+    return (floatx80) { .low = int128_getlo(bits), .high = int128_gethi(bits) };
+}
+
+static Int128 boxdroid_value_pack(floatx80 value)
+{
+    return int128_make128(value.low, value.high);
+}
+
+#define BOXDROID_VALUE_BINARY(name, expression) \
+Int128 helper_boxdroid_value_##name(CPUX86State *env, Int128 left, Int128 right) \
+{ \
+    floatx80 a = boxdroid_value_unpack(left), b = boxdroid_value_unpack(right); \
+    int old = save_arithmetic_exception_flags(env); \
+    floatx80 result = (expression); \
+    merge_exception_flags(env, old); \
+    return boxdroid_value_pack(result); \
+}
+BOXDROID_VALUE_BINARY(add, floatx80_add(a, b, &env->fp_status))
+BOXDROID_VALUE_BINARY(mul, floatx80_mul(a, b, &env->fp_status))
+BOXDROID_VALUE_BINARY(sub, floatx80_sub(a, b, &env->fp_status))
+BOXDROID_VALUE_BINARY(subr, floatx80_sub(b, a, &env->fp_status))
+BOXDROID_VALUE_BINARY(div, floatx80_div(a, b, &env->fp_status))
+BOXDROID_VALUE_BINARY(divr, floatx80_div(b, a, &env->fp_status))
+#undef BOXDROID_VALUE_BINARY
+
+/* Keep address-taking and the pointer ABI entirely off common value paths. */
+static __attribute__((noinline))
+Int128 boxdroid_value_load32_slow(CPUX86State *env, uint32_t bits)
+{
+    floatx80 value = { 0 };
+    helper_boxdroid_f32_load(env, &value, bits);
+    return boxdroid_value_pack(value);
+}
+
+Int128 helper_boxdroid_value_load32(CPUX86State *env, uint32_t bits)
+{
+    unsigned exponent = (bits >> 23) & 0xff;
+    if ((exponent && exponent != 0xff) || !(bits & 0x7fffffff)) {
+        uint64_t low = exponent ? (UINT64_C(1) << 63) |
+            ((uint64_t)(bits & 0x7fffff) << 40) : 0;
+        unsigned high = ((bits >> 31) << 15) |
+            (exponent ? exponent + 16256 : 0);
+        fpu_set_exception(env, 0);
+        return int128_make128(low, high);
+    }
+    return boxdroid_value_load32_slow(env, bits);
+}
+
+static __attribute__((noinline))
+uint32_t boxdroid_value_store32_slow(CPUX86State *env, Int128 bits)
+{
+    floatx80 value = boxdroid_value_unpack(bits);
+    return helper_boxdroid_f32_store(env, &value);
+}
+
+uint32_t helper_boxdroid_value_store32(CPUX86State *env, Int128 bits)
+{
+    uint64_t low = int128_getlo(bits);
+    unsigned high = (uint16_t)int128_gethi(bits);
+    unsigned exponent = high & 0x7fff;
+    bool negative = high >> 15;
+    if (!exponent && !low) {
+        fpu_set_exception(env, 0);
+        return (uint32_t)negative << 31;
+    }
+    if (exponent > 16256 && exponent < 16511 && (low >> 63)) {
+        uint64_t discarded = low & ((UINT64_C(1) << 40) - 1);
+        unsigned significand = low >> 40;
+        unsigned binary32_exp = exponent - 16256;
+        if (discarded) {
+            bool increment;
+            if (!boxdroid_f32_round_requested) {
+                return boxdroid_value_store32_slow(env, bits);
+            }
+            switch (get_float_rounding_mode(&env->fp_status)) {
+            case float_round_nearest_even:
+                increment = discarded > (UINT64_C(1) << 39) ||
+                    (discarded == (UINT64_C(1) << 39) && (significand & 1));
+                break;
+            case float_round_down:
+                increment = negative;
+                break;
+            case float_round_up:
+                increment = !negative;
+                break;
+            case float_round_to_zero:
+                increment = false;
+                break;
+            default:
+                return boxdroid_value_store32_slow(env, bits);
+            }
+            significand += increment;
+            if (significand == (1u << 24)) {
+                if (binary32_exp == 254) {
+                    return boxdroid_value_store32_slow(env, bits);
+                }
+                significand >>= 1;
+                binary32_exp++;
+            }
+            float_raise(float_flag_inexact, &env->fp_status);
+        }
+        fpu_set_exception(env, discarded ? FPUS_PE : 0);
+        return ((uint32_t)negative << 31) | (binary32_exp << 23) |
+            (significand & 0x7fffff);
+    }
+    return boxdroid_value_store32_slow(env, bits);
+}
+
+Int128 helper_boxdroid_value_sqrt(CPUX86State *env, Int128 bits)
+{
+    floatx80 value = boxdroid_value_unpack(bits);
+    int old = save_arithmetic_exception_flags(env);
+    if (floatx80_is_neg(value)) {
+        env->fpus &= ~0x4700;
+        env->fpus |= 0x400;
+    }
+    value = floatx80_sqrt(value, &env->fp_status);
+    merge_exception_flags(env, old);
+    return boxdroid_value_pack(value);
+}
+
+Int128 helper_boxdroid_value_sin(CPUX86State *env, Int128 bits)
+{
+    floatx80 value = boxdroid_value_unpack(bits);
+    double temporary = floatx80_to_double(env, value);
+    if ((temporary > MAXTAN) || (temporary < -MAXTAN)) {
+        env->fpus |= 0x400;
+    } else {
+        value = double_to_floatx80(env, sin(temporary));
+        env->fpus &= ~0x400;
+    }
+    return boxdroid_value_pack(value);
+}
+
+Int128 helper_boxdroid_value_cos(CPUX86State *env, Int128 bits)
+{
+    floatx80 value = boxdroid_value_unpack(bits);
+    double temporary = floatx80_to_double(env, value);
+    if ((temporary > MAXTAN) || (temporary < -MAXTAN)) {
+        env->fpus |= 0x400;
+    } else {
+        value = double_to_floatx80(env, cos(temporary));
+        env->fpus &= ~0x400;
+    }
+    return boxdroid_value_pack(value);
+}
