--- a/include/tcg/tcg.h
+++ b/include/tcg/tcg.h
@@ -389,6 +389,7 @@ struct TCGContext {
     bool boxdroid_ordered_stores, boxdroid_ordered_loads, boxdroid_rcpc;
 #if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
     bool boxdroid_fp_local_requested;
+    bool boxdroid_x87_bits_requested;
     bool boxdroid_fp_preserve_requested;
