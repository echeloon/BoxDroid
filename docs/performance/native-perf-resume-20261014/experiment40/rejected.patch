# Experiment40: exact x87 register swap/sign operations in TCG; default x87_bits0; focused and performance acceptance pending.

diff --git a/accel/tcg/translate-all.c b/accel/tcg/translate-all.c
index b7fb75bebf..4d5c66241a 100644
--- a/accel/tcg/translate-all.c
+++ b/accel/tcg/translate-all.c
@@ -473,6 +473,13 @@ TranslationBlock *tb_gen_code(CPUState *cpu, TCGTBCPUState s)
                         !strcmp(prop, "1");
     }
     tcg_ctx->boxdroid_fp_local_requested = fp_local_mode;
+    static int x87_bits_mode = -1;
+    if (x87_bits_mode < 0) {
+        char prop[PROP_VALUE_MAX] = { 0 };
+        x87_bits_mode = __system_property_get("debug.boxdroid.x87_bits", prop) &&
+                        !strcmp(prop, "1");
+    }
+    tcg_ctx->boxdroid_x87_bits_requested = x87_bits_mode;
     static int fp_preserve_mode = -1;
     if (fp_preserve_mode < 0) {
         char prop[PROP_VALUE_MAX] = {0};
diff --git a/include/tcg/tcg.h b/include/tcg/tcg.h
