diff --git a/target/i386/tcg/translate.c b/target/i386/tcg/translate.c
index 6ace1c523d..3c542ecfc9 100644
--- a/target/i386/tcg/translate.c
+++ b/target/i386/tcg/translate.c
@@ -1845,6 +1845,25 @@ static void gen_fmov_STN_ST0(DisasContext *s, int st_index)
 
 static void gen_fxchg_ST0_STN(DisasContext *s, int st_index)
 {
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__) && !defined(BOXDROID_X87_PROFILE)
+    if (!g_use_hard_fpu && tcg_ctx->boxdroid_x87_bits_requested) {
+        TCGv_ptr st0 = gen_stn_ptr(0);
+        TCGv_ptr stn = gen_stn_ptr(st_index);
+        TCGv_i128 a = tcg_temp_new_i128();
+        TCGv_i128 b = tcg_temp_new_i128();
+
+        QEMU_BUILD_BUG_ON(sizeof(floatx80) != 16);
+        QEMU_BUILD_BUG_ON(sizeof(FPReg) != 16);
+        /* Preserve the full stored representation, including padding. Both
+         * sources must be read before either destination changes (ST0 alias).
+         */
+        tcg_gen_ld_i128(a, st0, 0);
+        tcg_gen_ld_i128(b, stn, 0);
+        tcg_gen_st_i128(a, stn, 0);
+        tcg_gen_st_i128(b, st0, 0);
+        return;
+    }
+#endif
     GEN_HELPER_FALLBACK_v_i(fxchg_ST0_STN, st_index);
 
     /* Ensure ST0, STN are loaded */
@@ -1976,12 +1995,34 @@ static void gen_fistll_ST0(DisasContext *s, TCGv_i64 arg)
 
 static void gen_fchs_ST0(DisasContext *s)
 {
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__) && !defined(BOXDROID_X87_PROFILE)
+    if (!g_use_hard_fpu && tcg_ctx->boxdroid_x87_bits_requested) {
+        TCGv_ptr st0 = gen_stn_ptr(0);
+        TCGv_i32 high = tcg_temp_new_i32();
+
+        tcg_gen_ld16u_i32(high, st0, offsetof(floatx80, high));
+        tcg_gen_xori_i32(high, high, 0x8000);
+        tcg_gen_st16_i32(high, st0, offsetof(floatx80, high));
+        return;
+    }
+#endif
     GEN_HELPER_FALLBACK_v_v(fchs_ST0);
     fp_pc_wrapper(gen_fchs_ST0)(s);
 }
 
 static void gen_fabs_ST0(DisasContext *s)
 {
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__) && !defined(BOXDROID_X87_PROFILE)
+    if (!g_use_hard_fpu && tcg_ctx->boxdroid_x87_bits_requested) {
+        TCGv_ptr st0 = gen_stn_ptr(0);
+        TCGv_i32 high = tcg_temp_new_i32();
+
+        tcg_gen_ld16u_i32(high, st0, offsetof(floatx80, high));
+        tcg_gen_andi_i32(high, high, 0x7fff);
+        tcg_gen_st16_i32(high, st0, offsetof(floatx80, high));
+        return;
+    }
+#endif
     GEN_HELPER_FALLBACK_v_v(fabs_ST0);
     fp_pc_wrapper(gen_fabs_ST0)(s);
 }
