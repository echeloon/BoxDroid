diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index c42207e728..c55f7deb66 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -513,6 +513,51 @@ const void *HELPER(lookup_tb_ptr)(CPUArchState *env)
     return tb->tc.ptr;
 }
 
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+uint64_t boxdroid_tlb_ir_retries;
+G_NORETURN void boxdroid_tlb_ir_retry(uintptr_t retaddr);
+G_NORETURN void boxdroid_tlb_ir_retry(uintptr_t retaddr)
+{
+    CPUState *cpu = current_cpu;
+    ++boxdroid_tlb_ir_retries;
+    /* No guest access has happened in this instruction. Prior instructions
+     * have canonical state. Restore this instruction's PC/lazy flags and
+     * execute it once with the existing memory lowering. */
+    cpu->cflags_next_tb = curr_cflags(cpu) | CF_BOX_TLB_GENERIC;
+    bool restored = cpu_restore_state(cpu, retaddr);
+    g_assert(restored);
+    cpu_loop_exit_noexc(cpu);
+}
+#endif
+
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+uint64_t boxdroid_tlb_ir_link_hits;
+const void *boxdroid_tlb_ir_link(uintptr_t retaddr);
+const void *boxdroid_tlb_ir_link(uintptr_t retaddr)
+{
+    CPUState *cpu = current_cpu;
+    ++boxdroid_tlb_ir_retries;
+    bool restored = cpu_restore_state(cpu, retaddr);
+    g_assert(restored);
+    cpu->neg.can_do_io = true;
+    TCGTBCPUState state = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+    state.cflags = curr_cflags(cpu) | CF_BOX_TLB_GENERIC;
+    if (check_for_breakpoints(cpu, state.pc, &state.cflags)) {
+        cpu_loop_exit(cpu);
+    }
+    mmap_lock();
+    TranslationBlock *tb = tb_lookup(cpu, state);
+    mmap_unlock();
+    if (!tb) {
+        /* Translation/code-cache allocation must happen outside a live JIT. */
+        cpu->cflags_next_tb = state.cflags;
+        cpu_loop_exit_noexc(cpu);
+    }
+    ++boxdroid_tlb_ir_link_hits;
+    return tb->tc.ptr;
+}
+#endif
