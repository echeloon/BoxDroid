+static bool boxdroid_guest_mem(TCGOpcode op)
+{
+    return op == INDEX_op_qemu_ld || op == INDEX_op_qemu_st ||
+           op == INDEX_op_qemu_ld2 || op == INDEX_op_qemu_st2;
