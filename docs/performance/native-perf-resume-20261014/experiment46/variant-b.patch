+
+static void boxdroid_tlb_group(TCGContext *s, TCGOp **ops, unsigned count,
+                               unsigned mmu)
+{
+    if (count < 2) {
+        return;
+    }
+    TCGv_i64 mask = tcg_temp_new_i64(), table = tcg_temp_new_i64();
+    TCGOp *desc = tcg_op_insert_before(s, ops[0], INDEX_op_box_tlb_desc,
+                                      TCG_TYPE_I64, 4);
+    desc->args[0] = tcgv_i64_arg(mask);
+    desc->args[1] = tcgv_i64_arg(table);
+    desc->args[2] = temp_arg(&s->temps[0]);
+    /* ENV is the fixed register global, not necessarily temp zero. */
+    for (unsigned i = 0; i < s->nb_globals; i++) {
+        if (s->temps[i].kind == TEMP_FIXED && s->temps[i].reg == TCG_AREG0) {
+            desc->args[2] = temp_arg(&s->temps[i]);
+            break;
+        }
+    }
+    desc->args[3] = tlb_mask_table_ofs(s, mmu);
+    for (unsigned i = 0; i < count; i++) {
+        TCGOp *old = ops[i];
+        TCGOp *op = tcg_op_insert_before(s, old,
+            old->opc == INDEX_op_qemu_ld ? INDEX_op_box_tlb_ld : INDEX_op_box_tlb_st,
+            TCGOP_TYPE(old), 5);
+        op->args[0] = old->args[0];
+        op->args[1] = old->args[1];
+        op->args[2] = tcgv_i64_arg(mask);
+        op->args[3] = tcgv_i64_arg(table);
+        op->args[4] = old->args[2];
+        tcg_op_remove(s, old);
+    }
+    boxdroid_tlb_ir_selected += count;
+    boxdroid_tlb_ir_groups++;
+}
+
+static void boxdroid_lower_tlb_ir(TCGContext *s)
+{
+    if (!s->boxdroid_tlb_ir || s->addr_type != TCG_TYPE_I32 ||
+        !tcg_use_softmmu || s->guest_mo != (TCG_MO_ALL & ~TCG_MO_ST_LD) ||
+        (tb_cflags(s->gen_tb) & (CF_BOX_TLB_GENERIC | CF_PARALLEL |
+          CF_USE_ICOUNT | CF_NO_GOTO_PTR | CF_SINGLE_STEP | CF_PCREL))) {
+        return;
+    }
+#ifdef CONFIG_PLUGIN
+    return;
+#endif
+    unsigned capacity = s->nb_ops;
+    TCGOp **eligible = tcg_malloc(sizeof(*eligible) * capacity);
+    unsigned ne = 0;
+    TCGOp *op = QTAILQ_FIRST(&s->ops);
+    /* A retry is allowed only before the sole guest access of an instruction,
+     * with no preceding helper, host store, branch, or global output. Thus
+     * neither guest-visible effects nor partial instruction work are replayed.
+     * Complex/multi-access instructions remain entirely on the original path. */
+    while (op) {
+        if (op->opc != INDEX_op_insn_start) {
+            op = QTAILQ_NEXT(op, link);
+            continue;
+        }
+        TCGOp *end = QTAILQ_NEXT(op, link), *mem = NULL;
+        bool clean = true, safe = false;
+        unsigned accesses = 0;
+        for (; end && end->opc != INDEX_op_insn_start;
+             end = QTAILQ_NEXT(end, link)) {
+            const TCGOpDef *def = &tcg_op_defs[end->opc];
+            if (boxdroid_guest_mem(end->opc)) {
+                accesses++;
+                if (end->opc == INDEX_op_qemu_ld || end->opc == INDEX_op_qemu_st) {
+                    mem = end;
+                    safe = clean && TCGOP_TYPE(end) <= TCG_TYPE_I64 &&
+                        (get_memop(end->args[2]) & MO_SIZE) <= MO_64;
+                }
+            }
+            if (boxdroid_tlb_boundary(end)) {
+                clean = false;
+            }
+            for (unsigned i = 0; i < def->nb_oargs; i++) {
+                if (arg_temp(end->args[i])->kind == TEMP_GLOBAL) {
+                    clean = false;
+                }
+            }
+        }
+        if (accesses == 1 && mem && safe) {
+            eligible[ne++] = mem;
+        }
+        op = end;
+    }
+    TCGOp **group = tcg_malloc(sizeof(*group) * ne);
+    unsigned count = 0, mmu = 0, next = 0;
+    /* Capture all groups before modifying their IR nodes. */
+    TCGOp **all = tcg_malloc(sizeof(*all) * capacity);
+    unsigned nall = 0;
+    QTAILQ_FOREACH(op, &s->ops, link) { all[nall++] = op; }
+    for (unsigned i = 0; i < nall; i++) {
+        op = all[i];
+        if (next < ne && eligible[next] == op) {
+            unsigned index = get_mmuidx(op->args[2]);
+            if (count && mmu != index) {
+                boxdroid_tlb_group(s, group, count, mmu);
+                count = 0;
+            }
+            mmu = index;
+            group[count++] = op;
+            next++;
+        } else if (boxdroid_guest_mem(op->opc) || boxdroid_tlb_boundary(op)) {
+            boxdroid_tlb_group(s, group, count, mmu);
+            count = 0;
+        }
+    }
+    boxdroid_tlb_group(s, group, count, mmu);
+}
+#endif
