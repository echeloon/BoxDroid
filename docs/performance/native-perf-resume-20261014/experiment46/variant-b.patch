+
+static bool boxdroid_tlb_boundary(const TCGOp *op)
+{
+    return op->opc == INDEX_op_call || op->opc == INDEX_op_st ||
+        op->opc == INDEX_op_st8 || op->opc == INDEX_op_st16 ||
+        op->opc == INDEX_op_st32 || op->opc == INDEX_op_st_vec ||
+        (tcg_op_defs[op->opc].flags & TCG_OPF_BB_END);
