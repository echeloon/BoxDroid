# Experiment42 isolated: opt-in acquire sequence load for TCG QHT lookups; original writer and final retry barriers remain. Default qht_acquire0, validation pending.

diff --git a/accel/tcg/tb-maint.c b/accel/tcg/tb-maint.c
index bc36221537..110785ed12 100644
--- a/accel/tcg/tb-maint.c
+++ b/accel/tcg/tb-maint.c
@@ -31,6 +31,9 @@
 #include "tb-jmp-cache.h"
 #include "system/tcg.h"
 #include "tcg/tcg.h"
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+#include <sys/system_properties.h>
+#endif
 #include "tb-hash.h"
 #include "tb-context.h"
 #include "tb-internal.h"
@@ -75,6 +78,14 @@ void tb_htable_init(void)
 {
     unsigned int mode = QHT_MODE_AUTO_RESIZE;
 
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+    char prop[PROP_VALUE_MAX] = { 0 };
+    if (__system_property_get("debug.boxdroid.qht_acquire", prop) &&
+        !strcmp(prop, "1")) {
+        mode |= QHT_MODE_LOAD_ACQUIRE;
+    }
+#endif
+
     qht_init(&tb_ctx.htable, tb_cmp, CODE_GEN_HTABLE_SIZE, mode);
     qht_init(&tb_ctx.inv_htable, inv_tb_cmp, CODE_GEN_HTABLE_SIZE, mode);
 }
diff --git a/include/qemu/qht.h b/include/qemu/qht.h
