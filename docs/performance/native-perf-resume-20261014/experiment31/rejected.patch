# Experiment31 scoped caller-register-clearing exemption for internal AArch64 Xbox TCG helpers. noinline and ABI clobbers retained; correctness and device performance acceptance pending.

diff --git a/include/exec/helper-proto.h.inc b/include/exec/helper-proto.h.inc
index f8e57e43ce..5f031efb22 100644
--- a/include/exec/helper-proto.h.inc
+++ b/include/exec/helper-proto.h.inc
@@ -18,7 +18,15 @@
  *
  * See https://gitlab.com/qemu-project/qemu/-/issues/1454
  */
-#define DEF_HELPER_ATTR  __attribute__((noinline))
+/* Internal generated-code helpers return through an ABI that already permits
+ * caller-register clobbering. Scope the compiler-hardening exemption to this
+ * fixed AArch64 Xbox build; ordinary host functions retain build hardening. */
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__) && defined(__clang__)
+#define BOXDROID_HELPER_RETURN_ATTR __attribute__((zero_call_used_regs("skip")))
+#else
+#define BOXDROID_HELPER_RETURN_ATTR
+#endif
+#define DEF_HELPER_ATTR __attribute__((noinline)) BOXDROID_HELPER_RETURN_ATTR
 
 #define DEF_HELPER_FLAGS_0(name, flags, ret) \
 dh_ctype(ret) HELPER(name) (void) DEF_HELPER_ATTR;
@@ -66,3 +74,4 @@ dh_ctype(ret) HELPER(name) (dh_ctype(t1), dh_ctype(t2), dh_ctype(t3), \
 #undef DEF_HELPER_FLAGS_6
 #undef DEF_HELPER_FLAGS_7
 #undef DEF_HELPER_ATTR
+#undef BOXDROID_HELPER_RETURN_ATTR
diff --git a/target/i386/helper.h b/target/i386/helper.h
index 661bea82d9..f7febc96ff 100644
--- a/target/i386/helper.h
+++ b/target/i386/helper.h
@@ -252,7 +252,7 @@ BOXDROID_FP_HELPER(fdivr)
 #define BOXDROID_FP_ABI_FLAGS TCG_CALL_PRESERVE_MOST
 #ifdef IN_HELPER_PROTO
 #undef DEF_HELPER_ATTR
-#define DEF_HELPER_ATTR __attribute__((noinline, preserve_most))
+#define DEF_HELPER_ATTR __attribute__((noinline, preserve_most)) BOXDROID_HELPER_RETURN_ATTR
 #endif
 #else
 #define BOXDROID_FP_ABI_FLAGS 0
@@ -263,7 +263,7 @@ DEF_HELPER_FLAGS_2(boxdroid_f32_store, TCG_CALL_NO_RWG | TCG_CALL_NO_GUEST_MEMOR
 #undef BOXDROID_FP_ABI_FLAGS
 #if defined(IN_HELPER_PROTO) && defined(__clang__)
 #undef DEF_HELPER_ATTR
-#define DEF_HELPER_ATTR __attribute__((noinline))
+#define DEF_HELPER_ATTR __attribute__((noinline)) BOXDROID_HELPER_RETURN_ATTR
 #endif
 #endif
 
diff --git a/target/i386/tcg/fpu_helper.c b/target/i386/tcg/fpu_helper.c
index 0274370bbf..a28204d543 100644
--- a/target/i386/tcg/fpu_helper.c
+++ b/target/i386/tcg/fpu_helper.c
@@ -586,7 +586,7 @@ void helper_flds_FT0(CPUX86State *env, uint32_t val)
  * The original conversion and exception-status protocol are preserved.
  */
 #ifdef __clang__
-#define BOXDROID_FP_PRESERVE_ATTR __attribute__((preserve_most))
+#define BOXDROID_FP_PRESERVE_ATTR __attribute__((preserve_most, zero_call_used_regs("skip")))
 #else
 #define BOXDROID_FP_PRESERVE_ATTR
 #endif
