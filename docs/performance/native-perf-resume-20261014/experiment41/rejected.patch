+static void boxdroid_prepare_lookup_key(TCGContext *s, TCGReg cpu,
+                                        TCGReg pc, TCGReg entry,
+                                        TCGReg tmp, TCGReg work)
+{
+    /* Identical system-mode tb_jmp_cache_hash_func, for x86's 4KiB pages.
+     * Mask/cache geometry is unchanged from the supported BoxDroid baseline. */
+    QEMU_BUILD_BUG_ON(TB_JMP_CACHE_BITS != 14);
+    QEMU_BUILD_BUG_ON(sizeof(((CPUJumpCache *)0)->array[0]) != 16);
+    QEMU_BUILD_BUG_ON(offsetof(CPUJumpCache, array[0].pc) -
+                      offsetof(CPUJumpCache, array[0].tb) != 8);
+    tcg_out_ubfm(s, TCG_TYPE_I32, tmp, pc, 5, 31);
+    tcg_out_insn(s, 3510, EOR, TCG_TYPE_I32, tmp, tmp, pc);
+    tcg_out_ubfm(s, TCG_TYPE_I32, work, tmp, 5, 31);
+    tcg_out_logicali(s, I3404_ANDI, TCG_TYPE_I32, work, work, 0x3f80);
+    tcg_out_logicali(s, I3404_ANDI, TCG_TYPE_I32, tmp, tmp, 0x7f);
+    tcg_out_insn(s, 3510, ORR, TCG_TYPE_I32, tmp, tmp, work);
+    tcg_out_ld(s, TCG_TYPE_PTR, entry, cpu, offsetof(CPUState, tb_jmp_cache));
+    if (boxdroid_jmp_epoch) {
+        /* Hashing used the original 32-bit PC. Add the current generation to
+         * its comparison key before either slot's TB pointer is dereferenced. */
+        tcg_out_ld(s, TCG_TYPE_I32, work, entry,
+                   offsetof(CPUJumpCache, generation));
+        tcg_out_insn(s, 3502S, ADD_LSL, TCG_TYPE_I64, pc, pc, work, 32);
+    }
+    tcg_out_insn(s, 3502S, ADD_LSL, TCG_TYPE_PTR, entry, entry, tmp, 4);
+    tcg_out_insn(s, 3401, ADDI, TCG_TYPE_PTR, entry, entry,
+                 offsetof(CPUJumpCache, array));
+
+}
