# Experiment43b: guarded TOP plus explicit CPU-private operand interfaces for six exact x87 helpers, preserving constant dataflow. Original numerical algorithms/status handling and generic fallback retained; fp_top0 default. Unvalidated b variant.

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index c42207e728..d49311d770 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -513,6 +513,47 @@ const void *HELPER(lookup_tb_ptr)(CPUArchState *env)
     return tb->tc.ptr;
 }
 
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+uint64_t boxdroid_fp_top_fallbacks;
+
+const void *HELPER(boxdroid_fp_generic)(CPUArchState *env, uint32_t cflags)
+{
+    CPUState *cpu = env_cpu(env);
+    TranslationBlock *tb;
+    TCGTBCPUState state = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+
+    /* The entry guard has committed no guest work. Its cold exit supplies
+     * the original guest PC and canonical state, including the actual TOP.
+     * Preserve the requested instruction count and debug/IRQ controls.
+     */
+    state.cflags = (cflags & ~CF_BOX_FP_TOP) | CF_BOX_FP_GENERIC;
+    cpu->neg.can_do_io = true;
+    ++boxdroid_fp_top_fallbacks;
+    if (check_for_breakpoints(cpu, state.pc, &state.cflags)) {
+        cpu_loop_exit(cpu);
+    }
+    mmap_lock();
+    tb = tb_lookup(cpu, state);
+    if (!tb) {
+        /* Never generate code from a live JIT frame: serial allocation may
+         * flush and reuse that very frame's code. Leave to the dispatcher
+         * with exact initial state and request the generic key there.
+         */
+        mmap_unlock();
+        cpu->cflags_next_tb = state.cflags;
+        cpu_loop_exit_noexc(cpu);
+    }
+    mmap_unlock();
+    if (qemu_loglevel_mask(CPU_LOG_TB_CPU | CPU_LOG_EXEC)) {
+        log_cpu_exec(state.pc, cpu, tb);
+    }
+    if (unlikely(boxdroid_order_audit_active)) {
+        boxdroid_order_audit(tb, true);
+    }
+    return tb->tc.ptr;
+}
+#endif
+
