+
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+/* Explicit CPU-private operands avoid reading the fpstt TCG global. These
+ * retain the original numerical algorithms and status/exception handling.
+ */
+void helper_boxdroid_fxchg_top(void *left, void *right)
+{
+    floatx80 *a = left, *b = right;
+    floatx80 value = *b;
+    *b = *a;
+    *a = value;
+}
+
+void helper_boxdroid_fchs_top(void *pointer)
+{
+    floatx80 *value = pointer;
+    *value = floatx80_chs(*value);
+}
+
+void helper_boxdroid_fabs_top(void *pointer)
+{
+    floatx80 *value = pointer;
+    *value = floatx80_abs(*value);
+}
+
+void helper_boxdroid_fsqrt_top(CPUX86State *env, void *pointer)
+{
+    floatx80 *value = pointer;
+    int old_flags = save_arithmetic_exception_flags(env);
+    if (floatx80_is_neg((*value))) {
+        env->fpus &= ~0x4700;  /* (C3,C2,C1,C0) <-- 0000 */
+        env->fpus |= 0x400;
+    }
+    (*value) = floatx80_sqrt((*value), &env->fp_status);
+    merge_exception_flags(env, old_flags);
+}
+
+void helper_boxdroid_fsin_top(CPUX86State *env, void *pointer)
+{
+    floatx80 *value = pointer;
+    double fptemp = floatx80_to_double(env, (*value));
+
+    if ((fptemp > MAXTAN) || (fptemp < -MAXTAN)) {
+        env->fpus |= 0x400;
+    } else {
+        (*value) = double_to_floatx80(env, sin(fptemp));
+        env->fpus &= ~0x400;  /* C2 <-- 0 */
+        /* the above code is for |arg| < 2**53 only */
+    }
+}
+
+void helper_boxdroid_fcos_top(CPUX86State *env, void *pointer)
+{
+    floatx80 *value = pointer;
+    double fptemp = floatx80_to_double(env, (*value));
+
+    if ((fptemp > MAXTAN) || (fptemp < -MAXTAN)) {
+        env->fpus |= 0x400;
+    } else {
+        (*value) = double_to_floatx80(env, cos(fptemp));
+        env->fpus &= ~0x400;  /* C2 <-- 0 */
+        /* the above code is for |arg| < 2**63 only */
+    }
+}
+#endif
