+/* Exactly the old fast/victim lifetime, including adaptive resize. Clearing
+ * existing entries avoids a full 16MiB shadow memset on every TLB flush. */
+static void boxdroid_flat_clear(CPUTLBDesc *d, CPUTLBDescFast *f,
+                                bool writes_only)
+{
+    if (f->boxdroid_flat_read) {
+        for (unsigned i = 0; i < tlb_n_entries(f); i++) {
+            boxdroid_flat_invalidate(f, &f->table[i], writes_only);
+        }
+        for (unsigned i = 0; i < CPU_VTLB_SIZE; i++) {
+            boxdroid_flat_invalidate(f, &d->vtable[i], writes_only);
+        }
+    }
