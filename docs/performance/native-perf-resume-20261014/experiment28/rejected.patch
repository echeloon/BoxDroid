+static void boxdroid_flat_publish(CPUTLBDescFast *f, const CPUTLBEntry *e,
+                                  const CPUTLBEntryFull *full, vaddr page)
+{
+    if (!f->boxdroid_flat_read || page > UINT32_MAX) {
+        return;
+    }
+    size_t index = page >> 12;
+    uintptr_t read = BOXDROID_FLAT_INVALID, write = BOXDROID_FLAT_INVALID;
+    if (!(e->addend & 4095)) {
+        if (e->addr_read == page && !full->slow_flags[MMU_DATA_LOAD]) {
+            read = e->addend;
+        }
+        if (e->addr_write == page && !full->slow_flags[MMU_DATA_STORE]) {
+            write = e->addend;
+        }
+    }
+    qatomic_set(&f->boxdroid_flat_read[index], read);
+    qatomic_set(&f->boxdroid_flat_write[index], write);
+}
