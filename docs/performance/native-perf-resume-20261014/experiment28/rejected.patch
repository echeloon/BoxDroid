+static void boxdroid_flat_invalidate(CPUTLBDescFast *f, const CPUTLBEntry *e,
+                                     bool writes_only)
+{
+    if (!f->boxdroid_flat_read) {
+        return;
+    }
+    uintptr_t pages[] = {e->addr_read & TARGET_PAGE_MASK,
+                         e->addr_write & TARGET_PAGE_MASK};
+    for (unsigned i = 0; i < ARRAY_SIZE(pages); i++) {
+        if (pages[i] <= UINT32_MAX) {
+            size_t index = pages[i] >> 12;
+            if (!writes_only) {
+                qatomic_set(&f->boxdroid_flat_read[index], BOXDROID_FLAT_INVALID);
+            }
+            qatomic_set(&f->boxdroid_flat_write[index], BOXDROID_FLAT_INVALID);
+        }
+    }
