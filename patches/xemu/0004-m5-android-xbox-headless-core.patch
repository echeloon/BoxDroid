--- a/hw/xbox/nv2a/pgraph/vk/buffer.c
+++ b/hw/xbox/nv2a/pgraph/vk/buffer.c
@@ -62,0 +63,10 @@ void pgraph_vk_init_buffers(NV2AState *d)
+#ifdef __ANDROID__
+    /* Xbox NV2A uses 64 MiB of unified RAM/VRAM. The desktop renderer's
+     * 10,240-square staging capacity reserves 1.56 GiB across these two
+     * buffers before any guest work. Keep Android scratch within the entire
+     * guest VRAM budget; larger guest surfaces cannot contain useful data. */
+    const size_t compute_buffer_size = 64 * MiB;
+#else
+    const size_t compute_buffer_size = (1024 * 10) * (1024 * 10) * 8;
+#endif
+
@@ -79 +89 @@ void pgraph_vk_init_buffers(NV2AState *d)
-        .buffer_size = (1024 * 10) * (1024 * 10) * 8,
+        .buffer_size = compute_buffer_size,
