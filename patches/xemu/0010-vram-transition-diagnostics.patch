diff --git a/hw/xbox/nv2a/nv2a.c b/hw/xbox/nv2a/nv2a.c
index 1565c05211..e3cd086f6d 100644
--- a/hw/xbox/nv2a/nv2a.c
+++ b/hw/xbox/nv2a/nv2a.c
@@ -23,0 +24,23 @@
+#ifdef BOXDROID_XBOX_RUNTIME
+#include "hw/xbox/nv2a/boxdroid-diagnostics.h"
+#include "hw/core/cpu.h"
+static MemAccessCallback *boxdroid_vram_access;
+
+static void boxdroid_vram_access_callback(void *opaque, MemoryRegion *mr,
+                                             hwaddr addr, hwaddr len,
+                                             bool write)
+{
+    (void)opaque;
+    /* physmem.c passes the callback offset relative to this MemoryRegion. */
+    if (write) {
+        CPUState *cpu = current_cpu;
+        uint64_t guest_pc = cpu && cpu->cc && cpu->cc->get_pc ?
+            cpu->cc->get_pc(cpu) : 0;
+        boxdroid_diag_vram_write(cpu ? "guest-cpu-context" :
+                                    "device-memory-transaction",
+                                    addr, len, 0, guest_pc);
+    } else {
+        boxdroid_diag_vram_read("guest-memory-read", addr, len);
+    }
+}
+#endif
@@ -237,0 +261,14 @@ static void nv2a_init_memory(NV2AState *d, MemoryRegion *ram)
+#ifdef BOXDROID_XBOX_RUNTIME
+    if (qemu_get_cpu(0) && memory_region_size(d->vram) > UINT64_C(0x3e00000)) {
+        hwaddr ram_base = memory_region_get_ram_addr(d->vram);
+        boxdroid_vram_access = mem_access_callback_insert(
+            qemu_get_cpu(0), d->vram, UINT64_C(0x3c00000),
+            UINT64_C(0x200000), boxdroid_vram_access_callback, d);
+        boxdroid_diag_record("VRAM_CPU_WATCH_REGISTERED",
+            UINT64_C(0x3c00000), UINT64_C(0x3e00000), 0, 0, 0, 0);
+        boxdroid_diag_record("VRAM_MEMORY_REGION_BASE", ram_base,
+            memory_region_size(d->vram), UINT64_C(0x3c00000),
+            UINT64_C(0x3c00000) + UINT64_C(0x12c000), 0, 0);
+    }
+#endif
+
@@ -373,0 +411,8 @@ static void nv2a_exitfn(PCIDevice *dev)
+#ifdef BOXDROID_XBOX_RUNTIME
+    if (boxdroid_vram_access) {
+        mem_access_callback_remove_by_ref(qemu_get_cpu(0),
+                                          boxdroid_vram_access);
+        boxdroid_vram_access = NULL;
+    }
+#endif
+
