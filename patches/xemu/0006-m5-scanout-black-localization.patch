@@ -474,0 +491,9 @@ static void download_surface_to_buffer(NV2AState *d, SurfaceBinding *surface,
+#ifdef BOXDROID_M5_XBOX_RUNTIME
+    if (diag_scanout) {
+        size_t vram_bytes = MIN((size_t) surface->pitch * surface->height,
