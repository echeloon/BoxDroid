+    bool draw_dirty = qatomic_read(&surface->draw_dirty);
+
+    if (draw_dirty) {
+#ifdef BOXDROID_M5_XBOX_RUNTIME
+        if (diag_scanout) {
+            boxdroid_m5_diag_event(BOXDROID_M5_DIAG_DOWNLOAD_DIRTY,
