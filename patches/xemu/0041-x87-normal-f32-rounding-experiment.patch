# Experiment30b exact normal binary32 rounded narrowing, cold-body outline to preserve existing cheap exact-path shape. f32_round1 opt-in default0. Validation/performance pending.

diff --git a/target/i386/tcg/fpu_helper.c b/target/i386/tcg/fpu_helper.c
index c9e4cf0175..0274370bbf 100644
--- a/target/i386/tcg/fpu_helper.c
+++ b/target/i386/tcg/fpu_helper.c
@@ -433,8 +433,21 @@ static void fpu_set_exception(CPUX86State *env, int mask)
     }
 }
 
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+#include <sys/system_properties.h>
+bool boxdroid_f32_round_requested;
+uint64_t boxdroid_f32_round_fast_hits;
+extern bool boxdroid_inline_lookup_observe;
+#endif
+
 void cpu_init_fp_statuses(CPUX86State *env)
 {
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+    char round_prop[PROP_VALUE_MAX] = {0};
+    boxdroid_f32_round_requested =
+        __system_property_get("debug.boxdroid.f32_round", round_prop) &&
+        !strcmp(round_prop, "1");
+#endif
     /*
      * Initialise the non-runtime-varying fields of the various
      * float_status words to x86 behaviour. This must be called at
@@ -596,6 +609,57 @@ uint32_t boxdroid_f32_store_slow(CPUX86State *env, void *source_ptr)
     return value;
 }
 
+static __attribute__((noinline)) BOXDROID_FP_PRESERVE_ATTR
+uint32_t boxdroid_f32_round_normal(CPUX86State *env, void *source_ptr,
+                                   uint64_t low, unsigned high)
+{
+    floatx80 operand = {.low = low, .high = high};
+    unsigned exponent = high & 0x7fff;
+    uint64_t discarded = operand.low & ((UINT64_C(1) << 40) - 1);
+    unsigned significand = operand.low >> 40;
+    unsigned binary32_exp = exponent - 16256;
+    bool negative = operand.high >> 15;
+    bool increment;
+    switch (get_float_rounding_mode(&env->fp_status)) {
+    case float_round_nearest_even:
+        increment = discarded > (UINT64_C(1) << 39) ||
+                    (discarded == (UINT64_C(1) << 39) && (significand & 1));
+        break;
+    case float_round_down:
+        increment = negative && discarded;
+        break;
+    case float_round_up:
+        increment = !negative && discarded;
+        break;
+    case float_round_to_zero:
+        increment = false;
+        break;
+    default:
+        return boxdroid_f32_store_slow(env, source_ptr);
+    }
+    significand += increment;
+    if (significand == (1u << 24)) {
+        /* Let the original converter handle overflow and its status. */
+        if (binary32_exp == 254) {
+            return boxdroid_f32_store_slow(env, source_ptr);
+        }
+        significand >>= 1;
+        binary32_exp++;
+    }
+    /* Both operands and result are normal. The only new exception is
+     * precision; merge only that exception into the prior sticky state,
+     * exactly as save/clear/convert/merge would do. */
+    if (discarded) {
+        float_raise(float_flag_inexact, &env->fp_status);
+    }
+    fpu_set_exception(env, discarded ? FPUS_PE : 0);
+    if (boxdroid_inline_lookup_observe) {
+        boxdroid_f32_round_fast_hits++;
+    }
+    return ((uint32_t)negative << 31) | (binary32_exp << 23) |
+           (significand & 0x7fffff);
+}
+
 void helper_boxdroid_f32_load(CPUX86State *env, void *dest_ptr, uint32_t val)
 {
     unsigned exponent = (val >> 23) & 0xff;
@@ -636,6 +700,10 @@ uint32_t helper_boxdroid_f32_store(CPUX86State *env, void *source_ptr)
         fpu_set_exception(env, 0);
         return value;
     }
+    if (boxdroid_f32_round_requested && exponent > 16256 &&
+        exponent < 16511 && (operand.low >> 63)) {
+        return boxdroid_f32_round_normal(env, source_ptr, operand.low, operand.high);
+    }
     return boxdroid_f32_store_slow(env, source_ptr);
 }
 #undef BOXDROID_FP_PRESERVE_ATTR
