@@ -259,3 +259,6 @@ static void se_frame(MCPXAPUState *d)
+#ifdef BOXDROID_RUNTIME
+extern uint32_t boxdroid_voice_lock_waiters;
+#endif
 static void *mcpx_apu_frame_thread(void *arg)
 {
     MCPXAPUState *d = MCPX_APU_DEVICE(arg);
@@ -300,5 +303,16 @@ static void *mcpx_apu_frame_thread(void *arg)
         throttle(d);
         se_frame(d);
+#ifdef BOXDROID_RUNTIME
+        /* Bionic's mutex lets this busy worker reacquire repeatedly while a
+         * guest VOICE_LOCK writer waits with the BQL. Yield the APU lock to
+         * queued writers between complete frames, preserving voice-work
+         * ordering and the existing emulated audio clock/throttle. The
+         * writer signals cond after updating the protected lock bitmap. */
+        while (qatomic_read(&boxdroid_voice_lock_waiters) &&
