diff --git a/ui/console.c b/ui/console.c
index 2d00828..478e37e 100644
--- a/ui/console.c
+++ b/ui/console.c
@@ -82,3 +82,7 @@ static bool console_compatible_with(QemuConsole *con,
+#ifdef BOXDROID_RUNTIME
+#include <android/log.h>
+extern uint64_t boxdroid_guest_refresh_period_ns(void);
+#endif
 static void gui_update(void *opaque)
 {
     uint64_t interval = GUI_REFRESH_INTERVAL_IDLE;
@@ -102,5 +106,29 @@ static void gui_update(void *opaque)
         trace_console_refresh(interval);
     }
     ds->last_update = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+#ifdef BOXDROID_RUNTIME
+    /* Absolute deadlines do not add scanout/presentation work to the guest
+     * period. Skip expired deadlines; never manufacture catch-up vblanks. */
+    static uint64_t deadline, previousPeriod, reports, skipped, callbacks;
+    uint64_t now=qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    uint64_t period=boxdroid_guest_refresh_period_ns();
+    if (!period) period=interval*SCALE_MS;
+    if (!deadline || previousPeriod!=period) deadline=now;
+    deadline+=period;
+    if (deadline<=now) {
+        uint64_t missed=(now-deadline)/period+1;
+        skipped+=missed; deadline+=missed*period;
+    }
+    previousPeriod=period; ++callbacks;
+    timer_mod_ns(ds->gui_timer,deadline);
+    if (now-reports>=NANOSECONDS_PER_SECOND) {
+        __android_log_print(ANDROID_LOG_INFO,"BoxDroid",
+            "REFRESH_DEADLINE now_ns=%llu next_ns=%llu period_ns=%llu callbacks=%llu missed=%llu",
+            (unsigned long long)now,(unsigned long long)deadline,(unsigned long long)period,
+            (unsigned long long)callbacks,(unsigned long long)skipped);
+        reports=now; callbacks=skipped=0;
+    }
+#else
     timer_mod(ds->gui_timer, ds->last_update + interval);
+#endif
 }
