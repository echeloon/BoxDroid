+#if defined(__SIZEOF_INT128__)
+/* Round a normalized 128-bit significand once, at the selected x87 precision.
+ * sticky represents discarded bits strictly below bit zero. */
+static inline bool boxdroid_f80_round128(__uint128_t n, bool sticky, int exp,
+                                        unsigned sign, float_status *s,
+                                        floatx80 *out)
+{
+    unsigned precision;
+    switch (s->floatx80_rounding_precision) {
+    case floatx80_precision_x: precision = 64; break;
+    case floatx80_precision_d: precision = 53; break;
+    case floatx80_precision_s: precision = 24; break;
+    default: return false;
+    }
+    if (exp <= 0 || exp >= 0x7fff) return false;
+    unsigned shift = 128 - precision, sigshift = 64 - precision;
+    __uint128_t rem = n & (((__uint128_t)1 << shift) - 1);
+    __uint128_t half = (__uint128_t)1 << (shift - 1);
+    uint64_t unit = UINT64_C(1) << sigshift;
+    uint64_t sig = (uint64_t)(n >> 64) & ~(unit - 1);
+    bool lost = rem || sticky, increment;
+    switch (s->float_rounding_mode) {
+    case float_round_nearest_even:
+        increment = rem > half || (rem == half && (sticky || (sig & unit)));
+        break;
+    case float_round_to_zero: increment = false; break;
+    case float_round_up: increment = lost && !sign; break;
+    case float_round_down: increment = lost && sign; break;
+    default: return false;
+    }
+    if (increment) {
+        uint64_t next = sig + unit;
+        if (next < sig) {
+            if (++exp >= 0x7fff) return false;
+            next = UINT64_C(1) << 63;
+        }
+        sig = next;
+    }
+    *out = (floatx80) { .high = (sign << 15) | exp, .low = sig };
+    float_raise(lost ? float_flag_inexact : 0, s);
+    BOXDROID_FP_HIT();
+    return true;
+}
+
+/* Normal finite arithmetic with full 64-bit operands. No host FP state and
+ * no FloatParts unpacking. Large exponent gaps/boundaries use SoftFloat. */
+static inline bool boxdroid_f80_wide_integer(floatx80 a, floatx80 b,
+                                            float_status *s,
+                                            enum BoxDroidFPOp op, floatx80 *out)
+{
+    if (!a.low || !b.low) return false;
+    int ea = (a.high & 0x7fff) - 16383, eb = (b.high & 0x7fff) - 16383;
+    int exp;
+    unsigned sa = a.high >> 15, sb = (b.high >> 15) ^ (op == BOXDROID_FP_SUB);
+    __uint128_t n;
+    bool sticky = false;
+    if (op == BOXDROID_FP_MUL) {
+        n = (__uint128_t)a.low * b.low;
+        bool high = n >> 127;
+        exp = ea + eb + high + 16383;
+        if (!high) n <<= 1;
+        sa ^= sb;
+    } else if (op == BOXDROID_FP_ADD || op == BOXDROID_FP_SUB) {
+        int scale = MAX(ea, eb), da = scale - ea, db = scale - eb;
+        if (da > 64 || db > 64) return false;
+        __uint128_t na = (__uint128_t)a.low << (64 - da);
+        __uint128_t nb = (__uint128_t)b.low << (64 - db);
+        exp = scale + 16383;
+        if (sa == sb) {
+            n = na + nb;
+            if (n < na) {
+                sticky = n & 1;
+                n = (n >> 1) | ((__uint128_t)1 << 127);
+                exp++;
+            }
+        } else {
+            if (na < nb) { n = nb - na; sa = sb; }
+            else n = na - nb;
+            if (!n) {
+                *out = (floatx80) { .high =
+                    s->float_rounding_mode == float_round_down ? 0x8000 : 0 };
+                BOXDROID_FP_HIT();
+                return true;
+            }
+        }
+        unsigned zeros = (n >> 64) ? __builtin_clzll((uint64_t)(n >> 64)) :
+                                    64 + __builtin_clzll((uint64_t)n);
+        n <<= zeros;
+        exp -= zeros;
+    } else return false;
+    return boxdroid_f80_round128(n, sticky, exp, sa, s, out);
+}
