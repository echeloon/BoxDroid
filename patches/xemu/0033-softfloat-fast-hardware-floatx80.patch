+static inline bool boxdroid_f32_widen(uint32_t a, float_status *s, floatx80 *out)
+{
+    unsigned exp = (a >> 23) & 0xff;
+    if (!boxdroid_use_fast_fpu(s) || exp == 0xff ||
+        (!exp && (a & 0x7fffffff))) { return false; }
+    *out = (floatx80) {
+        .high = ((a >> 31) << 15) | (exp ? exp + 16256 : 0),
+        .low = exp ? (UINT64_C(1) << 63) | ((uint64_t)(a & 0x7fffff) << 40) : 0,
+    };
+    BOXDROID_FP_HIT();
+    return true;
+}
+
+static inline bool boxdroid_f64_widen(uint64_t a, float_status *s, floatx80 *out)
+{
+    union { uint64_t u; double d; } v = { .u = a };
+    floatx80 r;
+    int flags = 0;
+    if (!boxdroid_use_fast_fpu(s) || !boxdroid_f64_scaled(v.d, 0, &r) ||
+        !boxdroid_f80_precision(&r, s, &flags)) { return false; }
+    *out = r;
+    float_raise(flags, s);
+    BOXDROID_FP_HIT();
+    return true;
+}
+
+static inline bool boxdroid_i64_widen(int64_t a, float_status *s, floatx80 *out)
+{
+    if (!boxdroid_use_fast_fpu(s)) { return false; }
+    floatx80 r = { 0 };
+    if (a) {
+        unsigned sign = a < 0;
+        uint64_t mag = sign ? -(uint64_t)a : (uint64_t)a;
+        unsigned shift = __builtin_clzll(mag);
+        r.high = (sign << 15) | (16383 + 63 - shift);
+        r.low = mag << shift;
+    }
+    int flags = 0;
+    if (!boxdroid_f80_precision(&r, s, &flags)) { return false; }
+    *out = r;
+    float_raise(flags, s);
+    BOXDROID_FP_HIT();
+    return true;
+}
+
+/* A normal destination can be rounded and packed exactly with integers.
+ * This also accepts true 64-bit significands and every Xbox rounding mode.
+ * Destination subnormals/overflow and special encodings use SoftFloat. */
+static inline bool boxdroid_f80_narrow(floatx80 a, float_status *s,
+                                      unsigned bits, uint64_t *out)
+{
+    if (!boxdroid_use_fast_fpu(s) || !boxdroid_f80_regular(a)) {
+        return false;
+    }
+    if (!a.low) {
+        *out = (uint64_t)(a.high >> 15) << (bits - 1);
+        BOXDROID_FP_HIT();
+        return true;
+    }
+    int bias = bits == 32 ? 127 : 1023;
+    int exp = (a.high & 0x7fff) - 16383;
+    if (exp < 1 - bias || exp > bias) {
+        return false;
+    }
+    float_status rounding = *s;
+    rounding.floatx80_rounding_precision = bits == 32 ?
+        floatx80_precision_s : floatx80_precision_d;
+    int flags = 0;
+    if (!boxdroid_f80_precision(&a, &rounding, &flags)) {
+        return false;
+    }
+    exp = (a.high & 0x7fff) - 16383;
+    if (exp > bias) {
+        return false;
+    }
+    unsigned frac_bits = bits == 32 ? 23 : 52;
+    *out = ((uint64_t)(a.high >> 15) << (bits - 1)) |
+           ((uint64_t)(exp + bias) << frac_bits) |
+           ((a.low >> (63 - frac_bits)) & ((UINT64_C(1) << frac_bits) - 1));
+    float_raise(flags, s);
+    BOXDROID_FP_HIT();
+    return true;
+}
+
+static inline bool boxdroid_f80_to_f64(floatx80 a, float_status *s, uint64_t *out)
+{
+    return boxdroid_f80_narrow(a, s, 64, out);
+}
+
+static inline bool boxdroid_f80_to_f32(floatx80 a, float_status *s, uint32_t *out)
+{
+    uint64_t result;
+    if (!boxdroid_f80_narrow(a, s, 32, &result)) {
+        return false;
+    }
+    *out = result;
+    return true;
+}
+
+/* Round a canonical finite magnitude to an unsigned integer without first
+ * reducing its significand to binary64. Commit no flags until range checks. */
+static inline bool boxdroid_f80_integer_magnitude(floatx80 a, FloatRoundMode mode,
+                                                 uint64_t *mag, bool *inexact)
+{
+    int e = (a.high & 0x7fff) - 16383;
+    if (!a.low) { *mag = 0; *inexact = false; return true; }
+    if (e > 63) return false;
+    uint64_t lost, half, floor;
+    if (e < 0) {
+        floor = 0;
+        lost = a.low;
+        half = e == -1 ? UINT64_C(1) << 63 : UINT64_MAX;
+    } else if (e == 63) {
+        *mag = a.low; *inexact = false; return true;
+    } else {
+        unsigned shift = 63 - e;
+        floor = a.low >> shift;
+        lost = a.low & ((UINT64_C(1) << shift) - 1);
+        half = UINT64_C(1) << (shift - 1);
+    }
+    bool increment;
+    switch (mode) {
+    case float_round_nearest_even:
+        increment = e < -1 ? false : lost > half ||
+                    (lost == half && (floor & 1));
+        break;
+    case float_round_to_zero: increment = false; break;
+    case float_round_up: increment = lost && !(a.high >> 15); break;
+    case float_round_down: increment = lost && (a.high >> 15); break;
+    default: return false;
+    }
+    *mag = floor + increment;
+    *inexact = lost != 0;
+    return true;
+}
+
+static inline bool boxdroid_f80_round_int(floatx80 a, float_status *s,
+                                         floatx80 *out)
+{
+    if (!boxdroid_use_fast_fpu(s) || !boxdroid_f80_regular(a)) return false;
+    unsigned precision;
+    switch (s->floatx80_rounding_precision) {
+    case floatx80_precision_s: precision = 24; break;
+    case floatx80_precision_d: precision = 53; break;
+    case floatx80_precision_x: precision = 64; break;
+    default: return false;
+    }
+    floatx80 result = a;
+    int flags = 0;
+    /* Round directly to the PC grid when its spacing is >= one integer.
+     * Integer rounding followed by PC rounding can otherwise double-round. */
+    if (a.low && (int)(a.high & 0x7fff) - 16383 >= (int)precision - 1) {
+        if (!boxdroid_f80_precision(&result, s, &flags)) return false;
+    } else {
+        uint64_t mag;
+        bool inexact;
+        if (!boxdroid_f80_integer_magnitude(a, s->float_rounding_mode,
+                                           &mag, &inexact)) return false;
+        result.high = a.high & 0x8000;
+        result.low = 0;
+        if (mag) {
+            unsigned shift = __builtin_clzll(mag);
+            result.high |= 16383 + 63 - shift;
+            result.low = mag << shift;
+        }
+        flags = inexact ? float_flag_inexact : 0;
+    }
+    *out = result;
+    float_raise(flags, s);
+    BOXDROID_FP_HIT();
+    return true;
+}
+
+static inline bool boxdroid_f80_to_int(floatx80 a, FloatRoundMode mode,
+                                      unsigned bits, float_status *s,
+                                      int64_t *out)
+{
+    uint64_t mag;
+    bool inexact;
+    if (!boxdroid_use_fast_fpu(s) || !boxdroid_f80_regular(a) ||
+        !boxdroid_f80_integer_magnitude(a, mode, &mag, &inexact)) return false;
+    bool negative = a.high >> 15;
+    uint64_t limit = UINT64_C(1) << (bits - 1);
+    if (mag > limit - !negative) return false;
+    if (negative) *out = mag == (UINT64_C(1) << 63) ? INT64_MIN : -(int64_t)mag;
+    else *out = mag;
+    if (inexact) float_raise(float_flag_inexact, s);
+    BOXDROID_FP_HIT();
+    return true;
+}
