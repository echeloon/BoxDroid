+/* Exact identities also accept full 64-bit significands. Precision rounding
+ * is still required in PC=24/53; exponent boundaries remain SoftFloat. */
+#if defined(__aarch64__)
+static inline bool boxdroid_f80_scaled32(floatx80 a, int scale, float *out)
+{
+    if (a.low & ((UINT64_C(1) << 40) - 1)) return false;
+    union { uint32_t u; float f; } v;
+    if (!a.low) v.u = (uint32_t)(a.high >> 15) << 31;
+    else {
+        int exp = (a.high & 0x7fff) - 16383 - scale + 127;
+        if (exp <= 0 || exp >= 255) return false;
+        v.u = ((uint32_t)(a.high >> 15) << 31) | ((uint32_t)exp << 23) |
+              ((a.low >> 40) & 0x7fffff);
+    }
+    *out = v.f;
+    return true;
+}
+#endif
+
+static inline bool boxdroid_f80_identity(floatx80 a, floatx80 b,
+                                        float_status *s, enum BoxDroidFPOp op,
+                                        floatx80 *out)
+{
+    floatx80 r;
+    int exp, sign = (a.high ^ b.high) & 0x8000;
+    bool apow = a.low == (UINT64_C(1) << 63);
+    bool bpow = b.low == (UINT64_C(1) << 63);
+    switch (op) {
+    case BOXDROID_FP_ADD:
+    case BOXDROID_FP_SUB:
+        if (!a.low && !b.low) return false; /* zero/cancellation sign rules */
+        if (!b.low) r = a;
+        else if (!a.low) {
+            r = b;
+            if (op == BOXDROID_FP_SUB) r.high ^= 0x8000;
+        } else if (a.low == b.low &&
+                   (a.high & 0x7fff) == (b.high & 0x7fff)) {
+            bool opposite = ((a.high ^ b.high) >> 15) ^
+                            (op == BOXDROID_FP_SUB);
+            if (opposite) {
+                r = (floatx80) { .high =
+                    s->float_rounding_mode == float_round_down ? 0x8000 : 0,
+                    .low = 0 };
+            } else {
+                exp = (a.high & 0x7fff) + 1;
+                if (exp >= 0x7fff) return false;
+                r = a;
+                r.high = (a.high & 0x8000) | exp;
+            }
+        } else return false;
+        break;
+    case BOXDROID_FP_MUL:
+        if (!a.low || !b.low) {
+            r = (floatx80) { .high = sign, .low = 0 };
+            break;
+        }
+        if (!apow && !bpow) return false;
+        r = bpow ? a : b;
+        exp = (a.high & 0x7fff) + (b.high & 0x7fff) - 16383;
+        if (exp <= 0 || exp >= 0x7fff) return false;
+        r.high = sign | exp;
+        break;
+    case BOXDROID_FP_DIV:
+        if (!b.low) return false;
+        if (!a.low) {
+            r = (floatx80) { .high = sign, .low = 0 };
+            break;
+        }
+        if (a.low == b.low && (a.high & 0x7fff) == (b.high & 0x7fff)) {
+            r = (floatx80) { .high = sign | 16383,
+                            .low = UINT64_C(1) << 63 };
+            break;
+        }
+        if (!bpow) return false;
+        r = a;
+        exp = (a.high & 0x7fff) - (b.high & 0x7fff) + 16383;
+        if (exp <= 0 || exp >= 0x7fff) return false;
+        r.high = sign | exp;
+        break;
+    case BOXDROID_FP_SQRT:
+        if (!a.low) { r = a; break; }
+        exp = (a.high & 0x7fff) - 16383;
+        if ((a.high >> 15) || !apow || (exp & 1)) return false;
+        r = (floatx80) { .high = 16383 + exp / 2,
+                        .low = UINT64_C(1) << 63 };
+        break;
+    default: return false;
+    }
+    int flags = 0;
+    if (!boxdroid_f80_precision(&r, s, &flags)) return false;
+    *out = r;
+    float_raise(flags, s);
+    BOXDROID_FP_HIT();
+    return true;
+}
