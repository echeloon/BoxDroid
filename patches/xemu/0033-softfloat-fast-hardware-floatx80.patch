+static inline bool double_to_f80_fast(double d, floatx80 *out)
+{
+    union { double d; uint64_t u; } u = { .d = d };
+    uint32_t sign = (u.u >> 63) & 1;
+    uint32_t exp_dbl = (u.u >> 52) & 0x7ff;
+    uint64_t mant_dbl = u.u & 0x000fffffffffffffULL;
+    if (likely(exp_dbl > 0 && exp_dbl < 0x7ff)) {
+        uint32_t exp_80 = exp_dbl - 1023 + 16383;
+        uint64_t low = (1ULL << 63) | (mant_dbl << 11);
+        uint16_t high = (uint16_t)((sign << 15) | exp_80);
+        *out = (floatx80){ .low = low, .high = high };
+        return true;
+    }
+    if (unlikely(exp_dbl == 0 && mant_dbl == 0)) {
+        *out = (floatx80){ .low = 0, .high = (uint16_t)(sign << 15) };
+        return true;
+    }
+    return false;
+}
+
+static inline bool float32_to_floatx80_fast(uint32_t a, floatx80 *out)
+{
+    uint32_t exp = (a >> 23) & 0xff;
+    uint32_t mant = a & 0x007fffff;
+    if (likely(exp > 0 && exp < 0xff)) {
+        uint16_t high = (uint16_t)(((a >> 31) << 15) | (exp + 16256));
+        uint64_t low = (1ULL << 63) | ((uint64_t)mant << 40);
+        *out = (floatx80){ .low = low, .high = high };
+        return true;
+    }
+    if (unlikely((a & 0x7fffffff) == 0)) {
+        *out = (floatx80){ .low = 0, .high = (uint16_t)((a >> 31) << 15) };
+        return true;
+    }
+    return false;
+}
+
+static inline bool float64_to_floatx80_fast(uint64_t a, floatx80 *out)
+{
+    uint32_t exp = (a >> 52) & 0x7ff;
+    uint64_t mant = a & 0x000fffffffffffffULL;
+    if (likely(exp > 0 && exp < 0x7ff)) {
+        uint16_t high = (uint16_t)(((a >> 63) << 15) | (exp + 15360));
+        uint64_t low = (1ULL << 63) | (mant << 11);
+        *out = (floatx80){ .low = low, .high = high };
+        return true;
+    }
+    if (unlikely((a & 0x7fffffffffffffffULL) == 0)) {
+        *out = (floatx80){ .low = 0, .high = (uint16_t)((a >> 63) << 15) };
+        return true;
+    }
+    return false;
+}
+
+static inline bool int64_to_floatx80_fast(int64_t a, floatx80 *out)
+{
+    if (unlikely(a == 0)) {
+        *out = (floatx80){ .low = 0, .high = 0 };
+        return true;
+    }
+    if (unlikely(a == INT64_MIN)) {
+        *out = (floatx80){ .low = 0x8000000000000000ULL, .high = 0x8000 | (16383 + 63) };
+        return true;
+    }
+    uint32_t sign = (a < 0) ? 1 : 0;
+    uint64_t val = (a < 0) ? (uint64_t)-a : (uint64_t)a;
+    int lz = __builtin_clzll(val);
+    uint32_t exp = 63 - lz;
+    uint64_t low = val << lz;
+    uint16_t high = (uint16_t)((sign << 15) | (16383 + exp));
+    *out = (floatx80){ .low = low, .high = high };
+    return true;
+}
