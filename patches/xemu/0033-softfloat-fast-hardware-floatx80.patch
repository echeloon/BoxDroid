+static inline bool boxdroid_f80_arithmetic(floatx80 a, floatx80 b,
+                                           float_status *s,
+                                           enum BoxDroidFPOp op, floatx80 *out)
+{
+    if (!boxdroid_use_fast_fpu(s) ||
+        !boxdroid_f80_regular(a) || !boxdroid_f80_regular(b)) {
+        return false;
+    }
+    if (boxdroid_f80_identity(a, b, s, op, out)) return true;
+    bool wide = s->floatx80_rounding_precision == floatx80_precision_x ||
+                s->float_rounding_mode != float_round_nearest_even ||
+                ((a.low | b.low) & 0x7ff);
