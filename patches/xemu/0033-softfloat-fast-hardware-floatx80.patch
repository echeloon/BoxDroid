diff --git a/fpu/boxdroid-floatx80.h b/fpu/boxdroid-floatx80.h
new file mode 100644
--- /dev/null
+++ b/fpu/boxdroid-floatx80.h
@@ -0,0 +1,1023 @@
+/* SPDX-License-Identifier: BSD-2-Clause
+ * Exact normal-number floatx80 acceleration. See the downstream correction
+ * report for domains and the double-rounding argument. Special encodings and
+ * exponent boundaries remain with SoftFloat. Never compile with fast-math.
+ */
+#ifndef BOXDROID_FLOATX80_H
+#define BOXDROID_FLOATX80_H
+
+#ifdef BOXDROID_FAST_FPU_TEST
+uint64_t boxdroid_fast_fpu_hits;
+uint64_t boxdroid_double53_hits;
+#define BOXDROID_FP_HIT() (++boxdroid_fast_fpu_hits)
+#else
+#define BOXDROID_FP_HIT() ((void)0)
+#endif
+
+#ifdef BOXDROID_XBOX_RUNTIME
+#include <sys/system_properties.h>
+#ifdef __aarch64__
+#include <android/log.h>
+#endif
+/* Keep rare property lookup/auditing out of every hot conversion's frame. */
+static __attribute__((noinline)) void boxdroid_refresh_fast_fpu(float_status *s)
+{
+    char prop[PROP_VALUE_MAX] = { 0 };
+#ifdef __aarch64__
+    if (!s->boxdroid_fast_fpu_state &&
+        __system_property_get("debug.boxdroid.fpu_audit", prop) > 0 && prop[0] == '1') {
+        uint64_t host_control;
+        asm volatile("mrs %0, fpcr" : "=r"(host_control));
+        __android_log_print(ANDROID_LOG_INFO, "BoxDroidFpu",
+                            "X87_HOST_FPCR value=0x%llx", (unsigned long long)host_control);
+    }
+#endif
+    s->boxdroid_fast_fpu_state =
+        (__system_property_get("debug.boxdroid.fast_fpu", prop) <= 0 ||
+         prop[0] != '0') ? 1 : 2;
+}
+
+static inline bool boxdroid_use_fast_fpu(float_status *s)
+{
+    /* Caller-owned status cache: no TLS and no new control-word cache that
+     * would need invalidation on temporary SoftFloat precision changes. */
+    if (unlikely(!s->boxdroid_fast_fpu_state ||
+                 (++s->boxdroid_fast_fpu_checks & 0xffff) == 1)) {
+        boxdroid_refresh_fast_fpu(s);
+    }
+    return s->boxdroid_fast_fpu_state == 1;
+}
+
+#else
+static inline bool boxdroid_use_fast_fpu(float_status *s)
+{
+    (void)s;
+    const char *value = getenv("BOXDROID_FAST_FPU");
+    return !value || value[0] != '0';
+}
+#endif
+
+/* Raw comparisons are valid only for canonical normals and signed zeros. */
+static inline bool boxdroid_f80_regular(floatx80 a)
+{
+    unsigned exp = a.high & 0x7fff;
+    return (exp > 0 && exp < 0x7fff && (a.low >> 63)) ||
+           (exp == 0 && a.low == 0);
+}
+
+static inline FloatRelation boxdroid_f80_compare(floatx80 a, floatx80 b)
+{
+    if (!a.low && !b.low) {
+        return float_relation_equal;
+    }
+    bool sa = a.high >> 15, sb = b.high >> 15;
+    if (sa != sb) {
+        return sa ? float_relation_less : float_relation_greater;
+    }
+    if (a.high == b.high && a.low == b.low) {
+        return float_relation_equal;
+    }
+    bool greater = (a.high & 0x7fff) > (b.high & 0x7fff) ||
+                   (a.high == b.high && a.low > b.low);
+    return greater != sa ? float_relation_greater : float_relation_less;
+}
+
+/* Pure integer rounding; caller commits flags only after all guards pass. */
+static inline bool boxdroid_f80_precision(floatx80 *a, float_status *s,
+                                          int *flags)
+{
+    unsigned shift;
+    switch (s->floatx80_rounding_precision) {
+    case floatx80_precision_x: shift = 0; break;
+    case floatx80_precision_d: shift = 11; break;
+    case floatx80_precision_s: shift = 40; break;
+    default: return false;
+    }
+    if (!shift || !a->low) {
+        return true;
+    }
+    uint64_t unit = UINT64_C(1) << shift;
+    uint64_t lost = a->low & (unit - 1);
+    bool increment;
+    switch (s->float_rounding_mode) {
+    case float_round_nearest_even:
+        increment = lost > unit / 2 ||
+                    (lost == unit / 2 && (a->low & unit));
+        break;
+    case float_round_to_zero: increment = false; break;
+    case float_round_up: increment = lost && !(a->high >> 15); break;
+    case float_round_down: increment = lost && (a->high >> 15); break;
+    default: return false;
+    }
+    uint64_t frac = a->low & ~(unit - 1);
+    if (increment) {
+        uint64_t rounded = frac + unit;
+        if (rounded < frac) {
+            unsigned exp = (a->high & 0x7fff) + 1;
+            if (exp == 0x7fff) {
+                return false;
+            }
+            a->high = (a->high & 0x8000) | exp;
+            rounded = UINT64_C(1) << 63;
+        }
+        frac = rounded;
+    }
+    a->low = frac;
+    if (lost) {
+        *flags |= float_flag_inexact;
+    }
+    return true;
+}
+
+/* Build a normal binary64 operand without a floating-point conversion.
+ * Scaling preserves the exact value, significand and sign. */
+static inline bool boxdroid_f80_scaled(floatx80 a, int scale, double *out)
+{
+    if (!boxdroid_f80_regular(a) || (a.low & 0x7ff)) {
+        return false;
+    }
+    union { uint64_t u; double d; } v;
+    if (!a.low) {
+        v.u = (uint64_t)(a.high >> 15) << 63;
+    } else {
+        int exp = (a.high & 0x7fff) - 16383 - scale + 1023;
+        if (exp <= 0 || exp >= 0x7ff) {
+            return false;
+        }
+        v.u = ((uint64_t)(a.high >> 15) << 63) |
+              ((uint64_t)exp << 52) |
+              ((a.low >> 11) & UINT64_C(0xfffffffffffff));
+    }
+    *out = v.d;
+    return true;
+}
+
+static inline bool boxdroid_f64_scaled(double a, int scale, floatx80 *out)
+{
+    union { double d; uint64_t u; } v = { .d = a };
+    unsigned exp = (v.u >> 52) & 0x7ff;
+    unsigned sign = v.u >> 63;
+    if (!exp) {
+        if (v.u & UINT64_C(0xfffffffffffff)) {
+            return false;
+        }
+        *out = (floatx80) { .high = sign << 15, .low = 0 };
+        return true;
+    }
+    int wide_exp = (int)exp - 1023 + scale + 16383;
+    if (exp == 0x7ff || wide_exp <= 0 || wide_exp >= 0x7fff) {
+        return false;
+    }
+    *out = (floatx80) {
+        .high = (sign << 15) | wide_exp,
+        .low = (UINT64_C(1) << 63) |
+               ((v.u & UINT64_C(0xfffffffffffff)) << 11),
+    };
+    return true;
+}
+
+enum BoxDroidFPOp {
+    BOXDROID_FP_ADD, BOXDROID_FP_SUB, BOXDROID_FP_MUL,
+    BOXDROID_FP_DIV, BOXDROID_FP_SQRT,
+};
+
+#if defined(__aarch64__)
+static inline bool boxdroid_fp_nearest(void)
+{
+    uint64_t fpcr;
+    asm volatile("mrs %0, fpcr" : "=r" (fpcr));
+    /* Scaled inputs are normal and the result is normal or exact zero:
+     * cancellation of 24/53-bit operands is >= 2^-24/2^-53. Other operations
+     * stay in [.5,4]. FZ and DN cannot change this domain. Rounding must be
+     * nearest; traps and every unrecognized control setting are rejected. */
+    return (fpcr & ~(UINT64_C(3) << 24)) == 0;
+}
+
+/* Certified estimates may use any host rounding mode. Integer certification
+ * and final rounding determine the guest result; an inaccurate guess falls
+ * back. Inputs, residual conversions and estimates are all finite normals. */
+static inline bool boxdroid_fp_estimate(void)
+{
+    uint64_t fpcr;
+    asm volatile("mrs %0, fpcr" : "=r"(fpcr));
+    return (fpcr & ~((UINT64_C(3) << 22) | (UINT64_C(3) << 24))) == 0;
+}
+
+/* One asm region prevents compiler motion across FPSR clear/read/restore.
+ * Preserve the caller's host flags; never substitute them for guest flags. */
+#define BOXDROID_HOST_OP(insn) \
+    asm volatile("mrs %0, fpsr\n\t" \
+                 "msr fpsr, xzr\n\t" \
+                 insn " %d2, %d3, %d4\n\t" \
+                 "mrs %1, fpsr\n\t" \
+                 "msr fpsr, %0" \
+                 : "=&r" (saved), "=&r" (*fpsr), "=&w" (result) \
+                 : "w" (a), "w" (b) : "memory")
+static inline double boxdroid_host_op(double a, double b,
+                                       enum BoxDroidFPOp op, uint64_t *fpsr,
+                                       bool observe)
+{
+    uint64_t saved;
+    double result;
+    if (!observe) {
+        /* Callers prove exactness, or the only possible exception is IXC
+         * already sticky and masked in the guest. Host FPSR may accumulate IXC, as with QEMU's
+         * existing unchecked hardfloat paths; FPCR is never changed. */
+        switch (op) {
+        case BOXDROID_FP_ADD:
+            asm volatile("fadd %d0, %d1, %d2" : "=w" (result) : "w" (a), "w" (b));
+            break;
+        case BOXDROID_FP_SUB:
+            asm volatile("fsub %d0, %d1, %d2" : "=w" (result) : "w" (a), "w" (b));
+            break;
+        case BOXDROID_FP_MUL:
+            asm volatile("fmul %d0, %d1, %d2" : "=w" (result) : "w" (a), "w" (b));
+            break;
+        case BOXDROID_FP_DIV:
+            asm volatile("fdiv %d0, %d1, %d2" : "=w" (result) : "w" (a), "w" (b));
+            break;
+        case BOXDROID_FP_SQRT:
+            asm volatile("fsqrt %d0, %d1" : "=w" (result) : "w" (a));
+            break;
+        default: g_assert_not_reached();
+        }
+        *fpsr = 0;
+        return result;
+    }
+    switch (op) {
+    case BOXDROID_FP_ADD: BOXDROID_HOST_OP("fadd"); break;
+    case BOXDROID_FP_SUB: BOXDROID_HOST_OP("fsub"); break;
+    case BOXDROID_FP_MUL: BOXDROID_HOST_OP("fmul"); break;
+    case BOXDROID_FP_DIV: BOXDROID_HOST_OP("fdiv"); break;
+    case BOXDROID_FP_SQRT:
+        asm volatile("mrs %0, fpsr\n\tmsr fpsr, xzr\n\t"
+                     "fsqrt %d2, %d3\n\tmrs %1, fpsr\n\tmsr fpsr, %0"
+                     : "=&r" (saved), "=&r" (*fpsr), "=&w" (result)
+                     : "w" (a) : "memory");
+        break;
+    default: g_assert_not_reached();
+    }
+    return result;
+}
+#undef BOXDROID_HOST_OP
+#define BOXDROID_HOST_OP32(insn) \
+    asm volatile("mrs %0, fpsr\n\t" \
+                 "msr fpsr, xzr\n\t" \
+                 insn " %s2, %s3, %s4\n\t" \
+                 "mrs %1, fpsr\n\t" \
+                 "msr fpsr, %0" \
+                 : "=&r" (saved), "=&r" (*fpsr), "=&w" (result) \
+                 : "w" (a), "w" (b) : "memory")
+static inline float boxdroid_host_op32(float a, float b,
+                                       enum BoxDroidFPOp op, uint64_t *fpsr,
+                                       bool observe)
+{
+    uint64_t saved;
+    float result;
+    if (!observe) {
+        /* Callers prove exactness, or the only possible exception is IXC
+         * already sticky and masked in the guest. Host FPSR may accumulate IXC, as with QEMU's
+         * existing unchecked hardfloat paths; FPCR is never changed. */
+        switch (op) {
+        case BOXDROID_FP_ADD:
+            asm volatile("fadd %s0, %s1, %s2" : "=w" (result) : "w" (a), "w" (b));
+            break;
+        case BOXDROID_FP_SUB:
+            asm volatile("fsub %s0, %s1, %s2" : "=w" (result) : "w" (a), "w" (b));
+            break;
+        case BOXDROID_FP_MUL:
+            asm volatile("fmul %s0, %s1, %s2" : "=w" (result) : "w" (a), "w" (b));
+            break;
+        case BOXDROID_FP_DIV:
+            asm volatile("fdiv %s0, %s1, %s2" : "=w" (result) : "w" (a), "w" (b));
+            break;
+        case BOXDROID_FP_SQRT:
+            asm volatile("fsqrt %s0, %s1" : "=w" (result) : "w" (a));
+            break;
+        default: g_assert_not_reached();
+        }
+        *fpsr = 0;
+        return result;
+    }
+    switch (op) {
+    case BOXDROID_FP_ADD: BOXDROID_HOST_OP32("fadd"); break;
+    case BOXDROID_FP_SUB: BOXDROID_HOST_OP32("fsub"); break;
+    case BOXDROID_FP_MUL: BOXDROID_HOST_OP32("fmul"); break;
+    case BOXDROID_FP_DIV: BOXDROID_HOST_OP32("fdiv"); break;
+    case BOXDROID_FP_SQRT:
+        asm volatile("mrs %0, fpsr\n\tmsr fpsr, xzr\n\t"
+                     "fsqrt %s2, %s3\n\tmrs %1, fpsr\n\tmsr fpsr, %0"
+                     : "=&r" (saved), "=&r" (*fpsr), "=&w" (result)
+                     : "w" (a) : "memory");
+        break;
+    default: g_assert_not_reached();
+    }
+    return result;
+}
+#undef BOXDROID_HOST_OP32
+#else
+static inline bool boxdroid_fp_nearest(void) { return false; }
+#endif
+
+/* Dedicated common PC=53/RN path. Canonical 53-bit operands with unbiased
+ * exponents in [-450,450] map directly to normal binary64. Add/sub cancellation
+ * is zero or >=2^-502, products/quotients stay above 2^-901 and below 2^902,
+ * and sqrt stays normal. Thus no exponent exception, FZ/DN effect or second
+ * rounding is possible. Only IXC can change; sticky guest flags are retained.
+ * All other encodings, precisions, modes and exponent domains use the existing
+ * exact implementation. No x87 control-word state is cached here. */
+static inline QEMU_ALWAYS_INLINE bool
+boxdroid_f80_double53(floatx80 a, floatx80 b, float_status *s,
+                     enum BoxDroidFPOp op, floatx80 *out)
+{
+#if defined(__aarch64__)
+    unsigned ea = a.high & 0x7fff, eb = b.high & 0x7fff;
+    if (s->floatx80_rounding_precision != floatx80_precision_d ||
+        s->float_rounding_mode != float_round_nearest_even ||
+        ea - (16383 - 450) > 900 || eb - (16383 - 450) > 900 ||
+        !((a.low & b.low) >> 63) || ((a.low | b.low) & 0x7ff) ||
+        (op == BOXDROID_FP_SQRT && (a.high & 0x8000)) ||
+        !boxdroid_use_fast_fpu(s) || !boxdroid_fp_nearest()) {
+        return false;
+    }
+    union { uint64_t u; double d; } da, db, r;
+    da.u = ((uint64_t)(a.high & 0x8000) << 48) |
+           ((uint64_t)(ea - 15360) << 52) |
+           ((a.low >> 11) & UINT64_C(0xfffffffffffff));
+    db.u = ((uint64_t)(b.high & 0x8000) << 48) |
+           ((uint64_t)(eb - 15360) << 52) |
+           ((b.low >> 11) & UINT64_C(0xfffffffffffff));
+    if (unlikely(!(s->float_exception_flags & float_flag_inexact))) {
+        uint64_t fpsr;
+        r.d = boxdroid_host_op(da.d, db.d, op, &fpsr, true);
+        if (fpsr & ~UINT64_C(0x10)) return false;
+        float_raise(fpsr & 0x10 ? float_flag_inexact : 0, s);
+    } else {
+        /* Constant op at each caller allows one inlined FP instruction. */
+        switch (op) {
+        case BOXDROID_FP_ADD:
+            asm volatile("fadd %d0, %d1, %d2" : "=w"(r.d) : "w"(da.d), "w"(db.d));
+            break;
+        case BOXDROID_FP_SUB:
+            asm volatile("fsub %d0, %d1, %d2" : "=w"(r.d) : "w"(da.d), "w"(db.d));
+            break;
+        case BOXDROID_FP_MUL:
+            asm volatile("fmul %d0, %d1, %d2" : "=w"(r.d) : "w"(da.d), "w"(db.d));
+            break;
+        case BOXDROID_FP_DIV:
+            asm volatile("fdiv %d0, %d1, %d2" : "=w"(r.d) : "w"(da.d), "w"(db.d));
+            break;
+        case BOXDROID_FP_SQRT:
+            asm volatile("fsqrt %d0, %d1" : "=w"(r.d) : "w"(da.d));
+            break;
+        default: return false;
+        }
+    }
+    unsigned e = (r.u >> 52) & 0x7ff;
+    *out = (floatx80) {
+        .high = ((r.u >> 48) & 0x8000) | (e ? e + 15360 : 0),
+        .low = e ? (UINT64_C(1) << 63) | (r.u << 11) : 0,
+    };
+#ifdef BOXDROID_FAST_FPU_TEST
+    ++boxdroid_double53_hits;
+#endif
+    BOXDROID_FP_HIT();
+    return true;
+#else
+    return false;
+#endif
+}
