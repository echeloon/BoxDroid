+#if defined(__aarch64__)
+/* The estimate is never a guest result. Integer inequalities certify the
+ * exact floor; an estimate needing more than one correction falls back. */
+static inline bool boxdroid_f80_refined(floatx80 a, floatx80 b, float_status *s,
+                                      enum BoxDroidFPOp op, floatx80 *out)
+{
+    if (!a.low || !b.low || !boxdroid_fp_estimate()) return false;
+    union { double d; uint64_t u; } da, db, estimate;
+    da.u = UINT64_C(0x3ff0000000000000) | ((a.low >> 11) & UINT64_C(0xfffffffffffff));
+    db.u = UINT64_C(0x3ff0000000000000) | ((b.low >> 11) & UINT64_C(0xfffffffffffff));
+    __uint128_t numerator, product, residual;
+    uint64_t q;
+    int exp;
+    unsigned sign;
+    double denominator;
+    if (op == BOXDROID_FP_DIV) {
+        bool smaller = a.low < b.low;
+        exp = (a.high & 0x7fff) - (b.high & 0x7fff) - smaller + 16383;
+        if (exp <= 0 || exp >= 0x7fff) return false;
+        asm volatile("fdiv %d0, %d1, %d2" : "=w"(estimate.d) : "w"(da.d), "w"(db.d));
+        numerator = (__uint128_t)a.low << (smaller ? 64 : 63);
+        unsigned e = (estimate.u >> 52) & 0x7ff;
+        /* Equal truncated operands can estimate 1 when the full ratio <1. */
+        q = smaller && e == 1023 ? UINT64_MAX :
+            ((estimate.u & UINT64_C(0xfffffffffffff)) | (UINT64_C(1) << 52)) << 11;
+        product = (__uint128_t)q * b.low;
+        denominator = (double)b.low;
+        sign = (a.high ^ b.high) >> 15;
+    } else if (op == BOXDROID_FP_SQRT) {
+        if (a.high >> 15) return false;
+        int ea = (a.high & 0x7fff) - 16383;
+        unsigned parity = ea & 1;
+        exp = (ea - (int)parity) / 2 + 16383;
+        da.u += (uint64_t)parity << 52;
+        asm volatile("fsqrt %d0, %d1" : "=w"(estimate.d) : "w"(da.d));
+        numerator = (__uint128_t)a.low << (63 + parity);
+        unsigned e = (estimate.u >> 52) & 0x7ff;
+        q = e == 1024 ? UINT64_MAX :
+            ((estimate.u & UINT64_C(0xfffffffffffff)) | (UINT64_C(1) << 52)) << 11;
+        product = (__uint128_t)q * q;
+        denominator = 2.0 * (double)q;
+        sign = 0;
+    } else return false;
+    bool negative = product > numerator;
+    residual = negative ? product - numerator : numerator - product;
+    double magnitude = (double)(uint64_t)(residual >> 64) * 0x1p64 +
+                       (double)(uint64_t)residual;
+    double correction = magnitude / denominator;
+    if (correction > 16384) return false;
+    uint64_t delta = (uint64_t)correction;
+    if (negative) q = delta > q ? 0 : q - delta;
+    else q = delta > UINT64_MAX - q ? UINT64_MAX : q + delta;
+    if (op == BOXDROID_FP_DIV) {
+        product = (__uint128_t)q * b.low;
+        if (product > numerator) {
+            if (!q) return false;
+            q--; product -= b.low;
+        } else if (numerator - product >= b.low) {
+            if (q == UINT64_MAX) return false;
+            q++; product += b.low;
+        }
+        if (product > numerator || numerator - product >= b.low) return false;
+        residual = numerator - product;
+    } else {
+        product = (__uint128_t)q * q;
+        if (product > numerator) {
+            if (!q) return false;
+            product -= (__uint128_t)2 * q - 1; q--;
+        } else if (q != UINT64_MAX && numerator - product >= (__uint128_t)2 * q + 1) {
+            product += (__uint128_t)2 * q + 1; q++;
+        }
+        if (product > numerator || (q != UINT64_MAX &&
+            numerator - product >= (__uint128_t)2 * q + 1)) return false;
+        residual = numerator - product;
+    }
+    if (!(q >> 63)) return false;
+    /* Rounding needs only zero and the tail's relation to half an ulp.
+     * Lower precision ties use the integer floor plus a nonzero tail. */
+    uint64_t tail = 0;
+    if (residual) {
+        if (op == BOXDROID_FP_DIV) {
+            __uint128_t twice = residual * 2;
+            tail = twice < b.low ? 1 : twice == b.low ? UINT64_C(1) << 63 :
+                                                         (UINT64_C(1) << 63) + 1;
+        } else {
+            /* sqrt(N)>q+.5 iff N-q*q>q; equality is impossible for integer N. */
+            tail = residual > q ? (UINT64_C(1) << 63) + 1 : 1;
+        }
+    }
+    return boxdroid_f80_round128(((__uint128_t)q << 64) | tail,
+                                false, exp, sign, s, out);
+}
+#endif
+
+#else
+static inline bool boxdroid_f80_wide_integer(floatx80 a, floatx80 b,
+                                            float_status *s,
+                                            enum BoxDroidFPOp op, floatx80 *out)
+{
+    return false;
+}
+#endif
