+    if (!boxdroid_f80_precision(&r, s, &flags)) {
+        return false;
+    }
+    *out = r;
+    float_raise(flags, s);
+    BOXDROID_FP_HIT();
+    return true;
+#else
+    return false;
+#endif
+}
