+    if (wide && boxdroid_f80_exact_binary64(a, b, s, op, out)) return true;
+#endif
+    if (wide && boxdroid_f80_wide_integer(a, b, s, op, out)) return true;
+#if defined(__aarch64__)
+#if defined(__SIZEOF_INT128__)
+    if (wide && boxdroid_f80_refined(a, b, s, op, out)) return true;
+#endif
+    if (!boxdroid_fp_nearest()) return false;
+    int ea = a.low ? (a.high & 0x7fff) - 16383 : 0;
+    int eb = b.low ? (b.high & 0x7fff) - 16383 : 0;
+    int scale, sa, sb;
+    switch (op) {
+    case BOXDROID_FP_ADD:
+    case BOXDROID_FP_SUB:
+        scale = a.low && b.low ? MAX(ea, eb) : a.low ? ea : eb;
+        sa = sb = scale;
+        break;
+    case BOXDROID_FP_MUL: scale = ea + eb; sa = ea; sb = eb; break;
+    case BOXDROID_FP_DIV:
+        if (!b.low) { return false; }
+        scale = ea - eb; sa = ea; sb = eb; break;
+    case BOXDROID_FP_SQRT:
+        if ((a.high >> 15) && a.low) { return false; }
