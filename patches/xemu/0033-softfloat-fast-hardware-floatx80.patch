+        sa = sb = 2 * scale;
+        break;
+    default: return false;
+    }
+    /* Direct binary24 arithmetic avoids double rounding altogether when
+     * both operands are exact binary24 normals after power-of-two scaling. */
+    float fa, fb;
+    if (s->floatx80_rounding_precision == floatx80_precision_s &&
+        s->float_rounding_mode == float_round_nearest_even &&
+        boxdroid_f80_scaled32(a, sa, &fa) &&
+        boxdroid_f80_scaled32(b, sb, &fb)) {
+        uint64_t flags;
+        bool observe = !(s->float_exception_flags & float_flag_inexact);
+        union { float f; uint32_t u; } v = {
