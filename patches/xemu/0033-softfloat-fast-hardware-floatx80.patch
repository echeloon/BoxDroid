+        } else {
+            int exp = (int)e - 127 + scale + 16383;
+            if (e == 255 || exp <= 0 || exp >= 0x7fff) return false;
+            r = (floatx80) { .high = (sign << 15) | exp,
+                .low = (UINT64_C(1) << 63) | ((uint64_t)(v.u & 0x7fffff) << 40) };
+        }
+        *out = r;
+        float_raise(!observe || (flags & 0x10) ? float_flag_inexact : 0, s);
+        BOXDROID_FP_HIT();
+        return true;
+    }
+    double da, db;
+    if (!boxdroid_f80_scaled(a, sa, &da) ||
+        !boxdroid_f80_scaled(b, sb, &db)) {
+        return false;
+    }
+    uint64_t fpsr;
+    bool observe = !(s->float_exception_flags & float_flag_inexact) ||
+        s->float_rounding_mode != float_round_nearest_even ||
+        (s->floatx80_rounding_precision != floatx80_precision_s &&
+         s->floatx80_rounding_precision != floatx80_precision_d);
+    double result = boxdroid_host_op(da, db, op, &fpsr, observe);
+    /* Scaled normal arithmetic must not raise an exception other than IXC. */
+    if (fpsr & ~UINT64_C(0x10)) {
