+static inline bool f80_to_double_fast(floatx80 a, double *out)
+{
+    if (unlikely((a.low & 0x7ffULL) != 0)) {
+        return false;
+    }
+    uint32_t exp = a.high & 0x7fff;
+    uint32_t sign = (a.high >> 15) & 1;
+    if (likely(exp >= (16383 - 1022) && exp <= (16383 + 1023) && (a.low & 0x8000000000000000ULL))) {
+        int32_t exp_dbl = (int32_t)exp - 16383 + 1023;
+        uint64_t mant_dbl = (a.low >> 11) & 0x000fffffffffffffULL;
+        union { uint64_t u; double d; } res;
+        res.u = ((uint64_t)sign << 63) | ((uint64_t)exp_dbl << 52) | mant_dbl;
+        *out = res.d;
+        return true;
+    }
+    if (unlikely(exp == 0 && a.low == 0)) {
+        union { uint64_t u; double d; } res;
+        res.u = (uint64_t)sign << 63;
+        *out = res.d;
+        return true;
+    }
+    return false;
+}
