+static inline FloatRelation floatx80_compare_fast_exact(floatx80 a, floatx80 b)
+{
+    uint32_t exp_a = a.high & 0x7fff;
+    uint32_t exp_b = b.high & 0x7fff;
+    if (unlikely(exp_a == 0x7fff || exp_b == 0x7fff)) {
+        return float_relation_unordered;
+    }
+    if (unlikely(((a.low >> 63) == 0 && exp_a != 0) || ((b.low >> 63) == 0 && exp_b != 0))) {
+        return float_relation_unordered;
+    }
+    bool a_zero = (exp_a == 0 && a.low == 0);
+    bool b_zero = (exp_b == 0 && b.low == 0);
+    if (unlikely(a_zero && b_zero)) {
+        return float_relation_equal;
+    }
+    uint32_t sign_a = (a.high >> 15) & 1;
+    uint32_t sign_b = (b.high >> 15) & 1;
+    if (sign_a != sign_b) {
+        if (a_zero) return sign_b ? float_relation_greater : float_relation_less;
+        if (b_zero) return sign_a ? float_relation_less : float_relation_greater;
+        return sign_a ? float_relation_less : float_relation_greater;
+    }
+    if (a.high == b.high && a.low == b.low) {
+        return float_relation_equal;
+    }
+    bool a_mag_greater = (exp_a > exp_b) || (exp_a == exp_b && a.low > b.low);
+    if (sign_a) {
+        return a_mag_greater ? float_relation_less : float_relation_greater;
+    } else {
+        return a_mag_greater ? float_relation_greater : float_relation_less;
+    }
+}
