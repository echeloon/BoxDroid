diff --git a/hw/xbox/mcpx/apu/monitor.c b/hw/xbox/mcpx/apu/monitor.c
index 7eeb124..6284d17 100644
--- a/hw/xbox/mcpx/apu/monitor.c
+++ b/hw/xbox/mcpx/apu/monitor.c
@@ -21,0 +22,4 @@
+#if defined(__ANDROID__) && defined(BOXDROID_AUDIO)
+#include "boxdroid-audio.h"
+#endif
+
@@ -23 +27 @@
-/* Preserve APU emulation while deferring platform audio output. */
+/* Android keeps guest APU state active but has no host output backend. */
@@ -27,0 +32,3 @@ void mcpx_apu_monitor_init(MCPXAPUState *d, Error **errp)
+#ifdef BOXDROID_AUDIO
+    boxdroid_audio_apu_attach();
+#endif
@@ -32,0 +40,3 @@ void mcpx_apu_monitor_finalize(MCPXAPUState *d)
+#ifdef BOXDROID_AUDIO
+    boxdroid_audio_apu_detach();
+#endif
@@ -37,2 +47,2 @@ void mcpx_apu_monitor_frame(MCPXAPUState *d)
-    if (!((d->ep_frame_div + 1) % 8)) {
-        memset(d->monitor.frame_buf, 0, sizeof(d->monitor.frame_buf));
+    if ((d->ep_frame_div + 1) % 8) {
+        return;
@@ -39,0 +50,7 @@ void mcpx_apu_monitor_frame(MCPXAPUState *d)
+
+#ifdef BOXDROID_AUDIO
+    float gain = pow(fmax(0.0, fmin(g_config.audio.volume_limit, 1.0)), M_E);
+    boxdroid_audio_push(&d->monitor.frame_buf[0][0],
+                           ARRAY_SIZE(d->monitor.frame_buf), gain);
+#endif
+    memset(d->monitor.frame_buf, 0, sizeof(d->monitor.frame_buf));
