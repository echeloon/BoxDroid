@@ -224,6 +224,31 @@ static inline void voice_owner_release(VoiceOwnership *o, unsigned v)
     qemu_mutex_unlock(&o->lock);
 }
 
+static inline void voice_owner_release_mask(VoiceOwnership *o,
+                                            const uint64_t mask[4])
+{
+    if (!(mask[0] | mask[1] | mask[2] | mask[3])) {
+        return;
+    }
+    qemu_mutex_lock(&o->lock);
+    for (int i = 0; i < 4; i++) {
+        uint64_t m = mask[i];
+        if (!m) {
+            continue;
+        }
+        assert((o->active[i] & m) == m);
+        o->active[i] &= ~m;
+        uint64_t g = qatomic_read(&o->guest[i]) & m;
+        while (g) {
+            int bit_idx = ctz64(g);
+            qemu_cond_signal(&o->idle[i * 64 + bit_idx]);
+            g &= g - 1;
+        }
+    }
+    qemu_cond_signal(&o->available);
+    qemu_mutex_unlock(&o->lock);
+}
+
 static inline void voice_owner_cancel(VoiceOwnership *o, bool cancel)
 {
     qemu_mutex_lock(&o->lock);
