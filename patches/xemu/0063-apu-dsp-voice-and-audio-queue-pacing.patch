+/* Optional single-producer RAM capture: one clock read and two stores/flip.
+ * No per-frame log/format/allocation/I/O. Pre-faulted MAP_SHARED file, bounded.
+ */
+static void validation_record_flip(void)
+{
+    enum { CAPACITY = 131072 };
+    static bool checked;
+    static uint64_t *capture;
+    static uint64_t count;
+    if (unlikely(!checked)) {
+        char value[PROP_VALUE_MAX] = {0};
+        checked = true;
+        if (__system_property_get("debug.boxdroid.validation_frames", value) &&
+            value[0] == '1') {
+            size_t bytes = (CAPACITY + 8) * sizeof(uint64_t);
+            int fd = open("/data/data/org.boxdroid/files/validation-frames.bin",
+                          O_RDWR | O_CREAT | O_TRUNC, 0600);
+            if (fd >= 0) {
+                if (ftruncate(fd, bytes) == 0) {
+                    void *p = mmap(NULL, bytes, PROT_READ | PROT_WRITE,
+                                   MAP_SHARED, fd, 0);
+                    if (p != MAP_FAILED) {
+                        capture = p;
+                        memset(capture, 0, bytes);
+                        capture[0] = UINT64_C(0x42444652414d4531);
+                        capture[1] = CAPACITY;
+                    }
+                }
+                close(fd);
+            }
+        }
+    }
+    if (unlikely(capture != NULL) && count < CAPACITY) {
+        capture[8 + count] = g_get_monotonic_time();
+        __atomic_store_n(&capture[2], ++count, __ATOMIC_RELEASE);
+    }
+}
