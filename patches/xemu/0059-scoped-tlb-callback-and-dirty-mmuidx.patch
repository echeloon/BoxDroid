+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+    if (cpu->cpu_index == 0 && (uint32_t)addr == addr &&
+        (size == (UINT64_C(1) << 21) || size == (UINT64_C(1) << 22))) {
+        unsigned int slice = (uint32_t)addr >> 21;
