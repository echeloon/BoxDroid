 bool physical_memory_is_clean(ram_addr_t addr)
 {
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+    if (boxdroid_tlb_cb_scope) {
+        unsigned long page = addr >> TARGET_PAGE_BITS;
+        unsigned long idx = page / DIRTY_MEMORY_BLOCK_SIZE;
+        unsigned long offset = page % DIRTY_MEMORY_BLOCK_SIZE;
+        unsigned long word = BIT_WORD(offset);
+        unsigned long mask = BIT_MASK(offset);
+        unsigned long all;
+
+        RCU_READ_LOCK_GUARD();
+        all = qatomic_rcu_read(&ram_list.dirty_memory[DIRTY_MEMORY_NV2A])
+                  ->blocks[idx][word] &
