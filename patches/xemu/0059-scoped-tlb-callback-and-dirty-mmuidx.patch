+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+void boxdroid_tlb_flush_ram_cb_range(CPUState *cpu, hwaddr ram_addr,
+                                     hwaddr len, bool is_remove);
+void boxdroid_tlb_flush_ram_cb_range(CPUState *cpu, hwaddr ram_addr,
+                                     hwaddr len, bool is_remove)
+{
+    hwaddr start_page, end_page;
+
+    if (len == 0) {
+        return;
+    }
+    assert_cpu_is_self(cpu);
+
+    start_page = ram_addr & TARGET_PAGE_MASK;
+    end_page = (ram_addr + len - 1) & TARGET_PAGE_MASK;
+    boxdroid_tlb_cb_scope_flushes++;
+
+    qemu_spin_lock(&cpu->neg.tlb.c.lock);
+    for (MMUIdxMap work = cpu->neg.tlb.c.dirty; work != 0; work &= work - 1) {
+        int mmu_idx = ctz32(work);
+        CPUTLBDesc *desc = &cpu->neg.tlb.d[mmu_idx];
+        CPUTLBDescFast *fast = cpu_tlb_fast(cpu, mmu_idx);
+        unsigned int n = tlb_n_entries(fast);
+        unsigned int i;
+
+        if (desc->n_used_entries != 0) {
+            for (i = 0; i < n; i++) {
+                CPUTLBEntry *te = &fast->table[i];
+                uintptr_t r = te->addr_read;
+                uintptr_t w = te->addr_write;
+                if ((r & w) == (uintptr_t)-1) {
+                    continue;
+                }
+                if (is_remove &&
+                    !((desc->fulltlb[i].slow_flags[MMU_DATA_LOAD] |
+                       desc->fulltlb[i].slow_flags[MMU_DATA_STORE]) &
+                      TLB_WATCHPOINT)) {
+                    continue;
+                }
+                vaddr addr_page =
+                    ((r != (uintptr_t)-1) ? r : w) & TARGET_PAGE_MASK;
+                hwaddr iotlb_page =
+                    (desc->fulltlb[i].xlat_section + addr_page) &
+                    TARGET_PAGE_MASK;
+                if (iotlb_page >= start_page && iotlb_page <= end_page) {
+                    memset(te, -1, sizeof(*te));
+                    tlb_n_used_entries_dec(cpu, mmu_idx);
+                }
+            }
+        }
+
+        for (i = 0; i < CPU_VTLB_SIZE; i++) {
+            CPUTLBEntry *tv = &desc->vtable[i];
+            uintptr_t r = tv->addr_read;
+            uintptr_t w = tv->addr_write;
+            if ((r & w) == (uintptr_t)-1) {
+                continue;
+            }
+            if (is_remove &&
+                !((desc->vfulltlb[i].slow_flags[MMU_DATA_LOAD] |
+                   desc->vfulltlb[i].slow_flags[MMU_DATA_STORE]) &
+                  TLB_WATCHPOINT)) {
+                continue;
+            }
+            vaddr addr_page =
+                ((r != (uintptr_t)-1) ? r : w) & TARGET_PAGE_MASK;
+            hwaddr iotlb_page =
+                (desc->vfulltlb[i].xlat_section + addr_page) &
+                TARGET_PAGE_MASK;
+            if (iotlb_page >= start_page && iotlb_page <= end_page) {
+                memset(tv, -1, sizeof(*tv));
+            }
+        }
+    }
+    qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+}
