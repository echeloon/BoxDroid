+                  ->blocks[idx][word] &
+              qatomic_rcu_read(&ram_list.dirty_memory[DIRTY_MEMORY_CODE])
+                  ->blocks[idx][word] &
+              qatomic_rcu_read(&ram_list.dirty_memory[DIRTY_MEMORY_MIGRATION])
+                  ->blocks[idx][word];
+        return !(all & mask);
+    }
