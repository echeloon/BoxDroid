diff --git a/hw/xbox/nv2a/prmcio.c b/hw/xbox/nv2a/prmcio.c
index d75e14a518..91e77f46a0 100644
--- a/hw/xbox/nv2a/prmcio.c
+++ b/hw/xbox/nv2a/prmcio.c
@@ -22,0 +23,4 @@
+#include "hw/display/vga_regs.h"
+#if defined(BOXDROID_XBOX_RUNTIME)
+#include "hw/xbox/nv2a/boxdroid-diagnostics.h"
+#endif
@@ -54,0 +59,12 @@ void prmcio_write(void *opaque, hwaddr addr, uint64_t val, unsigned int size)
+#ifdef BOXDROID_XBOX_RUNTIME
+    if (addr == VGA_CRT_DC &&
+        (d->vga.cr_index == VGA_CRTC_H_DISP ||
+         d->vga.cr_index == VGA_CRTC_V_DISP_END ||
+         d->vga.cr_index == VGA_CRTC_OFFSET ||
+         d->vga.cr_index == VGA_CRTC_MODE ||
+         d->vga.cr_index == VGA_CRTC_START_HI ||
+         d->vga.cr_index == VGA_CRTC_START_LO)) {
+        boxdroid_diag_event(BOXDROID_DIAG_VGA_CRTC_WRITE,
+                               d->vga.cr_index, val, 0, 0, 0, 0);
+    }
+#endif
