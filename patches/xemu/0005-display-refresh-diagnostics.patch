diff --git a/hw/xbox/nv2a/pgraph/vk/renderer.c b/hw/xbox/nv2a/pgraph/vk/renderer.c
index 96c853c5cf..de3be0fc1a 100644
--- a/hw/xbox/nv2a/pgraph/vk/renderer.c
+++ b/hw/xbox/nv2a/pgraph/vk/renderer.c
@@ -20,0 +21,3 @@
+#if defined(BOXDROID_XBOX_RUNTIME)
+#include "hw/xbox/nv2a/boxdroid-diagnostics.h"
+#endif
@@ -197,0 +201 @@ static int pgraph_vk_get_framebuffer_surface(NV2AState *d)
+    int display_width = 0, display_height = 0;
@@ -198,0 +203,7 @@ static int pgraph_vk_get_framebuffer_surface(NV2AState *d)
+    d->vga.get_resolution(&d->vga, &display_width, &display_height);
+    hwaddr scanout_address = d->pcrtc.start + vga_display_params.line_offset;
+#ifdef BOXDROID_XBOX_RUNTIME
+    boxdroid_diag_event(BOXDROID_DIAG_FRAMEBUFFER_LOOKUP,
+                           scanout_address, vga_display_params.line_offset,
+                           display_width, display_height, 0, 0);
+#endif
@@ -200,2 +211 @@ static int pgraph_vk_get_framebuffer_surface(NV2AState *d)
-    SurfaceBinding *surface = pgraph_vk_surface_get_within(
-        d, d->pcrtc.start + vga_display_params.line_offset);
+    SurfaceBinding *surface = pgraph_vk_surface_get_within(d, scanout_address);
@@ -203 +213,10 @@ static int pgraph_vk_get_framebuffer_surface(NV2AState *d)
-#ifdef __ANDROID__
+#ifdef BOXDROID_XBOX_RUNTIME
+        boxdroid_diag_event(BOXDROID_DIAG_FRAMEBUFFER_MISS,
+                               scanout_address,
+                               surface ? surface->vram_addr : UINT64_MAX,
+                               surface ? surface->size : 0,
+                               vga_display_params.line_offset,
+                               surface ? surface->width : display_width,
+                               surface ? surface->height : display_height);
+#endif
+#if defined(__ANDROID__) && !defined(BOXDROID_XBOX_RUNTIME)
@@ -215,0 +235,5 @@ static int pgraph_vk_get_framebuffer_surface(NV2AState *d)
+#ifdef BOXDROID_XBOX_RUNTIME
+    boxdroid_diag_event(BOXDROID_DIAG_FRAMEBUFFER_HIT,
+                           scanout_address, surface->vram_addr, surface->size,
+                           surface->pitch, surface->width, surface->height);
+#endif
@@ -228,0 +253,5 @@ static int pgraph_vk_get_framebuffer_surface(NV2AState *d)
+#ifdef BOXDROID_XBOX_RUNTIME
+    boxdroid_diag_event(BOXDROID_DIAG_READBACK_BEGIN,
+                           surface->width, surface->height, 0, 0, 0, 0);
+#endif
+#if !defined(BOXDROID_XBOX_RUNTIME)
@@ -231,0 +261 @@ static int pgraph_vk_get_framebuffer_surface(NV2AState *d)
+#endif
@@ -234,0 +265,5 @@ static int pgraph_vk_get_framebuffer_surface(NV2AState *d)
+#ifdef BOXDROID_XBOX_RUNTIME
+    boxdroid_diag_event(BOXDROID_DIAG_READBACK_COMPLETE,
+                           surface->width, surface->height, 0, 0, 0, 0);
+#endif
