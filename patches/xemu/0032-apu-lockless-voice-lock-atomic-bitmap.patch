From: BoxDroid downstream
Subject: [PATCH] mcpx/apu: targeted exclusive voice ownership and batch admission

diff --git a/hw/xbox/mcpx/apu/vp/voice-ownership.h b/hw/xbox/mcpx/apu/vp/voice-ownership.h
new file mode 100644
--- /dev/null
+++ b/hw/xbox/mcpx/apu/vp/voice-ownership.h
@@ -0,0 +1,248 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* MCPX voice handoff. Caller supplies QemuMutex/Cond and qatomic primitives.
+ * A guest request excludes new admissions BEFORE waiting for old users.
+ * A batch is admitted all-or-none: never wait holding another voice.
+ * idle[v] is targeted; available has only the single APU dispatcher waiter.
+ */
+#ifndef MCPX_VOICE_OWNERSHIP_H
+#define MCPX_VOICE_OWNERSHIP_H
+#ifdef BOXDROID_XBOX_RUNTIME
+#include <android/log.h>
+#include <sys/system_properties.h>
+#endif
+
+typedef struct VoiceOwnership {
+    QemuMutex lock;
+    QemuCond available, idle[256], ordered[256];
+    uint16_t remaining[256], next[256];
+    uint64_t active[4];
+    uint64_t *guest;
+    bool cancelled, audit;
+    int64_t audit_report;
+    uint64_t control_generation;
+} VoiceOwnership;
+
+static inline void voice_owner_init(VoiceOwnership *o, uint64_t *guest)
+{
+    qemu_mutex_init(&o->lock);
+    qemu_cond_init(&o->available);
+    for (int v = 0; v < 256; v++) {
+        qemu_cond_init(&o->idle[v]);
+        qemu_cond_init(&o->ordered[v]);
+    }
+    memset(o->active, 0, sizeof(o->active));
+    memset(o->remaining, 0, sizeof(o->remaining));
+    o->guest = guest;
+    o->cancelled = false;
+    o->audit = false;
+    o->audit_report = 0;
+    o->control_generation = 0;
+#ifdef BOXDROID_XBOX_RUNTIME
+    char prop[PROP_VALUE_MAX] = { 0 };
+    __system_property_get("debug.boxdroid.voice_audit", prop);
+    o->audit = prop[0] == '1';
+#endif
+}
+
+/* Bounded diagnostics only. Normal production uses an untimed condition. */
+static inline void voice_owner_sleep(VoiceOwnership *o, QemuCond *cond,
+                                     const char *where, unsigned voice)
+{
+#ifdef BOXDROID_XBOX_RUNTIME
+    if (o->audit) {
+        if (qemu_cond_timedwait(cond, &o->lock, 1000)) return;
+        int64_t now = g_get_monotonic_time();
+        if (now - o->audit_report >= G_USEC_PER_SEC) {
+            o->audit_report = now;
+            __android_log_print(ANDROID_LOG_INFO, "BoxDroidVoice",
+                "VOICE_HANDOFF_WAIT where=%s voice=%u cancelled=%d active=%016llx:%016llx:%016llx:%016llx guest=%016llx:%016llx:%016llx:%016llx",
+                where, voice, o->cancelled,
+                (unsigned long long)o->active[0], (unsigned long long)o->active[1],
+                (unsigned long long)o->active[2], (unsigned long long)o->active[3],
+                (unsigned long long)qatomic_read(&o->guest[0]),
+                (unsigned long long)qatomic_read(&o->guest[1]),
+                (unsigned long long)qatomic_read(&o->guest[2]),
+                (unsigned long long)qatomic_read(&o->guest[3]));
+        }
+        return;
+    }
+#endif
+    qemu_cond_wait(cond, &o->lock);
+}
+
+static inline void voice_owner_guest(VoiceOwnership *o, unsigned v, bool lock)
+{
+    uint64_t bit = UINT64_C(1) << (v % 64);
+    assert(v < 256);
+    qemu_mutex_lock(&o->lock);
+    if (lock) {
+        qatomic_or(&o->guest[v / 64], bit);
+        while (o->active[v / 64] & bit) {
+            voice_owner_sleep(o, &o->idle[v], "guest", v);
+        }
+    } else {
+        /* UNLOCK is idempotent. If no guest lock was held, an existing
+         * worker reservation remains active until its normal release. */
+        qatomic_and(&o->guest[v / 64], ~bit);
+        o->control_generation++;
+        qemu_cond_signal(&o->available);
+    }
+    qemu_mutex_unlock(&o->lock);
+}
+
+/* Caller holds o->lock. */
+static inline bool voice_owner_admit(VoiceOwnership *o, const uint64_t mask[4])
+{
+    if (o->cancelled) {
+        return false;
+    }
+    for (int i = 0; i < 4; i++) {
+        if (mask[i] & (qatomic_read(&o->guest[i]) | o->active[i])) {
+            return false;
+        }
+    }
+    for (int i = 0; i < 4; i++) {
+        o->active[i] |= mask[i];
+    }
+    return true;
+}
+
+enum VoiceOwnerWait {
+    VOICE_OWNER_CANCELLED = -1, VOICE_OWNER_RETRY = 0,
+    VOICE_OWNER_ADMITTED = 1, VOICE_OWNER_WAIT = 2,
+};
+
+static inline uint64_t voice_owner_generation(VoiceOwnership *o)
+{
+    qemu_mutex_lock(&o->lock);
+    uint64_t generation = o->control_generation;
+    qemu_mutex_unlock(&o->lock);
+    return generation;
+}
+
+static inline void voice_owner_control_changed(VoiceOwnership *o)
+{
+    qemu_mutex_lock(&o->lock);
+    o->control_generation++;
+    qemu_cond_signal(&o->available);
+    qemu_mutex_unlock(&o->lock);
+}
+
+static inline enum VoiceOwnerWait voice_owner_poll(VoiceOwnership *o,
+        const uint64_t mask[4], bool watch_control, uint64_t generation)
+{
+    if (o->cancelled) return VOICE_OWNER_CANCELLED;
+    if (watch_control && generation != o->control_generation) return VOICE_OWNER_RETRY;
+    return voice_owner_admit(o, mask) ? VOICE_OWNER_ADMITTED : VOICE_OWNER_WAIT;
+}
+
+/* Entry/return with the APU frame mutex held. Never take it while holding
+ * ownership.lock. OFF and unlock wake admission to rebuild its live set;
+ * a stopped guest-owned voice must not prevent frontend/IRQ progression. */
+static inline enum VoiceOwnerWait voice_owner_wait_event(VoiceOwnership *o,
+        const uint64_t mask[4], QemuMutex *frame_lock,
+        bool watch_control, uint64_t generation)
+{
+    qemu_mutex_lock(&o->lock);
+    enum VoiceOwnerWait result = voice_owner_poll(o, mask, watch_control, generation);
+    if (result == VOICE_OWNER_WAIT) {
+        qemu_mutex_unlock(&o->lock);
+        qemu_mutex_unlock(frame_lock);
+        qemu_mutex_lock(&o->lock);
+        while ((result = voice_owner_poll(o, mask, watch_control, generation)) ==
+               VOICE_OWNER_WAIT) {
+            voice_owner_sleep(o, &o->available, "dispatcher", 256);
+        }
+        qemu_mutex_unlock(&o->lock);
+        qemu_mutex_lock(frame_lock);
+        return result;
+    }
+    qemu_mutex_unlock(&o->lock);
+    return result;
+}
+
+static inline bool voice_owner_wait(VoiceOwnership *o, const uint64_t mask[4],
+                                   QemuMutex *frame_lock)
+{
+    return voice_owner_wait_event(o, mask, frame_lock, false, 0) == VOICE_OWNER_ADMITTED;
+}
+
+/* Collection can see a restarted voice in more than one list. Keep its
+ * reservation until every occurrence completes, in guest collection order.
+ * This changes neither worker assignment nor multipass cohort grouping. */
+static inline void voice_owner_repeat(VoiceOwnership *o, unsigned v,
+                                      unsigned count)
+{
+    assert(v < 256 && count > 1 && count <= 256);
+    qemu_mutex_lock(&o->lock);
+    assert(o->active[v / 64] & (UINT64_C(1) << (v % 64)));
+    assert(!o->remaining[v]);
+    o->remaining[v] = count;
+    o->next[v] = 0;
+    qemu_mutex_unlock(&o->lock);
+}
+
+static inline void voice_owner_enter(VoiceOwnership *o, unsigned v,
+                                     unsigned ordinal)
+{
+    qemu_mutex_lock(&o->lock);
+    while (o->next[v] != ordinal) {
+        voice_owner_sleep(o, &o->ordered[v], "ordered-worker", v);
+    }
+    assert(o->remaining[v]);
+    assert(o->active[v / 64] & (UINT64_C(1) << (v % 64)));
+    qemu_mutex_unlock(&o->lock);
+}
+
+static inline bool voice_owner_complete_repeat(VoiceOwnership *o, unsigned v)
+{
+    qemu_mutex_lock(&o->lock);
+    assert(o->remaining[v]);
+    bool done = !--o->remaining[v];
+    o->next[v]++;
+    if (!done) {
+        /* Only workers waiting for this voice wake; ordinal predicates
+         * tolerate any wake order. No other voice worker is signalled. */
+        qemu_cond_broadcast(&o->ordered[v]);
+    }
+    qemu_mutex_unlock(&o->lock);
+    return done;
+}
+
+static inline void voice_owner_release(VoiceOwnership *o, unsigned v)
+{
+    uint64_t bit = UINT64_C(1) << (v % 64);
+    assert(v < 256);
+    qemu_mutex_lock(&o->lock);
+    assert(o->active[v / 64] & bit);
+    assert(!o->remaining[v]);
+    o->active[v / 64] &= ~bit;
+    if (qatomic_read(&o->guest[v / 64]) & bit) {
+        qemu_cond_signal(&o->idle[v]);
+    }
+    qemu_cond_signal(&o->available);
+    qemu_mutex_unlock(&o->lock);
+}
+
+static inline void voice_owner_cancel(VoiceOwnership *o, bool cancel)
+{
+    qemu_mutex_lock(&o->lock);
+    o->cancelled = cancel;
+    qemu_cond_signal(&o->available);
+    qemu_mutex_unlock(&o->lock);
+}
+
+static inline void voice_owner_destroy(VoiceOwnership *o)
+{
+    for (int i = 0; i < 4; i++) {
+        assert(!o->active[i]);
+    }
+    for (int v = 0; v < 256; v++) {
+        assert(!o->remaining[v]);
+        qemu_cond_destroy(&o->idle[v]);
+        qemu_cond_destroy(&o->ordered[v]);
+    }
+    qemu_cond_destroy(&o->available);
+    qemu_mutex_destroy(&o->lock);
+}
+#endif
