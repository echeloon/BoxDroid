+typedef struct X87Scope { unsigned id; int64_t begin; } X87Scope;
+static inline int64_t x87_clock_ns(void)
+{
+    /* Raw counter ticks: conversion is deferred until the summary. */
+    uint64_t value;
+    asm volatile("isb; mrs %0, cntvct_el0" : "=r"(value) :: "memory");
+    return value;
+}
+static int64_t x87_cpu_ns(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_THREAD_CPUTIME_ID, &t);
+    return (int64_t)t.tv_sec*1000000000+t.tv_nsec;
+}
+static X87Scope x87_begin(unsigned id)
+{
+    X87Scope v={id,0};
+    if (x87_active) {
+        uint64_t n=++x87_calls[id];
+        ++x87_pairs[x87_previous][id];
+        x87_previous=id;
+        if (!(n & 2047)) v.begin=x87_clock_ns();
+    }
+    return v;
+}
+static void x87_end(X87Scope *v)
+{
+    if (v->begin) { x87_ns[v->id]+=x87_clock_ns()-v->begin; ++x87_samples[v->id]; }
+}
+#define X87_SCOPE(id) X87Scope x87_scope __attribute__((cleanup(x87_end))) = x87_begin(id)
+static unsigned x87_class(floatx80 x)
+{
+    unsigned e=x.high & 0x7fff;
+    if (!e) return x.low ? 2 : 1; /* subnormal / zero */
+    if (!(x.low >> 63)) return 6; /* unsupported */
+    if (e==0x7fff) return x.low==UINT64_C(0x8000000000000000) ? 3 : 4;
+    return 0; /* normal finite */
+}
+void helper_m54_x87_opcode(CPUX86State *env, uint32_t op, uint32_t pc)
+{
+    if (x87_finished) return;
+    if (!(x87_total++ & 1023)) {
+        int64_t start=__atomic_load_n(&boxdroid_m54_x87_start,__ATOMIC_RELAXED);
+        int64_t elapsed=start ? g_get_monotonic_time()-start : 0;
+        x87_active=start && elapsed<5000000;
+        if (x87_active && !x87_cpu_begin) {
+            asm volatile("mrs %0, cntfrq_el0" : "=r"(x87_frequency));
+            x87_cpu_begin=x87_cpu_ns();
+        }
+        if (start && elapsed>=5000000) {
+            x87_finished=1;
+            int64_t cpu_ns=x87_cpu_ns()-x87_cpu_begin;
+            uint64_t floor_ticks=0;
+            for (unsigned n=0;n<8192;n++) {
+                int64_t t=x87_clock_ns();
+                floor_ticks+=x87_clock_ns()-t;
+            }
+            __android_log_print(ANDROID_LOG_INFO,"BoxDroidM54","X87_WINDOW elapsed_us=%"PRId64" cpu_ns=%"PRId64" tick_hz=%"PRIu64" timer_floor_ns=%.3f sampling=1/2048 costs=inclusive profiler=opt-in",elapsed,cpu_ns,x87_frequency,(double)floor_ticks*1e9/x87_frequency/8192);
+            for (unsigned i=0;i<X87_COUNT;i++) if(x87_ops[i])
+                __android_log_print(ANDROID_LOG_INFO,"BoxDroidM54","X87_OPCODE code=%03x count=%"PRIu64,i,x87_ops[i]);
+            for(unsigned i=0;i<ARRAY_SIZE(x87_names);i++) if(x87_calls[i]) {
+                __android_log_print(ANDROID_LOG_INFO,"BoxDroidM54","X87_HELPER name=%s calls=%"PRIu64" samples=%"PRIu64" ns=%"PRIu64,x87_names[i],x87_calls[i],x87_samples[i],(uint64_t)((double)x87_ns[i]*1e9/x87_frequency));
+                for(unsigned c=0;c<7;c++) if(x87_operands[i][c])
+                    __android_log_print(ANDROID_LOG_INFO,"BoxDroidM54","X87_OPERAND helper=%s class=%u samples=%"PRIu64,x87_names[i],c,x87_operands[i][c]);
+                for(unsigned j=0;j<ARRAY_SIZE(x87_names);j++) if(x87_pairs[i][j]>10000)
+                    __android_log_print(ANDROID_LOG_INFO,"BoxDroidM54","X87_PAIR a=%s b=%s count=%"PRIu64,x87_names[i],x87_names[j],x87_pairs[i][j]);
+            }
+            for(unsigned i=0;i<7;i++) __android_log_print(ANDROID_LOG_INFO,"BoxDroidM54","X87_CLASS class=%u samples=%"PRIu64,i,x87_classes[i]);
+            for(unsigned i=0;i<4096;i++) if(x87_control[i]) __android_log_print(ANDROID_LOG_INFO,"BoxDroidM54","X87_CW word=%03x samples=%"PRIu64,i,x87_control[i]);
+            for(unsigned i=0;i<1024;i++) if(x87_pc_count[i]>10000) __android_log_print(ANDROID_LOG_INFO,"BoxDroidM54","X87_PC pc=%08x count=%"PRIu64,x87_pc[i],x87_pc_count[i]);
+        }
+    }
+    if(!x87_active) return;
+    ++x87_ops[op & 2047];
+    unsigned slot=(pc ^ (pc>>10)) & 1023;
+    for(unsigned n=0;n<1024;n++,slot=(slot+1)&1023) {
+        if(!x87_pc_count[slot] || x87_pc[slot]==pc) { x87_pc[slot]=pc; ++x87_pc_count[slot]; break; }
+    }
+    if(!(x87_total & 1023)) { ++x87_classes[x87_class(ST0)]; ++x87_classes[x87_class(FT0)]; ++x87_control[env->fpuc & 4095]; }
+}
