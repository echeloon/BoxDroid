+static void tcg_out_qemu_ld_direct(TCGContext *s, MemOp memop, TCGType ext,
+                                   TCGReg data_r, HostAddress h)
+{
+    if (s->boxdroid_ordered_loads) {
+        /* Every earlier guest read acquires, including helper/vector paths
+         * and the C execution entry. No per-TB barrier is needed. */
+        TCGReg base = h.base;
+        if (h.index != TCG_REG_XZR) {
+            base = TCG_REG_TMP2;
+            if (h.index_ext == TCG_TYPE_I32) {
+                tcg_out_insn(s, 3501, ADD, TCG_TYPE_I64, base,
+                             h.base, h.index, MO_32, 0);
+            } else {
+                tcg_out_insn(s, 3502, ADD, TCG_TYPE_I64, base,
+                             h.base, h.index);
+            }
+        }
+        tcg_insn_unit *unaligned = NULL;
+        if ((memop & MO_SIZE) != MO_8 && h.aa.align < (memop & MO_SIZE)) {
+            tcg_out_logicali(s, I3404_ANDSI, TCG_TYPE_I64, TCG_REG_XZR,
+                             base, (1U << (memop & MO_SIZE)) - 1);
+            unaligned = s->code_ptr;
