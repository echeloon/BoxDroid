+void boxdroid_order_audit(TranslationBlock *tb, bool executed)
+{
+    static bool checked, enabled, done, hot_mode, armed;
+    static unsigned polls;
+    static struct { uint64_t pc; unsigned hits; } pcs[128];
+    static uint64_t target;
+    if (!checked) {
+        char prop[PROP_VALUE_MAX] = { 0 };
+        __system_property_get("debug.boxdroid.order_audit", prop);
+        enabled = prop[0] == '1' || prop[0] == '2';
+        hot_mode = prop[0] == '2';
+        boxdroid_order_audit_active = hot_mode;
+        __system_property_get("debug.boxdroid.order_audit_pc", prop);
+        target = strtoull(prop, NULL, 0);
+        checked = true;
+    }
+    if (hot_mode) {
+        if (!executed) return;
+        if (!armed) {
+            if ((++polls & 255) == 0) {
+                char prop[PROP_VALUE_MAX] = { 0 };
+                __system_property_get("debug.boxdroid.order_audit_run", prop);
+                armed = prop[0] == '1';
+            }
+            if (!armed) return;
+        }
+    }
+    if (!enabled || done || (target ? tb->pc != target : tb->icount < 60)) {
+        return;
+    }
+    const uint32_t *words = (const uint32_t *)tb->tc.ptr;
+    unsigned count = tb->tc.size / 4, dmb = 0, release = 0, acquire = 0, rcpc = 0;
+    for (unsigned i = 0; i < count; i++) {
+        uint32_t word = __atomic_load_n(&words[i], __ATOMIC_RELAXED);
+        dmb += word == 0xd5033bbf || word == 0xd50339bf ||
+               word == 0xd5033abf;
+        release += (word & 0x3ffffc00) == 0x089ffc00;
+        acquire += (word & 0x3ffffc00) == 0x08dffc00;
+        rcpc += (word & 0x3ffffc00) == 0x38bfc000;
+    }
+    if (!target && dmb + release + acquire + rcpc < 24) {
+        return;
+    }
+    unsigned hits = 0;
+    if (hot_mode) {
+        for (unsigned i = 0; i < G_N_ELEMENTS(pcs); i++) {
+            if (!pcs[i].hits || pcs[i].pc == tb->pc) {
+                pcs[i].pc = tb->pc;
+                hits = ++pcs[i].hits;
+                break;
+            }
+        }
+        if (hits < 64) return;
+    }
+    done = true;
+    boxdroid_order_audit_active = false;
+    __android_log_print(ANDROID_LOG_INFO, "BoxDroidOrder",
+        "ORDER_TB pc=0x%llx insns=%u bytes=%zu dmb=%u stlr=%u ldar=%u ldapr=%u executions=%u",
+        (unsigned long long)tb->pc, tb->icount, tb->tc.size, dmb, release, acquire, rcpc, hits);
+    for (unsigned i = 0; i < MIN(count, 4096); i += 32) {
+        char line[512];
+        int used = snprintf(line, sizeof(line), "ORDER_WORDS %u", i);
+        for (unsigned j = i; j < MIN(MIN(count, 4096), i + 32); j++) {
+            used += snprintf(line + used, sizeof(line) - used, " %08x",
+                             __atomic_load_n(&words[j], __ATOMIC_RELAXED));
+        }
+        __android_log_print(ANDROID_LOG_INFO, "BoxDroidOrder", "%s", line);
+    }
+}
