From: BoxDroid <boxdroid@localhost>
Subject: [PATCH] mcpx/apu: profile worker contention and frame work budgets

Downstream status: not submitted upstream. Android profiling is opt-in and
has no effect on guest ordering or throttle behavior. Counters are protected
by their existing owner/dispatcher locks. Voice work duration includes
preemption; condition wait duration includes mutex reacquisition. EP budget
overruns describe accumulated work, separately from actual audio underruns.
No per-voice logs or profiling clocks are added to normal gameplay.

diff --git a/hw/xbox/mcpx/apu/vp/vp.h b/hw/xbox/mcpx/apu/vp/vp.h
--- a/hw/xbox/mcpx/apu/vp/vp.h
+++ b/hw/xbox/mcpx/apu/vp/vp.h
@@ -62,6 +62,11 @@
     float sample_buf[NUM_SAMPLES_PER_FRAME][2];
     VoiceWorkItem queue[MCPX_HW_MAX_VOICES];
     int queue_len;
+#ifdef BOXDROID_XBOX_RUNTIME
+    /* Accessed only under the dispatcher mutex. Never guest-visible. */
+    uint64_t profile_work_us, profile_lock_wait_us, profile_mix_hold_us;
+    uint64_t profile_wait_us, profile_wakes;
+#endif
 } VoiceWorker;
 
 typedef struct VoiceWorkDispatch {
@@ -74,6 +79,11 @@
     float mixbins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME];
     VoiceWorkItem queue[MCPX_HW_MAX_VOICES];
     int queue_len;
+#ifdef BOXDROID_XBOX_RUNTIME
+    int64_t profile_last_us;
+    uint64_t profile_frames, profile_jobs, profile_barrier_us;
+    uint64_t profile_voice_lock_us, profile_queue_peak, profile_worker_queue_peak;
+#endif
 } VoiceWorkDispatch;
 
 typedef struct {
diff --git a/hw/xbox/mcpx/apu/vp/vp.c b/hw/xbox/mcpx/apu/vp/vp.c
--- a/hw/xbox/mcpx/apu/vp/vp.c
+++ b/hw/xbox/mcpx/apu/vp/vp.c
@@ -1626,6 +1626,9 @@
     VoiceWorkDispatch *vwd = &d->vp.voice_work_dispatch;
     int worker_id = self->worker_id;
     uint64_t worker_bit = UINT64_C(1) << worker_id;
+#ifdef BOXDROID_XBOX_RUNTIME
+    const bool profile = boxdroid_performance_profile_active();
+#endif
 
     rcu_register_thread();
     qemu_mutex_lock(&vwd->lock);
@@ -1648,7 +1651,19 @@
                               self->queue[i].voice, self->queue[i].list);
             }
 
+#ifdef BOXDROID_XBOX_RUNTIME
+            int64_t lock_begin_us = profile ?
+                qemu_clock_get_us(QEMU_CLOCK_REALTIME) : 0;
+#endif
             qemu_mutex_lock(&vwd->lock);
+#ifdef BOXDROID_XBOX_RUNTIME
+            int64_t mix_begin_us = profile ?
+                qemu_clock_get_us(QEMU_CLOCK_REALTIME) : 0;
+            if (profile) {
+                self->profile_lock_wait_us += mix_begin_us - lock_begin_us;
+                self->profile_work_us += lock_begin_us - start_time;
+            }
+#endif
 
             // Add voice contributions
             for (int b = 0; b < NUM_MIXBINS; b++) {
@@ -1663,6 +1678,12 @@
                 }
             }
 
+#ifdef BOXDROID_XBOX_RUNTIME
+            if (profile) {
+                self->profile_mix_hold_us +=
+                    qemu_clock_get_us(QEMU_CLOCK_REALTIME) - mix_begin_us;
+            }
+#endif
             self->queue_len = 0;
         }
 
@@ -1676,7 +1697,18 @@
 
         while (!vwd->workers_should_exit &&
                !(vwd->workers_pending & worker_bit)) {
+#ifdef BOXDROID_XBOX_RUNTIME
+            int64_t wait_begin_us = profile ?
+                qemu_clock_get_us(QEMU_CLOCK_REALTIME) : 0;
+#endif
             qemu_cond_wait(&self->work_pending, &vwd->lock);
+#ifdef BOXDROID_XBOX_RUNTIME
+            if (profile) {
+                self->profile_wait_us +=
+                    qemu_clock_get_us(QEMU_CLOCK_REALTIME) - wait_begin_us;
+                self->profile_wakes++;
+            }
+#endif
         }
     } while (!vwd->workers_should_exit);
 
@@ -1780,12 +1812,31 @@
     }
 
     qemu_mutex_lock(&vwd->lock);
+#ifdef BOXDROID_XBOX_RUNTIME
+    const bool profile = boxdroid_performance_profile_active();
+    int64_t dispatch_begin_us = profile ?
+        qemu_clock_get_us(QEMU_CLOCK_REALTIME) : 0;
+    if (profile) {
+        vwd->profile_frames++;
+        vwd->profile_jobs += vwd->queue_len;
+        vwd->profile_queue_peak = MAX(vwd->profile_queue_peak, vwd->queue_len);
+        vwd->profile_voice_lock_us += dispatch_begin_us - start_time;
+    }
+#endif
 
     if (vwd->queue_len) {
         memset(vwd->mixbins, 0, sizeof(vwd->mixbins));
 
         // Signal workers and wait for completion
         voice_work_schedule(d);
+#ifdef BOXDROID_XBOX_RUNTIME
+        if (profile) {
+            for (int i = 0; i < vwd->num_workers; i++) {
+                vwd->profile_worker_queue_peak = MAX(
+                    vwd->profile_worker_queue_peak, vwd->workers[i].queue_len);
+            }
+        }
+#endif
         /* Multipass cohorts remain on the same worker in guest list order.
          * Wake only workers with assigned voices, then wait for every assigned
          * contribution before the DSP can consume the mixed frame. */
@@ -1797,6 +1848,12 @@
         while (vwd->workers_pending) {
             qemu_cond_wait(&vwd->work_finished, &vwd->lock);
         }
+#ifdef BOXDROID_XBOX_RUNTIME
+        if (profile) {
+            vwd->profile_barrier_us +=
+                qemu_clock_get_us(QEMU_CLOCK_REALTIME) - dispatch_begin_us;
+        }
+#endif
         vwd->queue_len = 0;
 
         // Add voice contributions
@@ -1809,6 +1866,37 @@
 
     int64_t end_time = qemu_clock_get_us(QEMU_CLOCK_REALTIME);
     g_dbg.vp.total_worker_time_us = end_time - start_time;
+#ifdef BOXDROID_XBOX_RUNTIME
+    if (profile && end_time - vwd->profile_last_us >= 1000000) {
+        uint64_t work = 0, lock_wait = 0, mix_hold = 0, wait = 0, wakes = 0;
+        for (int i = 0; i < vwd->num_workers; i++) {
+            VoiceWorker *worker = &vwd->workers[i];
+            work += worker->profile_work_us;
+            lock_wait += worker->profile_lock_wait_us;
+            mix_hold += worker->profile_mix_hold_us;
+            wait += worker->profile_wait_us;
+            wakes += worker->profile_wakes;
+            worker->profile_work_us = worker->profile_lock_wait_us = 0;
+            worker->profile_mix_hold_us = worker->profile_wait_us = 0;
+            worker->profile_wakes = 0;
+        }
+        __android_log_print(ANDROID_LOG_INFO, "BoxDroid",
+            "VOICE_PROFILE elapsed_us=%" PRId64 " workers=%d frames=%" PRIu64
+            " jobs=%" PRIu64 " queue_peak=%" PRIu64 " worker_queue_peak=%" PRIu64
+            " barrier_us=%" PRIu64 " voice_lock_us=%" PRIu64
+            " worker_work_us=%" PRIu64 " worker_lock_wait_us=%" PRIu64
+            " worker_mix_hold_us=%" PRIu64 " worker_wait_us=%" PRIu64
+            " worker_wakes=%" PRIu64,
+            end_time - vwd->profile_last_us, vwd->num_workers,
+            vwd->profile_frames, vwd->profile_jobs, vwd->profile_queue_peak,
+            vwd->profile_worker_queue_peak, vwd->profile_barrier_us,
+            vwd->profile_voice_lock_us, work, lock_wait, mix_hold, wait, wakes);
+        vwd->profile_last_us = end_time;
+        vwd->profile_frames = vwd->profile_jobs = vwd->profile_barrier_us = 0;
+        vwd->profile_voice_lock_us = vwd->profile_queue_peak = 0;
+        vwd->profile_worker_queue_peak = 0;
+    }
+#endif
 
     qemu_mutex_unlock(&vwd->lock);
 }
@@ -1827,6 +1915,12 @@
     vwd->workers_should_exit = false;
     vwd->workers_pending = 0;
     vwd->queue_len = 0;
+#ifdef BOXDROID_XBOX_RUNTIME
+    vwd->profile_last_us = qemu_clock_get_us(QEMU_CLOCK_REALTIME);
+    vwd->profile_frames = vwd->profile_jobs = vwd->profile_barrier_us = 0;
+    vwd->profile_voice_lock_us = vwd->profile_queue_peak = 0;
+    vwd->profile_worker_queue_peak = 0;
+#endif
 
     g_dbg.vp.num_workers = vwd->num_workers;
 
diff --git a/hw/xbox/mcpx/apu/apu_int.h b/hw/xbox/mcpx/apu/apu_int.h
--- a/hw/xbox/mcpx/apu/apu_int.h
+++ b/hw/xbox/mcpx/apu/apu_int.h
@@ -105,6 +105,13 @@
     int frame_count;
     int64_t frame_count_time_us;
     int64_t next_frame_time_us;
+#ifdef BOXDROID_XBOX_RUNTIME
+    struct {
+        int64_t last_us;
+        uint64_t frames, vp_us, dsp_us, monitor_us;
+        uint64_t ep_work_us, ep_batches, ep_budget_overruns, ep_work_peak_us;
+    } profile;
+#endif
 
     struct {
         struct {
diff --git a/hw/xbox/mcpx/apu/apu.c b/hw/xbox/mcpx/apu/apu.c
--- a/hw/xbox/mcpx/apu/apu.c
+++ b/hw/xbox/mcpx/apu/apu.c
@@ -147,6 +147,7 @@
     d->throttle.queued_bytes_count = 0;
 }
 
+#if !defined(__ANDROID__)
 static void throttle_record_queue(MCPXAPUState *d, int queued_bytes)
 {
     if (d->throttle.queued_bytes_count == 0) {
@@ -166,6 +167,8 @@
     }
 }
 
+#endif
+
 static void throttle(MCPXAPUState *d)
 {
     if (d->ep_frame_div % 8) {
@@ -217,6 +220,11 @@
         }
     }
 }
+
+#ifdef BOXDROID_XBOX_RUNTIME
+#include <android/log.h>
+extern bool boxdroid_performance_profile_active(void);
+#endif
 
 static void se_frame(MCPXAPUState *d)
 {
@@ -246,9 +254,53 @@
     /* Buffer for all mixbins for this frame */
     float mixbins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME] = { 0 };
 
+#ifdef BOXDROID_XBOX_RUNTIME
+    const bool profile = boxdroid_performance_profile_active();
+#endif
     mcpx_apu_vp_frame(d, mixbins);
+#ifdef BOXDROID_XBOX_RUNTIME
+    int64_t vp_end_us = profile ? qemu_clock_get_us(QEMU_CLOCK_REALTIME) : 0;
+#endif
     mcpx_apu_dsp_frame(d, mixbins);
+#ifdef BOXDROID_XBOX_RUNTIME
+    int64_t dsp_end_us = profile ? qemu_clock_get_us(QEMU_CLOCK_REALTIME) : 0;
+#endif
     mcpx_apu_monitor_frame(d);
+#ifdef BOXDROID_XBOX_RUNTIME
+    if (profile) {
+        int64_t end_us = qemu_clock_get_us(QEMU_CLOCK_REALTIME);
+        d->profile.frames++;
+        d->profile.vp_us += vp_end_us - start_us;
+        d->profile.dsp_us += dsp_end_us - vp_end_us;
+        d->profile.monitor_us += end_us - dsp_end_us;
+        d->profile.ep_work_us += end_us - start_us;
+        if ((d->ep_frame_div + 1) % 8 == 0) {
+            d->profile.ep_batches++;
+            d->profile.ep_budget_overruns += d->profile.ep_work_us > EP_FRAME_US;
+            d->profile.ep_work_peak_us = MAX(
+                d->profile.ep_work_peak_us, d->profile.ep_work_us);
+            d->profile.ep_work_us = 0;
+        }
+        if (!d->profile.last_us) d->profile.last_us = start_us;
+        if (end_us - d->profile.last_us >= 1000000) {
+            /* Wall work includes preemption/lock waits but excludes throttle
+             * sleeps. A budget overrun is not an audio callback underrun. */
+            __android_log_print(ANDROID_LOG_INFO, "BoxDroid",
+                "APU_PROFILE elapsed_us=%" PRId64 " frames=%" PRIu64
+                " vp_us=%" PRIu64 " dsp_us=%" PRIu64 " monitor_us=%" PRIu64
+                " ep_batches=%" PRIu64 " ep_budget_overruns=%" PRIu64
+                " ep_work_peak_us=%" PRIu64 " ep_budget_us=%d",
+                end_us - d->profile.last_us, d->profile.frames,
+                d->profile.vp_us, d->profile.dsp_us, d->profile.monitor_us,
+                d->profile.ep_batches, d->profile.ep_budget_overruns,
+                d->profile.ep_work_peak_us, EP_FRAME_US);
+            d->profile.last_us = end_us;
+            d->profile.frames = d->profile.vp_us = d->profile.dsp_us = 0;
+            d->profile.monitor_us = d->profile.ep_batches = 0;
+            d->profile.ep_budget_overruns = d->profile.ep_work_peak_us = 0;
+        }
+    }
+#endif
 
     d->ep_frame_div++;
     d->frame_work_acc_us += qemu_clock_get_us(QEMU_CLOCK_REALTIME) - start_us;
