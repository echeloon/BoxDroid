+#ifdef __ANDROID__
+typedef struct PipelineCacheSaveJob {
+    gchar *data;
+    size_t size;
+} PipelineCacheSaveJob;
+
+static gpointer save_pipeline_cache_worker(gpointer arg)
+{
+    PipelineCacheSaveJob *job = (PipelineCacheSaveJob *)arg;
+    const char *final_path = "/data/data/org.boxdroid/cache/vk_pipeline_cache.bin";
+    gchar *tmp_path = g_strdup_printf("/data/data/org.boxdroid/cache/vk_pipeline_cache.bin.tmp.%" G_GINT64_FORMAT, g_get_monotonic_time());
+    FILE *f = fopen(tmp_path, "wb");
+    if (f) {
+        bool ok = (fwrite(job->data, 1, job->size, f) == job->size);
+        if (fclose(f) == 0 && ok) {
+            rename(tmp_path, final_path);
+        } else {
+            unlink(tmp_path);
+        }
+    }
+    g_free(tmp_path);
+    g_free(job->data);
+    g_free(job);
+    return NULL;
+}
+#endif
+
+void pgraph_vk_save_pipeline_cache(PGRAPHVkState *r)
+{
+#ifdef __ANDROID__
+    if (!r->vk_pipeline_cache) {
+        return;
+    }
+    size_t cache_size = 0;
+    if (vkGetPipelineCacheData(r->device, r->vk_pipeline_cache, &cache_size,
+                               NULL) != VK_SUCCESS ||
+        cache_size == 0) {
+        return;
+    }
+    gchar *cache_data = g_malloc(cache_size);
+    if (vkGetPipelineCacheData(r->device, r->vk_pipeline_cache, &cache_size,
+                               cache_data) == VK_SUCCESS &&
+        cache_size > 0) {
+        PipelineCacheSaveJob *job = g_malloc(sizeof(PipelineCacheSaveJob));
+        job->data = cache_data;
+        job->size = cache_size;
+        GThread *t = g_thread_new("vk-cache-save", save_pipeline_cache_worker, job);
+        g_thread_unref(t);
+    } else {
+        g_free(cache_data);
+    }
+#else
+    (void)r;
+#endif
+}
