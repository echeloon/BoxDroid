+            memcpy(mapped_base + cmp_start, src_base + cmp_start, cmp_len);
+            if (cmp_start < r->vertex_ram_min_dirty) {
+                r->vertex_ram_min_dirty = cmp_start;
+            }
+            if (cmp_end > r->vertex_ram_max_dirty) {
+                r->vertex_ram_max_dirty = cmp_end;
+            }
+        }
+    }
