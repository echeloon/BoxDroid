+static void get_pipeline_key_regs(PGRAPHState *pg, uint32_t regs[5])
+{
+    PGRAPHVkState *r = pg->vk_renderer_state;
+
+    uint32_t blend = pgraph_reg_r(pg, NV_PGRAPH_BLEND);
+    if (blend & NV_PGRAPH_BLEND_EN) {
+        blend &= (NV_PGRAPH_BLEND_EN | NV_PGRAPH_BLEND_SFACTOR |
+                  NV_PGRAPH_BLEND_DFACTOR | NV_PGRAPH_BLEND_EQN);
+    } else {
+        blend = 0;
+    }
+
+    uint32_t control_0 = pgraph_reg_r(pg, NV_PGRAPH_CONTROL_0);
+    uint32_t control_0_mask =
+        NV_PGRAPH_CONTROL_0_RED_WRITE_ENABLE |
+        NV_PGRAPH_CONTROL_0_GREEN_WRITE_ENABLE |
+        NV_PGRAPH_CONTROL_0_BLUE_WRITE_ENABLE |
+        NV_PGRAPH_CONTROL_0_ALPHA_WRITE_ENABLE;
+    if (r->zeta_binding) {
+        control_0_mask |= NV_PGRAPH_CONTROL_0_ZENABLE |
+                          NV_PGRAPH_CONTROL_0_ZWRITEENABLE;
+        if (control_0 & NV_PGRAPH_CONTROL_0_ZENABLE) {
+            control_0_mask |= NV_PGRAPH_CONTROL_0_ZFUNC;
+        }
+    }
+    control_0 &= control_0_mask;
+
+    uint32_t control_1 = 0;
+    uint32_t control_2 = 0;
+    if (r->zeta_binding) {
+        uint32_t raw_c1 = pgraph_reg_r(pg, NV_PGRAPH_CONTROL_1);
+        if (raw_c1 & NV_PGRAPH_CONTROL_1_STENCIL_TEST_ENABLE) {
+            control_1 = raw_c1 & (NV_PGRAPH_CONTROL_1_STENCIL_TEST_ENABLE |
+                                  NV_PGRAPH_CONTROL_1_STENCIL_FUNC);
+            control_2 = pgraph_reg_r(pg, NV_PGRAPH_CONTROL_2) &
+                        (NV_PGRAPH_CONTROL_2_STENCIL_OP_FAIL |
+                         NV_PGRAPH_CONTROL_2_STENCIL_OP_ZFAIL |
+                         NV_PGRAPH_CONTROL_2_STENCIL_OP_ZPASS);
+        }
+    }
+
+    uint32_t setupraster = pgraph_reg_r(pg, NV_PGRAPH_SETUPRASTER);
+    uint32_t setupraster_mask = NV_PGRAPH_SETUPRASTER_FRONTFACE |
+                                NV_PGRAPH_SETUPRASTER_CULLENABLE;
+    if (setupraster & NV_PGRAPH_SETUPRASTER_CULLENABLE) {
+        setupraster_mask |= NV_PGRAPH_SETUPRASTER_CULLCTRL;
+    }
+    setupraster &= setupraster_mask;
+
+    regs[0] = blend;
+    regs[1] = control_0;
+    regs[2] = control_1;
+    regs[3] = control_2;
+    regs[4] = setupraster;
+}
