+static bool is_full_surface_clear(PGRAPHState *pg,
+                                  const SurfaceBinding *binding)
+{
+    PGRAPHVkState *r = pg->vk_renderer_state;
+    if (!pg->clearing || !binding || !binding->width || !binding->height) {
+        return false;
+    }
+    if (binding->color) {
+        if ((r->clear_parameter & NV097_CLEAR_SURFACE_COLOR) !=
+            (NV097_CLEAR_SURFACE_R | NV097_CLEAR_SURFACE_G |
+             NV097_CLEAR_SURFACE_B | NV097_CLEAR_SURFACE_A)) {
+            return false;
+        }
+    } else {
+        VkImageAspectFlags clear_aspect = 0;
+        if (r->clear_parameter & NV097_CLEAR_SURFACE_Z) {
+            clear_aspect |= VK_IMAGE_ASPECT_DEPTH_BIT;
+        }
+        if (r->clear_parameter & NV097_CLEAR_SURFACE_STENCIL) {
+            clear_aspect |= VK_IMAGE_ASPECT_STENCIL_BIT;
+        }
+        VkImageAspectFlags fmt_aspect = binding->host_fmt.aspect;
+        if ((clear_aspect & fmt_aspect) != fmt_aspect) {
+            return false;
+        }
+    }
+    uint32_t clearrectx = pgraph_reg_r(pg, NV_PGRAPH_CLEARRECTX);
+    uint32_t clearrecty = pgraph_reg_r(pg, NV_PGRAPH_CLEARRECTY);
+    unsigned int xmin = GET_MASK(clearrectx, NV_PGRAPH_CLEARRECTX_XMIN);
+    unsigned int xmax = GET_MASK(clearrectx, NV_PGRAPH_CLEARRECTX_XMAX);
+    unsigned int ymin = GET_MASK(clearrecty, NV_PGRAPH_CLEARRECTY_YMIN);
+    unsigned int ymax = GET_MASK(clearrecty, NV_PGRAPH_CLEARRECTY_YMAX);
+    if (xmin != 0 || ymin != 0) {
+        return false;
+    }
+    unsigned int clear_w = xmax + 1;
+    unsigned int clear_h = ymax + 1;
+    pgraph_apply_anti_aliasing_factor(pg, &clear_w, &clear_h);
+    return clear_w >= binding->width && clear_h >= binding->height;
+}
