+#ifdef BOXDROID_XBOX_RUNTIME
+#define BOXDROID_PROBE_PATCH_WIDTH 64
+#define BOXDROID_PROBE_PATCH_HEIGHT 64
+
+static uint64_t boxdroid_surface_generation;
+
+static bool boxdroid_target_surface(const SurfaceBinding *surface)
+{
+    return surface->vram_addr == UINT64_C(0x32a4000) ||
+           surface->vram_addr == UINT64_C(0x3628000);
+}
+
+static uint64_t boxdroid_hash(const uint8_t *bytes, size_t length)
+{
+    uint64_t hash = UINT64_C(1469598103934665603);
+    size_t limit = MIN(length, (size_t)(4 * MiB));
+    for (size_t i = 0; i < limit; i++) {
+        hash ^= bytes[i];
+        hash *= UINT64_C(1099511628211);
+    }
+    return hash;
+}
+
+void pgraph_vk_boxdroid_probe_surface(NV2AState *d, SurfaceBinding *surface)
+{
+    PGRAPHState *pg = &d->pgraph;
+    PGRAPHVkState *r = pg->vk_renderer_state;
+    VkBuffer buffer = VK_NULL_HANDLE;
+    VmaAllocation allocation = VK_NULL_HANDLE;
+    VkBufferImageCopy region;
+    uint8_t *mapped = NULL;
+    unsigned int width = surface->width, height = surface->height;
+    const unsigned int count = BOXDROID_PROBE_PATCH_WIDTH *
+                               BOXDROID_PROBE_PATCH_HEIGHT;
+    const unsigned int bytes_per_pixel = surface->host_fmt.host_bytes_per_pixel;
+    const size_t buffer_size = (size_t)count * 4;
+    uint64_t nonzero_samples = 0, nonblack_samples = 0;
+    uint64_t hash = UINT64_C(1469598103934665603);
+    uint64_t values[8] = {0};
+    VmaAllocationCreateInfo alloc_info = {
+        .usage = VMA_MEMORY_USAGE_AUTO_PREFER_HOST,
+        .flags = VMA_ALLOCATION_CREATE_HOST_ACCESS_RANDOM_BIT |
+                 VMA_ALLOCATION_CREATE_DEDICATED_MEMORY_BIT,
+    };
+
+    if (!boxdroid_target_surface(surface) || surface->boxdroid_probe_done ||
+        !surface->color || !surface->image || !surface->width ||
+        !surface->height || !bytes_per_pixel || bytes_per_pixel > 4) {
+        return;
+    }
+    pgraph_apply_scaling_factor(pg, &width, &height);
+    if (width < BOXDROID_PROBE_PATCH_WIDTH ||
+        height < BOXDROID_PROBE_PATCH_HEIGHT) {
+        return;
+    }
+    surface->boxdroid_probe_done = true;
+
+    VkBufferCreateInfo buffer_info = {
+        .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+        .size = buffer_size,
+        .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+        .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+    };
+    VK_CHECK(vmaCreateBuffer(r->allocator, &buffer_info, &alloc_info,
+                             &buffer, &allocation, NULL));
+    region = (VkBufferImageCopy){
+        .imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+        .imageSubresource.layerCount = 1,
+        .imageOffset = {
+            .x = (width - BOXDROID_PROBE_PATCH_WIDTH) / 2,
+            .y = (height - BOXDROID_PROBE_PATCH_HEIGHT) / 2,
+            .z = 0,
+        },
+        .imageExtent = { BOXDROID_PROBE_PATCH_WIDTH,
+                         BOXDROID_PROBE_PATCH_HEIGHT, 1 },
+    };
+
+    VkCommandBuffer cmd = pgraph_vk_begin_single_time_commands(pg);
+    pgraph_vk_transition_image_layout(pg, cmd, surface->image,
+        surface->host_fmt.vk_format, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+        VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    vkCmdCopyImageToBuffer(cmd, surface->image,
+        VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buffer, 1, &region);
+    pgraph_vk_transition_image_layout(pg, cmd, surface->image,
+        surface->host_fmt.vk_format, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+        VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+    VkBufferMemoryBarrier host_read_barrier = {
+        .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER,
+        .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .buffer = buffer,
+        .size = buffer_size,
+    };
+    vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         VK_PIPELINE_STAGE_HOST_BIT, 0, 0, NULL, 1,
+                         &host_read_barrier, 0, NULL);
+    pgraph_vk_end_single_time_commands(pg, cmd);
+
+    VK_CHECK(vmaMapMemory(r->allocator, allocation, (void **)&mapped));
+    vmaInvalidateAllocation(r->allocator, allocation, 0, buffer_size);
+    for (unsigned int i = 0; i < count; i++) {
+        const uint8_t *pixel = mapped + (size_t)i * bytes_per_pixel;
+        bool nonzero = false, nonblack = false;
+        for (unsigned int c = 0; c < bytes_per_pixel; c++) {
+            hash ^= pixel[c];
+            hash *= UINT64_C(1099511628211);
+            nonzero |= pixel[c] != 0;
+            if (c < 3) {
+                nonblack |= pixel[c] != 0;
+            }
+        }
+        nonzero_samples += nonzero;
+        nonblack_samples += nonblack;
+    }
+    vmaUnmapMemory(r->allocator, allocation);
+    vmaDestroyBuffer(r->allocator, buffer, allocation);
+
+    values[0] = BOXDROID_PROBE_PATCH_WIDTH;
+    values[1] = BOXDROID_PROBE_PATCH_HEIGHT;
+    values[2] = count;
+    values[3] = nonblack_samples;
+    values[4] = hash;
+    values[5] = surface->host_fmt.vk_format;
+    values[6] = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    values[7] = nonzero_samples;
+    boxdroid_diag_binding_event(BOXDROID_BINDING_GPU_PROBE,
+        surface->vram_addr, surface->boxdroid_generation, values);
+}
+#endif
+
