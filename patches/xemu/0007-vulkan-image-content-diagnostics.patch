diff --git a/hw/xbox/nv2a/pgraph/vk/draw.c b/hw/xbox/nv2a/pgraph/vk/draw.c
--- a/hw/xbox/nv2a/pgraph/vk/draw.c
+++ b/hw/xbox/nv2a/pgraph/vk/draw.c
@@ -23,0 +24,80 @@
+#ifdef BOXDROID_XBOX_RUNTIME
+#include "hw/xbox/nv2a/boxdroid-diagnostics.h"
+
+static uint64_t boxdroid_pack32(uint32_t high, uint32_t low)
+{
+    return ((uint64_t)high << 32) | low;
+}
+
+static void boxdroid_record_guest_draw(PGRAPHState *pg, uint64_t api,
+                                          uint64_t vertex_count,
+                                          uint64_t index_count)
+{
+    PGRAPHVkState *r = pg->vk_renderer_state;
+    SurfaceBinding *surface = r->color_binding;
+    if (!surface || (surface->vram_addr != UINT64_C(0x32a4000) &&
+                     surface->vram_addr != UINT64_C(0x3628000))) {
+        return;
+    }
+
+    uint32_t control_0 = pgraph_reg_r(pg, NV_PGRAPH_CONTROL_0);
+    uint32_t setup = pgraph_reg_r(pg, NV_PGRAPH_SETUPRASTER);
+    uint32_t cull = (setup & NV_PGRAPH_SETUPRASTER_CULLENABLE) ?
+        GET_MASK(setup, NV_PGRAPH_SETUPRASTER_CULLCTRL) : 0;
+    uint32_t depth = !!(control_0 & NV_PGRAPH_CONTROL_0_ZENABLE);
+    uint32_t stencil = !!(pgraph_reg_r(pg, NV_PGRAPH_CONTROL_1) &
+                          NV_PGRAPH_CONTROL_1_STENCIL_TEST_ENABLE);
+    uint32_t depth_write = !!(control_0 & NV_PGRAPH_CONTROL_0_ZWRITEENABLE);
+    uint32_t write_mask = 0;
+    unsigned int x = pg->surface_shape.clip_x;
+    unsigned int y = pg->surface_shape.clip_y;
+    unsigned int width = pg->surface_shape.clip_width;
+    unsigned int height = pg->surface_shape.clip_height;
+    uint64_t values[8] = {0};
+
+    if (control_0 & NV_PGRAPH_CONTROL_0_RED_WRITE_ENABLE) write_mask |= 1;
+    if (control_0 & NV_PGRAPH_CONTROL_0_GREEN_WRITE_ENABLE) write_mask |= 2;
+    if (control_0 & NV_PGRAPH_CONTROL_0_BLUE_WRITE_ENABLE) write_mask |= 4;
+    if (control_0 & NV_PGRAPH_CONTROL_0_ALPHA_WRITE_ENABLE) write_mask |= 8;
+    pgraph_apply_anti_aliasing_factor(pg, &x, &y);
+    pgraph_apply_anti_aliasing_factor(pg, &width, &height);
+    pgraph_apply_scaling_factor(pg, &x, &y);
+    pgraph_apply_scaling_factor(pg, &width, &height);
+
+    values[0] = api;
+    values[1] = pg->primitive_mode;
+    values[2] = vertex_count;
+    values[3] = index_count;
+    values[4] = write_mask;
+    values[5] = boxdroid_pack32(x, y);
+    values[6] = boxdroid_pack32(width, height);
+    values[7] = cull | (depth << 8) | (stencil << 16) | (depth_write << 24);
+    boxdroid_diag_binding_event(BOXDROID_BINDING_GUEST_DRAW,
+        surface->vram_addr, surface->boxdroid_generation, values);
+}
+
+static void boxdroid_record_clear(PGRAPHState *pg, SurfaceBinding *surface,
+                                     uint32_t parameter,
+                                     const VkClearRect *clear_rect,
+                                     const float rgba[4])
+{
+    if (!surface || !surface->color ||
+        (surface->vram_addr != UINT64_C(0x32a4000) &&
+         surface->vram_addr != UINT64_C(0x3628000))) {
+        return;
+    }
+    uint32_t rgba_bits[4];
+    memcpy(rgba_bits, rgba, sizeof(rgba_bits));
+    uint64_t values[8] = {
+        pgraph_reg_r(pg, NV_PGRAPH_COLORCLEARVALUE),
+        rgba_bits[0], rgba_bits[1], rgba_bits[2], rgba_bits[3],
+        boxdroid_pack32(clear_rect->rect.offset.x,
+                           clear_rect->rect.offset.y),
+        boxdroid_pack32(clear_rect->rect.extent.width,
+                           clear_rect->rect.extent.height),
+        parameter & NV097_CLEAR_SURFACE_COLOR,
+    };
+    boxdroid_diag_binding_event(BOXDROID_BINDING_CLEAR,
+        surface->vram_addr, surface->boxdroid_generation, values);
+}
+#endif
