+static void boxdroid_log_color_target(NV2AState *d, uint32_t method,
+                                         uint32_t parameter)
+{
+    PGRAPHState *pg = &d->pgraph;
+    DMAObject dma = nv_dma_load(d, pg->dma_color);
+    uint64_t address = (dma.address + pg->surface_color.offset) & 0x07FFFFFF;
+    uint32_t width = pg->surface_type == NV097_SET_SURFACE_FORMAT_TYPE_SWIZZLE ?
+        (1u << pg->surface_shape.log_width) : pg->surface_shape.clip_width;
+    uint32_t height = pg->surface_type == NV097_SET_SURFACE_FORMAT_TYPE_SWIZZLE ?
+        (1u << pg->surface_shape.log_height) : pg->surface_shape.clip_height;
+
+    boxdroid_diag_record("PGRAPH_COLOR_TARGET", method, parameter,
+                            dma.address, address, pg->surface_color.pitch,
+                            pg->surface_shape.color_format);
+    boxdroid_diag_record("PGRAPH_COLOR_TARGET_EXTENT", width, height,
+                            pg->surface_type, dma.limit, 0, 0);
+}
+#endif
