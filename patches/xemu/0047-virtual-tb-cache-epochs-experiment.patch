# Experimental O(1) full virtual jump-cache invalidation via upper32 PC generations, guarded i38632 target. C and generated lookups reject stale keys before TB dereference; wrap and whole code-cache flush clear pointers. Page/SMC/TLB invalidation unchanged; physical-cache35 removed. Default jmp_epoch0.

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index 1a53f14090..c42207e728 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -33,6 +33,7 @@
 #include "exec/translation-block.h"
 #include "tcg/tcg.h"
 #include "qemu/atomic.h"
+#include "qemu/target-info.h"
 #include "qemu/rcu.h"
 #include "exec/log.h"
 #include "qemu/main-loop.h"
@@ -53,6 +54,7 @@
 #if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
 #include <sys/system_properties.h>
 bool boxdroid_jmp_cache2;
+bool boxdroid_jmp_epoch;
 bool boxdroid_inline_lookup_observe;
 uint64_t boxdroid_inline_lookup_hits[2];
 uint64_t boxdroid_inline_lookup_fallbacks;
@@ -269,7 +271,11 @@ static void tb_jmp_cache_insert(CPUJumpCache *jc, uint32_t hash,
         qatomic_set(&jc->secondary[hash].tb, previous);
     }
 #endif
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+    jc->array[hash].pc = boxdroid_jmp_cache_pc(jc, pc);
+#else
     jc->array[hash].pc = pc;
+#endif
     qatomic_set(&jc->array[hash].tb, tb);
 }
 
@@ -284,10 +290,14 @@ static inline TranslationBlock *tb_lookup(CPUState *cpu, TCGTBCPUState s)
 
     hash = tb_jmp_cache_hash_func(s.pc);
     jc = cpu->tb_jmp_cache;
+    vaddr cache_pc = s.pc;
+#if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
+    cache_pc = boxdroid_jmp_cache_pc(jc, s.pc);
+#endif
 
     tb = qatomic_read(&jc->array[hash].tb);
     if (likely(tb &&
-               jc->array[hash].pc == s.pc &&
+               jc->array[hash].pc == cache_pc &&
                tb->cs_base == s.cs_base &&
                tb->flags == s.flags &&
                tb_cflags(tb) == s.cflags)) {
@@ -300,7 +310,7 @@ static inline TranslationBlock *tb_lookup(CPUState *cpu, TCGTBCPUState s)
 #if defined(BOXDROID_XBOX_RUNTIME) && defined(__aarch64__)
     if (boxdroid_jmp_cache2) {
         tb = qatomic_read(&jc->secondary[hash].tb);
-        if (tb && jc->secondary[hash].pc == s.pc &&
+        if (tb && jc->secondary[hash].pc == cache_pc &&
             tb->cs_base == s.cs_base && tb->flags == s.flags &&
             tb_cflags(tb) == s.cflags) {
 #ifdef BOXDROID_RUNTIME
@@ -1176,6 +1186,10 @@ bool tcg_exec_realizefn(CPUState *cpu, Error **errp)
         char prop[PROP_VALUE_MAX] = {0};
         boxdroid_jmp_cache2 = __system_property_get("debug.boxdroid.jmp_cache2", prop) &&
                              !strcmp(prop, "1");
+        boxdroid_jmp_epoch =
+            target_long_bits() == 32 && !strcmp(target_name(), "i386") &&
+            __system_property_get("debug.boxdroid.jmp_epoch", prop) &&
+            !strcmp(prop, "1");
         boxdroid_inline_lookup_observe =
             __system_property_get("debug.boxdroid.inline_lookup_count", prop) &&
