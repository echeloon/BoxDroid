+#include "system/boxdroid-m5-diagnostics.h"
+#endif
@@ -289,0 +293,7 @@
+#ifdef BOXDROID_M5_XBOX_RUNTIME
+    /* The narrow IN_ASM filter below captures this loop once at translation.
+     * Suppress its per-execution log so the diagnostic remains bounded. */
+    if (pc >= 0x8001b000 && pc <= 0x8001b080) {
+        return;
+    }
+#endif
@@ -454,0 +465,5 @@
+
+#ifdef BOXDROID_M5_XBOX_RUNTIME
+    boxdroid_m5_diag_tb_exec(cpu, log_pc(cpu, itb),
+                             (uintptr_t)tb_ptr, itb->icount);
+#endif
@@ -1051,0 +1067,4 @@
+#ifdef BOXDROID_M5_XBOX_RUNTIME
+        boxdroid_m5_diag_cpu_exit(EXCP_HALTED, cpu->halted,
+                                  cpu->interrupt_request);
+#endif
@@ -1068,0 +1088,3 @@
+#ifdef BOXDROID_M5_XBOX_RUNTIME
+    boxdroid_m5_diag_cpu_exit(ret, cpu->halted, cpu->interrupt_request);
+#endif
