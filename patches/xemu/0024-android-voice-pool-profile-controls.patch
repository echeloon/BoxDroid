From: BoxDroid <boxdroid@localhost>
Subject: [PATCH] mcpx/apu: compare Android worker counts at quiescent boundaries

Downstream status: not submitted upstream. Only the owning APU thread can safely join and replace its pool.

Opt-in profiling can compare bounded audio pool sizes in the same running
scene. Only the APU thread reconfigures, before enqueueing a new frame and
after all previous contributions/DSP work have completed. Join every old
worker before constructing the replacement pool. Normal gameplay retains
the startup pool and never polls experiment controls.

diff --git a/hw/xbox/mcpx/apu/vp/vp.c b/hw/xbox/mcpx/apu/vp/vp.c
--- a/hw/xbox/mcpx/apu/vp/vp.c
+++ b/hw/xbox/mcpx/apu/vp/vp.c
@@ -1613,6 +1613,12 @@
     }
 }
 
+#ifdef BOXDROID_XBOX_RUNTIME
+#include <android/log.h>
+extern bool boxdroid_performance_profile_active(void);
+extern int boxdroid_android_requested_voice_workers(void);
+#endif
+
 static void *voice_worker_thread(void *arg)
 {
     VoiceWorker *self = arg;
@@ -1866,6 +1872,29 @@
 
 void mcpx_apu_vp_frame(MCPXAPUState *d, float mixbins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME])
 {
+#ifdef BOXDROID_XBOX_RUNTIME
+    /* Experiment control only. The APU owns this boundary under d->lock;
+     * the previous frame's contributions and DSP processing have completed.
+     * Never reconfigure after current voices have been queued. Joining idle
+     * workers preserves guest list order and every audio-frame barrier. */
+    if (boxdroid_performance_profile_active()) {
+        static int64_t last_check_us;
+        int64_t now = qemu_clock_get_us(QEMU_CLOCK_REALTIME);
+        if (now - last_check_us >= 1000000) {
+            VoiceWorkDispatch *vwd = &d->vp.voice_work_dispatch;
+            int requested = boxdroid_android_requested_voice_workers();
+            if (requested != vwd->num_workers) {
+                assert(!vwd->queue_len && !vwd->workers_pending);
+                voice_work_finalize(d);
+                g_config.audio.vp.num_workers = requested;
+                voice_work_init(d);
+                __android_log_print(ANDROID_LOG_INFO, "BoxDroid",
+                    "VOICE_POOL workers=%d quiescent_reconfigure=1", requested);
+            }
+            last_check_us = now;
+        }
+    }
+#endif
     memset(d->vp.sample_buf, 0, sizeof(d->vp.sample_buf));
 
     /* Process all voices, mixing each into the affected MIXBINs */
