diff --git a/hw/xbox/nv2a/nv2a.c b/hw/xbox/nv2a/nv2a.c
index 5f23dd56f5..081e3049a2 100644
--- a/hw/xbox/nv2a/nv2a.c
+++ b/hw/xbox/nv2a/nv2a.c
@@ -35,3 +34,0 @@ static void boxdroid_m5_vram_access_callback(void *opaque, MemoryRegion *mr,
-    if (!write) {
-        return;
-    }
@@ -40 +37,5 @@ static void boxdroid_m5_vram_access_callback(void *opaque, MemoryRegion *mr,
-        boxdroid_m5_diag_vram_write("guest-cpu", addr - ram_base, len, 0);
