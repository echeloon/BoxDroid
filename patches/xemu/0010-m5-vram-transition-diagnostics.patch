+            boxdroid_m5_diag_vram_write("guest-cpu", addr - ram_base, len, 0);
+        } else {
+            boxdroid_m5_diag_vram_read("guest-cpu", addr - ram_base, len);
+        }
diff --git a/hw/xbox/nv2a/pcrtc.c b/hw/xbox/nv2a/pcrtc.c
